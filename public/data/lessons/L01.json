  "grammar": [
    {
      "id": "L01-G01",
      "pattern": "名詞1は 名詞2です",
      "explanation": "助詞「は」提示句子的主題;名詞加上「です」構成述語,表示判斷、斷定,並對聽話人表示禮貌。〔註〕助詞「は」要唸成「わ」。",
      "examples": [
        {
          "id": "L01-S01",
          "ruby": [{ "b": "わたしは マイク・ミラーです。" }],
          "translation": "我是邁克·米勒。"
        },
        {
          "id": "L01-S02",
          "ruby": [{ "b": "わたしは エンジニアです。" }],
          "translation": "我是工程師。"
        }
      ]
    },
    {
      "id": "L01-G02",
      "pattern": "名詞1は 名詞2じゃ ありません",
      "explanation": "「じゃ ありません」是「です」的否定形,用於日常會話;正式演講或書面語用「では ありません」。〔註〕「では」的「は」要唸成「わ」。",
      "examples": [
        {
          "id": "L01-S03",
          "ruby": [
            { "b": "サントスさんは " },
            { "b": "学生", "r": "がくせい" },
            { "b": "じゃ ありません。" }
          ],
          "translation": "山多斯先生不是學生。"
        }
      ]
    },
    {
      "id": "L01-G03",
      "pattern": "文 か",
      "explanation": "句尾加助詞「か」構成疑問句,語序不變,句尾音調一般上揚;依內容用「はい/いいえ」回答。帶疑問詞的疑問句,用疑問詞取代要詢問的內容。",
      "examples": [
        {
          "id": "L01-S04",
          "ruby": [
            { "b": "ミラーさんは アメリカ" },
            { "b": "人", "r": "じん" },
            { "b": "ですか。" }
          ],
          "translation": "米勒先生是美國人嗎？"
        },
        {
          "id": "L01-S05",
          "ruby": [{ "b": "…はい、アメリカ" }, { "b": "人", "r": "じん" }, { "b": "です。" }],
          "translation": "…是的,是美國人。"
        },
        {
          "id": "L01-S06",
          "ruby": [
            { "b": "あの " },
            { "b": "方", "r": "かた" },
            { "b": "は どなたですか。" }
          ],
          "translation": "那位是誰？"
        },
        {
          "id": "L01-S07",
          "ruby": [{ "b": "…ミラーさんです。" }],
          "translation": "…是米勒先生。"
        }
      ]
    },
    {
      "id": "L01-G04",
      "pattern": "名詞 も",
      "explanation": "當對某主題的敘述,與之前對其他主題的敘述相同時,用「も」取代「は」。",
      "examples": [
        {
          "id": "L01-S08",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "会社員", "r": "かいしゃいん" },
            { "b": "です。" }
          ],
          "translation": "米勒先生是公司職員。"
        },
        {
          "id": "L01-S09",
          "ruby": [
            { "b": "グプタさんも " },
            { "b": "会社員", "r": "かいしゃいん" },
            { "b": "です。" }
          ],
          "translation": "古普達先生也是公司職員。"
        }
      ]
    },
    {
      "id": "L01-G05",
      "pattern": "名詞1の 名詞2",
      "explanation": "當前面的名詞修飾、限定後面的名詞時,用「の」連接兩個名詞。本課中名詞1表示名詞2所屬的公司。",
      "examples": [
        {
          "id": "L01-S10",
          "ruby": [
            { "b": "ミラーさんは IMCの " },
            { "b": "社員", "r": "しゃいん" },
            { "b": "です。" }
          ],
          "translation": "米勒先生是 IMC 公司的職員。"
        }
      ]
    },
    {
      "id": "L01-G06",
      "pattern": "〜さん",
      "explanation": "日語在聽話人或第三者的姓氏後加「さん」表示敬意,因此不能加在說話者自己的姓氏後。若知道對方姓名,提及時一般不說「あなた」,而在姓氏後加「さん」。",
      "examples": [
        {
          "id": "L01-S11",
          "ruby": [
            { "b": "あの " },
            { "b": "方", "r": "かた" },
            { "b": "は ミラーさんです。" }
          ],
          "translation": "那位是米勒先生。"
        }
      ]
    }
  ],
