  "grammar": [
    {
      "id": "L32-G01",
      "pattern": "動詞た形／動詞ない形 ない ほうが いいです",
      "explanation": "這個句型用於提供建議和忠告時,由於有些情況會給人一種強加於人的印象,因此有視情況使用的必要。〔註〕「〜た ほうが いい」和「〜たら いい」的區別:例句③(非選擇性)是一般提供建議的情況,這種情況要用「〜たら いい」。而句型「〜た ほうが いい」雖然沒說出來,也有二者比較選擇的意思。",
      "examples": [
        {
          "id": "L32-S01",
          "ruby": [
            { "b": "毎日", "r": "まいにち" },
            { "b": " " },
            { "b": "運動", "r": "うんどう" },
            { "b": "した ほうが いいです。" }
          ],
          "translation": "最好每天運動。"
        },
        {
          "id": "L32-S02",
          "ruby": [
            { "b": "熱", "r": "ねつ" },
            { "b": "が あるんです。" }
          ],
          "translation": "發燒了。"
        },
        {
          "id": "L32-S03",
          "ruby": [
            { "b": "…じゃ、おふろに " },
            { "b": "入", "r": "はい" },
            { "b": "らない ほうが いいですよ。" }
          ],
          "translation": "…那最好不要洗澡。"
        },
        {
          "id": "L32-S04",
          "ruby": [
            { "b": "日本", "r": "にほん" },
            { "b": "の お" },
            { "b": "寺", "r": "てら" },
            { "b": "が " },
            { "b": "見", "r": "み" },
            { "b": "たいんですが……。" }
          ],
          "translation": "我想看看日本的佛寺。"
        },
        {
          "id": "L32-S05",
          "ruby": [
            { "b": "…じゃ、" },
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "ったら いいですよ。" }
          ],
          "translation": "…那你可以去京都。"
        }
      ]
    },
    {
      "id": "L32-G02",
      "pattern": "動詞／い形容詞／な形容詞／名詞（普通形）でしょう",
      "explanation": "這個句型使用於說話人對於某事,以自己擁有的訊息為根據進行推測時。此外像例句⑤般用於疑問句時,就會成為詢問聽話人推測的問句了。(な形容詞、名詞接「〜だ」的普通形時去掉「だ」)",
      "examples": [
        {
          "id": "L32-S06",
          "ruby": [
            { "b": "あしたは " },
            { "b": "雨", "r": "あめ" },
            { "b": "が " },
            { "b": "降", "r": "ふ" },
            { "b": "るでしょう。" }
          ],
          "translation": "明天會下雨吧。"
        },
        {
          "id": "L32-S07",
          "ruby": [
            { "b": "タワポンさんは " },
            { "b": "合格", "r": "ごうかく" },
            { "b": "するでしょうか。" }
          ],
          "translation": "瓦朋先生會通過考試吧。"
        }
      ]
    },
    {
      "id": "L32-G03",
      "pattern": "動詞／い形容詞／な形容詞／名詞（普通形）かも しれません",
      "explanation": "「〜かも しれません」也表示說話人的推測語氣,表示某件事情或狀況有發生了或發生(現在、未來)的可能性,但是比起「〜でしょう」的確定性要低得多。",
      "examples": [
        {
          "id": "L32-S08",
          "ruby": [
            { "b": "約束", "r": "やくそく" },
            { "b": "の " },
            { "b": "時間", "r": "じかん" },
            { "b": "に " },
            { "b": "間", "r": "ま" },
            { "b": "に " },
            { "b": "合", "r": "あ" },
            { "b": "わないかも しれません。" }
          ],
          "translation": "或許趕不上約定的時間。"
        }
      ]
    },
    {
      "id": "L32-G04",
      "pattern": "きっと／たぶん／もしかしたら",
      "explanation": "1)「きっと」這個副詞在說話人對自己的推測有信心時使用,它的使用範圍是從確信度高接近於斷定的推測,到「〜でしょう」程度的推測。2)「たぶん」比「きっと」確信度低的推測,常與「〜でしょう」一起使用。此外,像例句⑩一樣,也常與「〜と おもいます」(第21課)一起使用。3)「もしかしたら」一般和「〜かも しれません」一起用。帶有「もしかしたら」的句子比不帶的句子(例句⑪中的“不能畢業”),可以表示說話人所推測的可能性較低。",
      "examples": [
        {
          "id": "L32-S09",
          "ruby": [
            { "b": "ミラーさんは きっと " },
            { "b": "来", "r": "き" },
            { "b": "ます。" }
          ],
          "translation": "米勒先生一定會來。"
        },
        {
          "id": "L32-S10",
          "ruby": [
            { "b": "あしたは きっと " },
            { "b": "雨", "r": "あめ" },
            { "b": "でしょう。" }
          ],
          "translation": "明天一定會下雨吧。"
        },
        {
          "id": "L32-S11",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "来", "r": "く" },
            { "b": "るでしょうか。" }
          ],
          "translation": "米勒先生會來吧。"
        },
        {
          "id": "L32-S12",
          "ruby": [
            { "b": "…たぶん " },
            { "b": "来", "r": "く" },
            { "b": "るでしょう。" }
          ],
          "translation": "…大概會來吧。"
        },
        {
          "id": "L32-S13",
          "ruby": [
            { "b": "山田", "r": "やまだ" },
            { "b": "さんは この ニュースを たぶん " },
            { "b": "知", "r": "し" },
            { "b": "らないと " },
            { "b": "思", "r": "おも" },
