  "grammar": [
    {
      "id": "L10-G01",
      "pattern": "名詞 が あります／います",
      "explanation": "這個句型是在敘述事物或人的存在。存在的事物或人,會以這類句子的主語出現在會話等場面中。主語用助詞「が」表示。「あります」用於事物、植物等,存在的主體本身不會移動的情況;「います」用於人或動物等,存在的主體能夠自行移動的情況。",
      "examples": [
        {
          "id": "L10-S01",
          "ruby": [{ "b": "コンピューターが あります。" }],
          "translation": "有電腦。"
        },
        {
          "id": "L10-S02",
          "ruby": [{ "b": "桜", "r": "さくら" }, { "b": "が あります。" }],
          "translation": "有櫻花樹。"
        },
        {
          "id": "L10-S03",
          "ruby": [{ "b": "公園", "r": "こうえん" }, { "b": "が あります。" }],
          "translation": "有個公園。"
        },
        {
          "id": "L10-S04",
          "ruby": [
            { "b": "男", "r": "おとこ" },
            { "b": "の " },
            { "b": "人", "r": "ひと" },
            { "b": "が います。" }
          ],
          "translation": "有個男人。"
        },
        {
          "id": "L10-S05",
          "ruby": [{ "b": "犬", "r": "いぬ" }, { "b": "が います。" }],
          "translation": "有隻狗。"
        }
      ]
    },
    {
      "id": "L10-G02",
      "pattern": "名詞1（場所）に 名詞2が あります／います",
      "explanation": "名詞2的存在場所,用助詞「に」表示。用這個句型可以詢問某個地方有什麼或者有誰。詢問事物時用疑問詞「なに」,詢問人時用疑問詞「だれ」。",
      "examples": [
        {
          "id": "L10-S06",
          "ruby": [
            { "b": "わたしの " },
            { "b": "部屋", "r": "へや" },
            { "b": "に " },
            { "b": "机", "r": "つくえ" },
            { "b": "が あります。" }
          ],
          "translation": "我的房間裡有桌子。"
        },
        {
          "id": "L10-S07",
          "ruby": [
            { "b": "事務所", "r": "じむしょ" },
            { "b": "に ミラーさんが います。" }
          ],
          "translation": "辦公室裡有米勒先生在。"
        },
        {
          "id": "L10-S08",
          "ruby": [
            { "b": "地下", "r": "ちか" },
            { "b": "に " },
            { "b": "何", "r": "なに" },
            { "b": "が ありますか。" }
          ],
          "translation": "地下室有什麼？"
        },
        {
          "id": "L10-S09",
          "ruby": [
            { "b": "受付", "r": "うけつけ" },
            { "b": "に だれが いますか。" }
          ],
          "translation": "有誰在接待處？"
        }
      ]
    },
    {
      "id": "L10-G03",
      "pattern": "名詞1は 名詞2（場所）に あります／います",
      "explanation": "這個句型是說話人將名詞1作為主題提出,再敘述其所在。主題必須是說話人和聽話人雙方都明白的事物或人。由於名詞1是主題,所以要用提示主題的「は」,而不是提示主語的「が」。詢問名詞1在哪裡時使用這個句型。",
      "examples": [
        {
          "id": "L10-S10",
          "ruby": [
            { "b": "東京", "r": "とうきょう" },
            { "b": "ディズニーランドは " },
            { "b": "千葉県", "r": "ちばけん" },
            { "b": "に あります。" }
          ],
          "translation": "東京迪士尼樂園在千葉縣。"
        },
        {
          "id": "L10-S11",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "事務所", "r": "じむしょ" },
            { "b": "に います。" }
          ],
          "translation": "米勒先生在辦公室。"
        },
        {
          "id": "L10-S12",
          "ruby": [
            { "b": "東京", "r": "とうきょう" },
            { "b": "ディズニーランドは どこに ありますか。" }
          ],
          "translation": "東京迪士尼樂園在哪裡？"
        },
        {
          "id": "L10-S13",
          "ruby": [{ "b": "ミラーさんは どこに いますか。" }],
          "translation": "米勒先生在哪裡？"
        },
        {
          "id": "L10-S14",
          "ruby": [
            { "b": "東京", "r": "とうきょう" },
            { "b": "ディズニーランドは どこに ありますか。…" },
            { "b": "千葉県", "r": "ちばけん" },
            { "b": "です。" }
          ],
          "translation": "東京迪士尼樂園在哪裡？…千葉縣。"
        }
      ]
    },
    {
      "id": "L10-G04",
      "pattern": "名詞1（事物／人／地點）の 名詞2（位置）",
      "explanation": "うえ、した、まえ、うしろ、みぎ、ひだり、なか、そと、となり、ちかく、あいだ都是表示位置的名詞。由於這些都是表示場所的名詞,所以和其他表示場所的名詞一樣,可以放在助詞「で」的前面。",
      "examples": [
        {
          "id": "L10-S15",
          "ruby": [
            { "b": "机", "r": "つくえ" },
            { "b": "の " },
            { "b": "上", "r": "うえ" },
            { "b": "に " },
            { "b": "写真", "r": "しゃしん" },
            { "b": "が あります。" }
          ],
          "translation": "桌子上有相片。"
        },
        {
          "id": "L10-S16",
          "ruby": [
            { "b": "郵便局", "r": "ゆうびんきょく" },
            { "b": "は " },
            { "b": "銀行", "r": "ぎんこう" },
            { "b": "の " },
            { "b": "隣", "r": "となり" },
            { "b": "に あります。" }
          ],
          "translation": "郵局在銀行隔壁。"
        },
        {
          "id": "L10-S17",
          "ruby": [
            { "b": "駅", "r": "えき" },
            { "b": "の " },
            { "b": "近", "r": "ちか" },
            { "b": "くで " },
            { "b": "友達", "r": "ともだち" },
            { "b": "に " },
            { "b": "会", "r": "あ" },
            { "b": "いました。" }
          ],
          "translation": "在車站附近見到了朋友。"
        }
      ]
    },
    {
      "id": "L10-G05",
      "pattern": "名詞1や 名詞2",
      "explanation": "助詞「や」在列舉名詞時使用。相對於「と」是全部列出,「や」則只說出代表性的幾個(兩個以上)。也有在最後一個名詞後接「など」,以清楚地說明除了列舉的以外還有的說法。",
      "examples": [
        {
          "id": "L10-S18",
          "ruby": [
            { "b": "箱", "r": "はこ" },
            { "b": "の " },
            { "b": "中", "r": "なか" },
            { "b": "に " },
            { "b": "手紙", "r": "てがみ" },
            { "b": "や " },
            { "b": "写真", "r": "しゃしん" },
            { "b": "が あります。" }
          ],
          "translation": "箱子裡有信和相片。"
        },
        {
          "id": "L10-S19",
          "ruby": [
            { "b": "箱", "r": "はこ" },
            { "b": "の " },
            { "b": "中", "r": "なか" },
            { "b": "に " },
            { "b": "手紙", "r": "てがみ" },
            { "b": "や " },
            { "b": "写真", "r": "しゃしん" },
            { "b": "などが あります。" }
          ],
          "translation": "箱子裡有信和相片等。"
        }
      ]
    },
    {
      "id": "L10-G06",
      "pattern": "單詞 ですか",
      "explanation": "助詞「か」有確認的作用。說話人提出要確認的詞,以這種形式進行確認。",
      "examples": [
        {
          "id": "L10-S20",
          "ruby": [
            { "b": "すみません。ユニューヤ・ストアは どこですか。…ユニューヤ・ストアですか。あの ビルの " },
            { "b": "中", "r": "なか" },
            { "b": "です。" }
          ],
          "translation": "對不起,請問尤紐雅商店在哪裡？…尤紐雅商店嗎？在那棟大樓裡面。"
        }
      ]
    },
    {
      "id": "L10-G07",
      "pattern": "チリソースは ありませんか",
      "explanation": "本課的會話中有「チリソースは ありませんか」這麼一句話。不用「ありますか」而用否定形「ありませんか」詢問,是顧慮到對方可能沒有「チリソース」的一種委婉的問法,表現出說話人的禮貌。",
      "examples": [
        {
          "id": "L10-S21",
          "ruby": [{ "b": "チリソースは ありませんか。" }],
          "translation": "沒有辣醬嗎？"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L10-D01",
      "ruby": [
        { "b": "すみません。ユニューヤ・ストアは どこですか。" }
      ],
      "translation": "不好意思,請問尤紐雅商店在哪裡？",
      "speaker": "ミラー"
    },
    {
      "id": "L10-D02",
      "ruby": [
        { "b": "ユニューヤ・ストアですか。あそこに " },
        { "b": "白", "r": "しろ" },
        { "b": "い ビルが ありますね。あの ビルの " },
        { "b": "中", "r": "なか" },
        { "b": "です。" }
      ],
      "translation": "尤紐雅商店嗎？那邊有一棟白色的大樓對吧。就在那棟大樓裡面。",
      "speaker": "女の人"
    },
    {
      "id": "L10-D03",
      "ruby": [{ "b": "そうですか。どうも すみません。" }],
      "translation": "這樣啊。非常謝謝您。",
      "speaker": "ミラー"
    },
    {
      "id": "L10-D04",
      "ruby": [{ "b": "いいえ。" }],
      "translation": "不客氣。",
      "speaker": "女の人"
    },
    {
      "id": "L10-D05",
      "ruby": [
        { "b": "あのう、チリソースは ありませんか。" }
      ],
      "translation": "請問一下,有沒有辣醬呢？",
      "speaker": "ミラー"
    },
    {
      "id": "L10-D06",
      "ruby": [
        { "b": "はい。" },
        { "b": "右", "r": "みぎ" },
        { "b": "の " },
        { "b": "奥", "r": "おく" },
        { "b": "に スパイス・コーナーが あります。チリソースは " },
        { "b": "下", "r": "した" },
        { "b": "から 2" },
        { "b": "段目", "r": "だんめ" },
        { "b": "です。" }
      ],
      "translation": "有的。右邊裡面有香辣調味料專櫃。辣醬在從下面數來第二層。",
      "speaker": "店員"
    },
    {
      "id": "L10-D07",
      "ruby": [{ "b": "わかりました。どうも。" }],
      "translation": "我知道了。謝謝。",
      "speaker": "ミラー"
    }
  ]
}
