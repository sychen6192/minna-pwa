  "grammar": [
    {
      "id": "L03-G01",
      "pattern": "ここ／そこ／あそこ／こちら／そちら／あちら",
      "explanation": "第二課學到的「これ」「それ」「あれ」是表示物的指示代名詞,而「ここ」「そこ」「あそこ」則是表示場所的指示代名詞。「ここ」是指說話人所在的場所,「そこ」是指聽話人所在的場所,「あそこ」是指離二人都遠的場所。此外,「こちら」「そちら」「あちら」雖是表示方向的指示代名詞,但可以取代「ここ」「そこ」「あそこ」指示眼前的場所。這時的語氣更為鄭重。〔註〕說話人把聽話人也視為自己的領域內時,則二人所在的場所為「ここ」,稍遠的地方為「そこ」,更遠為「あそこ」。",
      "examples": [
        {
          "id": "L03-S01",
          "ruby": [{ "b": "ここは " }, { "b": "食堂", "r": "しょくどう" }, { "b": "です。" }],
          "translation": "這裡是食堂。"
        }
      ]
    },
    {
      "id": "L03-G02",
      "pattern": "名詞1は 名詞2（場所）です",
      "explanation": "使用這個句型,可以表現出物、人等的存在場所。",
      "examples": [
        {
          "id": "L03-S02",
          "ruby": [
            { "b": "お" },
            { "b": "手洗", "r": "てあら" },
            { "b": "いは あそこです。" }
          ],
          "translation": "洗手間在那裡。"
        },
        {
          "id": "L03-S03",
          "ruby": [
            { "b": "電話", "r": "でんわ" },
            { "b": "は ２" },
            { "b": "階", "r": "かい" },
            { "b": "です。" }
          ],
          "translation": "電話在二樓。"
        },
        {
          "id": "L03-S04",
          "ruby": [
            { "b": "山田", "r": "やまだ" },
            { "b": "さんは " },
            { "b": "事務所", "r": "じむしょ" },
            { "b": "です。" }
          ],
          "translation": "山田先生在辦公室。"
        }
      ]
    },
    {
      "id": "L03-G03",
      "pattern": "どこ／どちら",
      "explanation": "「どこ」「どちら」是分別表示場所和方向的疑問詞。詢問場所時也可以用「どちら」,這時會比「どこ」更鄭重。此外,在詢問國家、公司、學校等所屬的場所和組織名時,疑問詞應是「どこ」「どちら」,而不是「なん（什麼）」。「どちら」比「どこ」更鄭重。",
      "examples": [
        {
          "id": "L03-S05",
          "ruby": [
            { "b": "お" },
            { "b": "手洗", "r": "てあら" },
            { "b": "いは どこですか。" }
          ],
          "translation": "洗手間在哪裡？"
        },
        {
          "id": "L03-S06",
          "ruby": [{ "b": "… あそこです。" }],
          "translation": "…在那裡。"
        },
        {
          "id": "L03-S07",
          "ruby": [{ "b": "エレベーターは どちらですか。" }],
          "translation": "電梯在哪裡？"
        },
        {
          "id": "L03-S08",
          "ruby": [{ "b": "… あちらです。" }],
          "translation": "…在那裡。"
        },
        {
          "id": "L03-S09",
          "ruby": [
            { "b": "学校", "r": "がっこう" },
            { "b": "は どこですか。" }
          ],
          "translation": "學校在哪裡？"
        },
        {
          "id": "L03-S10",
          "ruby": [
            { "b": "会社", "r": "かいしゃ" },
            { "b": "は どちらですか。" }
          ],
          "translation": "公司在哪裡？"
        }
      ]
    },
    {
      "id": "L03-G04",
      "pattern": "名詞1の 名詞2",
      "explanation": "名詞1是國家名稱,名詞2是產品名時,「名詞1の」是指該國家製造的意思。而名詞1是公司名稱,名詞2是產品名時,「名詞1の」是指該公司生產的。這個疑問句中的疑問詞用「どこ」。",
      "examples": [
        {
          "id": "L03-S11",
          "ruby": [{ "b": "これは どこの コンピューターですか。" }],
          "translation": "這是哪裡的電腦呢？"
        },
        {
          "id": "L03-S12",
          "ruby": [
            { "b": "… " },
            { "b": "日本", "r": "にほん" },
            { "b": "の コンピューターです。" }
          ],
          "translation": "…這是日本的電腦。"
        },
        {
          "id": "L03-S13",
          "ruby": [{ "b": "… IMC の コンピューターです。" }],
          "translation": "… IMC 的電腦。"
        }
      ]
    },
    {
      "id": "L03-G05",
      "pattern": "「こ／そ／あ／ど」（指示詞）一覽表",
      "explanation": "「こ／そ／あ／ど」指示詞依「こ」系列、「そ」系列、「あ」系列、「ど」系列,可表示物（これ・それ・あれ・どれ;この・その・あの・どの 名詞）、場所（ここ・そこ・あそこ・どこ）、方向（こちら・そちら・あちら・どちら）等。",
      "examples": [
        {
          "id": "L03-S14",
          "ruby": [{ "b": "ここ／そこ／あそこ／どこ" }],
          "translation": "（場所）這裡／那裡／那裡／哪裡"
        }
      ]
    },
    {
      "id": "L03-G06",
      "pattern": "お国",
      "explanation": "接頭語「お」加在關於聽話人或第三者的事物前,表達說話人的敬意。",
      "examples": [
        {
          "id": "L03-S15",
          "ruby": [
            { "b": "〔お〕" },
            { "b": "国", "r": "くに" },
            { "b": "は どちらですか。" }
          ],
          "translation": "您是從哪裡來的？"
        }
      ]
    }
  ],
