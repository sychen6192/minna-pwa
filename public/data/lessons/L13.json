  "grammar": [
    {
      "id": "L13-G01",
      "pattern": "わたしは パソコンが 欲しいです",
      "examples": [
        {
          "id": "L13-S01",
          "ruby": [
            { "b": "今", "r": "いま" },
            { "b": " " },
            { "b": "何", "r": "なに" },
            { "b": "が いちばん " },
            { "b": "欲", "r": "ほ" },
            { "b": "しいですか。" }
          ],
          "translation": "現在最想要什麼？"
        },
        {
          "id": "L13-S02",
          "ruby": [
            { "b": "…うちが " },
            { "b": "欲", "r": "ほ" },
            { "b": "しいです。" }
          ],
          "translation": "…想要房子。"
        }
      ]
    },
    {
      "id": "L13-G02",
      "pattern": "わたしは てんぷらを 食べたいです",
      "examples": [
        {
          "id": "L13-S03",
          "ruby": [
            { "b": "夏休", "r": "なつやす" },
            { "b": "みに どこへ " },
            { "b": "行", "r": "い" },
            { "b": "きたいですか。" }
          ],
          "translation": "暑假想去哪裡？"
        },
        {
          "id": "L13-S04",
          "ruby": [
            { "b": "…" },
            { "b": "沖縄", "r": "おきなわ" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きたいです。" }
          ],
          "translation": "…想去沖繩。"
        },
        {
          "id": "L13-S05",
          "ruby": [
            { "b": "きょうは " },
            { "b": "疲", "r": "つか" },
            { "b": "れましたから、" },
            { "b": "何", "r": "なに" },
            { "b": "も したくないです。" }
          ],
          "translation": "今天累了，所以什麼都不想做。"
        }
      ]
    },
    {
      "id": "L13-G03",
      "pattern": "わたしは フランスへ 料理を 習いに 行きます",
      "examples": [
        {
          "id": "L13-S06",
          "ruby": [
            { "b": "この " },
            { "b": "週末", "r": "しゅうまつ" },
            { "b": "は " },
            { "b": "何", "r": "なに" },
            { "b": "を しますか。" }
          ],
          "translation": "這個週末要做什麼？"
        },
        {
          "id": "L13-S07",
          "ruby": [
            { "b": "…" },
            { "b": "子", "r": "こ" },
            { "b": "どもと " },
            { "b": "神戸", "r": "こうべ" },
            { "b": "へ " },
            { "b": "船", "r": "ふね" },
            { "b": "を " },
            { "b": "見", "r": "み" },
            { "b": "に " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "…要和孩子去神戶看船。"
        },
        {
          "id": "L13-S08",
          "ruby": [
            { "b": "日本", "r": "にほん" },
            { "b": "へ " },
            { "b": "何", "r": "なん" },
            { "b": "の " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "に " },
            { "b": "来", "r": "き" },
            { "b": "ましたか。" }
          ],
          "translation": "來日本學什麼？"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L13-D01",
      "ruby": [
        { "b": "もう 12" },
        { "b": "時", "r": "じ" },
        { "b": "ですよ。" },
        { "b": "昼", "r": "ひる" },
        { "b": "ごはんを " },
        { "b": "食", "r": "た" },
        { "b": "べに " },
        { "b": "行", "r": "い" },
        { "b": "きませんか。" }
      ],
      "translation": "已經 12 點了喔。要不要去吃午飯？",
      "speaker": "山田"
    },
    {
      "id": "L13-D02",
      "ruby": [{ "b": "ええ。" }],
      "translation": "好啊。",
      "speaker": "ミラー"
    },
    {
      "id": "L13-D03",
      "ruby": [{ "b": "どこへ " }, { "b": "行", "r": "い" }, { "b": "きますか。" }],
      "translation": "要去哪裡？",
      "speaker": "山田"
    },
    {
      "id": "L13-D04",
      "ruby": [
        { "b": "そうですね。きょうは " },
        { "b": "日本料理", "r": "にほんりょうり" },
        { "b": "が " },
        { "b": "食", "r": "た" },
        { "b": "べたいですね。" }
      ],
      "translation": "嗯…今天想吃日本料理呢。",
      "speaker": "ミラー"
    },
    {
      "id": "L13-D05",
      "ruby": [
        { "b": "じゃ、「つるや」へ " },
        { "b": "行", "r": "い" },
        { "b": "きましょう。" }
      ],
      "translation": "那麼，去「鶴屋」吧。",
      "speaker": "山田"
    },
    {
      "id": "L13-D06",
      "ruby": [{ "b": "ご" }, { "b": "注文", "r": "ちゅうもん" }, { "b": "は?" }],
      "translation": "您要點什麼？",
      "speaker": "店の人"
    },
    {
      "id": "L13-D07",
      "ruby": [{ "b": "わたしは てんぷら" }, { "b": "定食", "r": "ていしょく" }, { "b": "。" }],
      "translation": "我要天婦羅定食。",
      "speaker": "ミラー"
    },
    {
      "id": "L13-D08",
      "ruby": [{ "b": "わたしは " }, { "b": "牛", "r": "ぎゅう" }, { "b": "どん。" }],
      "translation": "我要牛肉蓋飯。",
      "speaker": "山田"
    },
    {
      "id": "L13-D09",
      "ruby": [
        { "b": "てんぷら" },
        { "b": "定食", "r": "ていしょく" },
        { "b": "と " },
        { "b": "牛", "r": "ぎゅう" },
        { "b": "どんですね。" },
        { "b": "少々", "r": "しょうしょう" },
        { "b": " お" },
        { "b": "待", "r": "ま" },
        { "b": "ちください。" }
      ],
      "translation": "天婦羅定食和牛肉蓋飯對吧。請稍待。",
      "speaker": "店の人"
    },
    {
      "id": "L13-D10",
      "ruby": [
        { "b": "1,680" },
        { "b": "円", "r": "えん" },
        { "b": "で ございます。" }
      ],
      "translation": "一共 1,680 日圓。",
      "speaker": "店の人"
    },
    {
      "id": "L13-D11",
      "ruby": [
        { "b": "すみません。" },
        { "b": "別々", "r": "べつべつ" },
        { "b": "に お" },
        { "b": "願", "r": "ねが" },
        { "b": "いします。" }
      ],
      "translation": "不好意思，請分開算。",
      "speaker": "ミラー"
    },
    {
      "id": "L13-D12",
      "ruby": [
        { "b": "はい。てんぷら" },
        { "b": "定食", "r": "ていしょく" },
        { "b": "は 980" },
        { "b": "円", "r": "えん" },
        { "b": "、" },
        { "b": "牛", "r": "ぎゅう" },
        { "b": "どんは 700" },
        { "b": "円", "r": "えん" },
        { "b": "です。" }
      ],
      "translation": "好的。天婦羅定食 980 日圓，牛肉蓋飯 700 日圓。",
      "speaker": "店の人"
    }
  ]
