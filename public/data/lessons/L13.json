  "grammar": [
    {
      "id": "L13-G01",
      "pattern": "(名詞)が ほしいです",
      "explanation": "表達說話者想要某物。對象用助詞「が」標記;否定為「ほしくないです」。",
      "examples": [
        {
          "id": "L13-S01",
          "ruby": [{ "b": "私", "r": "わたし" }, { "b": "は カメラが ほしいです" }],
          "translation": "我想要相機。"
        },
        {
          "id": "L13-S02",
          "ruby": [
            { "b": "今", "r": "いま" },
            { "b": "は " },
            { "b": "何", "r": "なに" },
            { "b": "も ほしくないです" }
          ],
          "translation": "現在我什麼都不想要。"
        }
      ]
    },
    {
      "id": "L13-G02",
      "pattern": "(動詞ます形)たいです",
      "explanation": "表達說話者想做某動作。對象的助詞「を」可改用「が」;否定為「〜たくないです」。",
      "examples": [
        {
          "id": "L13-S03",
          "ruby": [
            { "b": "私", "r": "わたし" },
            { "b": "は " },
            { "b": "日本", "r": "にほん" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きたいです" }
          ],
          "translation": "我想去日本。"
        },
        {
          "id": "L13-S04",
          "ruby": [
            { "b": "何", "r": "なに" },
            { "b": "が " },
            { "b": "食", "r": "た" },
            { "b": "べたいですか" }
          ],
          "translation": "你想吃什麼?"
        }
      ]
    }
  ],
