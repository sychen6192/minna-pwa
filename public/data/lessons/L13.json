  "grammar": [
    {
      "id": "L13-G01",
      "pattern": "(名詞)が 欲しいです",
      "explanation": "表現說話人想要得到某物(或某人),也用於詢問聽話人想要什麼。需求的對象用助詞「が」表示;「ほしい」是い形容詞。",
      "examples": [
        {
          "id": "L13-S01",
          "ruby": [
            { "b": "わたしは " },
            { "b": "友達", "r": "ともだち" },
            { "b": "が " },
            { "b": "欲", "r": "ほ" },
            { "b": "しいです。" }
          ],
          "translation": "我想交朋友。"
        },
        {
          "id": "L13-S02",
          "ruby": [
            { "b": "今", "r": "いま" },
            { "b": " " },
            { "b": "何", "r": "なに" },
            { "b": "が いちばん " },
            { "b": "欲", "r": "ほ" },
            { "b": "しいですか。" }
          ],
          "translation": "現在你最想要的是什麼？"
        },
        {
          "id": "L13-S03",
          "ruby": [
            { "b": "…" },
            { "b": "車", "r": "くるま" },
            { "b": "が " },
            { "b": "欲", "r": "ほ" },
            { "b": "しいです。" }
          ],
          "translation": "…想要汽車。"
        },
        {
          "id": "L13-S04",
          "ruby": [
            { "b": "子", "r": "こ" },
            { "b": "どもが " },
            { "b": "欲", "r": "ほ" },
            { "b": "しいですか。" }
          ],
          "translation": "想要孩子嗎？"
        },
        {
          "id": "L13-S05",
          "ruby": [
            { "b": "…いいえ、" },
            { "b": "欲", "r": "ほ" },
            { "b": "しくないです。" }
          ],
          "translation": "…不想要。"
        }
      ]
    },
    {
      "id": "L13-G02",
      "pattern": "(動詞ます形)たいです",
      "explanation": "表達想要進行某行為,用於說話人自己的希望或詢問對方的希望。句中助詞「を」可換成「が」(其他助詞不可);「動詞ます形たい」的活用與い形容詞相同。第三者的希望不可用此句型。",
      "examples": [
        {
          "id": "L13-S06",
          "ruby": [
            { "b": "わたしは " },
            { "b": "沖縄", "r": "おきなわ" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きたいです。" }
          ],
          "translation": "我想去沖繩。"
        },
        {
          "id": "L13-S07",
          "ruby": [
            { "b": "わたしは てんぷらを " },
            { "b": "食", "r": "た" },
            { "b": "べたいです。" }
          ],
          "translation": "我想吃天麩羅。"
        },
        {
          "id": "L13-S08",
          "ruby": [
            { "b": "神戸", "r": "こうべ" },
            { "b": "で " },
            { "b": "何", "r": "なに" },
            { "b": "を " },
            { "b": "買", "r": "か" },
            { "b": "いたいですか。" }
          ],
          "translation": "想在神戶買什麼？"
        },
        {
          "id": "L13-S09",
          "ruby": [
            { "b": "…" },
            { "b": "靴", "r": "くつ" },
            { "b": "を " },
            { "b": "買", "r": "か" },
            { "b": "いたいです。" }
          ],
          "translation": "…想買鞋。"
        },
        {
          "id": "L13-S10",
          "ruby": [
            { "b": "おなかが " },
            { "b": "痛", "r": "いた" },
            { "b": "いですから、" },
            { "b": "何", "r": "なに" },
            { "b": "も " },
            { "b": "食", "r": "た" },
            { "b": "べたくないです。" }
          ],
          "translation": "因為肚子疼,什麼也不想吃。"
        }
      ]
    },
    {
      "id": "L13-G03",
      "pattern": "(名詞〔場所〕)へ (動詞ます形/名詞)に 行きます／来ます／帰ります",
      "explanation": "助詞「に」前的動詞(ます形)或名詞,表示「行きます/来ます/帰ります」的目的;「に」前的名詞須為表示行為的名詞。",
      "examples": [
        {
          "id": "L13-S11",
          "ruby": [
            { "b": "神戸", "r": "こうべ" },
            { "b": "へ インド" },
            { "b": "料理", "r": "りょうり" },
            { "b": "を " },
            { "b": "食", "r": "た" },
            { "b": "べに " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "去神戶吃印度菜。"
        },
        {
          "id": "L13-S12",
          "ruby": [
            { "b": "神戸", "r": "こうべ" },
            { "b": "へ " },
            { "b": "買", "r": "か" },
            { "b": "い" },
            { "b": "物", "r": "もの" },
            { "b": "に " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "去神戶買東西。"
        },
        {
          "id": "L13-S13",
          "ruby": [
            { "b": "日本", "r": "にほん" },
            { "b": "へ " },
            { "b": "美術", "r": "びじゅつ" },
            { "b": "の " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "に " },
            { "b": "来", "r": "き" },
            { "b": "ました。" }
          ],
          "translation": "來到日本學美術。"
        },
        {
          "id": "L13-S14",
          "ruby": [
            { "b": "あした " },
            { "b": "京都", "r": "きょうと" },
            { "b": "の お" },
            { "b": "祭", "r": "まつ" },
            { "b": "りに " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "明天去看京都的節慶活動。"
        }
      ]
    },
    {
      "id": "L13-G04",
      "pattern": "(名詞)に 動詞／(名詞)を 動詞",
      "explanation": "助詞「に」與「はいります」「のります」(第16課)等動詞並用,表示到達點;助詞「を」與「でます」「おります」(第16課)等動詞並用,表示起點、出發點。",
      "examples": [
        {
          "id": "L13-S15",
          "ruby": [
            { "b": "あの " },
            { "b": "喫茶店", "r": "きっさてん" },
            { "b": "に " },
            { "b": "入", "r": "はい" },
            { "b": "りましょう。" }
          ],
          "translation": "去那家咖啡店吧!"
        },
        {
          "id": "L13-S16",
          "ruby": [
            { "b": "7" },
            { "b": "時", "r": "じ" },
            { "b": "に うちを " },
            { "b": "出", "r": "で" },
            { "b": "ます。" }
          ],
          "translation": "7 點時離開家。"
        }
      ]
    },
    {
      "id": "L13-G05",
      "pattern": "どこか／何か",
      "explanation": "「どこか」表示某個地方,「なにか」表示某物。「どこか」「なにか」後面的助詞「へ」「を」可以省略。",
      "examples": [
        {
          "id": "L13-S17",
          "ruby": [
            { "b": "冬休", "r": "ふゆやす" },
            { "b": "みは どこか［へ］ " },
            { "b": "行", "r": "い" },
            { "b": "きましたか。" }
          ],
          "translation": "寒假有沒有去哪個地方呢？"
        },
        {
          "id": "L13-S18",
          "ruby": [{ "b": "…はい、" }, { "b": "行", "r": "い" }, { "b": "きました。" }],
          "translation": "…有的,去了。"
        },
        {
          "id": "L13-S19",
          "ruby": [
            { "b": "のどが かわきましたから、" },
            { "b": "何", "r": "なに" },
            { "b": "か［を］ " },
            { "b": "飲", "r": "の" },
            { "b": "みたいです。" }
          ],
          "translation": "口渴了,想喝點什麼。"
        }
      ]
    },
    {
      "id": "L13-G06",
      "pattern": "ご注文",
      "explanation": "有些詞前面會加上「ご」表示尊敬。",
      "examples": [
        {
          "id": "L13-S20",
          "ruby": [{ "b": "ご" }, { "b": "注文", "r": "ちゅうもん" }, { "b": "は?" }],
          "translation": "您要點些什麼？"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L13-D01",
      "ruby": [
        { "b": "もう 12" },
        { "b": "時", "r": "じ" },
        { "b": "ですよ。" },
        { "b": "昼", "r": "ひる" },
        { "b": "ごはんを " },
        { "b": "食", "r": "た" },
        { "b": "べに " },
        { "b": "行", "r": "い" },
        { "b": "きませんか。" }
      ],
      "translation": "已經 12 點了喔。要不要去吃午飯？",
      "speaker": "山田"
    },
    {
      "id": "L13-D02",
      "ruby": [{ "b": "ええ。" }],
      "translation": "好啊。",
      "speaker": "ミラー"
    },
    {
      "id": "L13-D03",
      "ruby": [{ "b": "どこへ " }, { "b": "行", "r": "い" }, { "b": "きますか。" }],
      "translation": "要去哪裡？",
      "speaker": "山田"
    },
    {
      "id": "L13-D04",
      "ruby": [
        { "b": "そうですね。きょうは " },
        { "b": "日本料理", "r": "にほんりょうり" },
        { "b": "が " },
        { "b": "食", "r": "た" },
        { "b": "べたいですね。" }
      ],
      "translation": "嗯…今天想吃日本料理呢。",
      "speaker": "ミラー"
    },
    {
      "id": "L13-D05",
