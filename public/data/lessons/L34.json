  "grammar": [
    {
      "id": "L34-G01",
      "pattern": "動詞1 とおりに、動詞2",
      "explanation": "這是將聽到、見到、讀到、學到（動詞1）的東西，用文字、語言或動作（動詞2）如實表現出來的意思。動詞1表示的動作，將要發生用字典形，已經發生的用た形。",
      "examples": [
        {
          "id": "L34-S01",
          "ruby": [{ "b": "わたしが やる とおりに、やって ください。" }],
          "translation": "請照著我做的做。"
        },
        {
          "id": "L34-S02",
          "ruby": [{ "b": "わたしが " }, { "b": "言", "r": "い" }, { "b": "う とおりに、" }, { "b": "書", "r": "か" }, { "b": "いて ください。" }],
          "translation": "請按我說的寫。"
        },
        {
          "id": "L34-S03",
          "ruby": [{ "b": "見", "r": "み" }, { "b": "た とおりに、" }, { "b": "話", "r": "はな" }, { "b": "して ください。" }],
          "translation": "請把你看的說出來。"
        }
      ]
    },
    {
      "id": "L34-G02",
      "pattern": "名詞の とおりに、動詞",
      "explanation": "表示按照名詞顯示的標準進行某個動作。",
      "examples": [
        {
          "id": "L34-S04",
          "ruby": [{ "b": "線", "r": "せん" }, { "b": "の とおりに、" }, { "b": "紙", "r": "かみ" }, { "b": "を " }, { "b": "切", "r": "き" }, { "b": "って ください。" }],
          "translation": "按這條線把紙裁開。"
        },
        {
          "id": "L34-S05",
          "ruby": [{ "b": "説明書", "r": "せつめいしょ" }, { "b": "の とおりに、" }, { "b": "組" }, { "b": "み" }, { "b": "立", "r": "た" }, { "b": "てました。" }],
          "translation": "按說明書進行了組裝。"
        }
      ]
    },
    {
      "id": "L34-G03",
      "pattern": "動詞1た形／名詞の あとで、動詞2",
      "explanation": "動詞1或名詞表示的事情進行（發生）後，再做動詞2所表示的事情。它在語氣上比同樣意思的「動詞て形から」更強調時間的前後關係。",
      "examples": [
        {
          "id": "L34-S06",
          "ruby": [{ "b": "新", "r": "あたら" }, { "b": "しいのを " }, { "b": "買", "r": "か" }, { "b": "った あとで、なくした " }, { "b": "時計", "r": "とけい" }, { "b": "が " }, { "b": "見", "r": "み" }, { "b": "つかりました。" }],
          "translation": "買了新的後，丟了的錶又找到了。"
        },
        {
          "id": "L34-S07",
          "ruby": [{ "b": "仕事", "r": "しごと" }, { "b": "の あとで、" }, { "b": "飲", "r": "の" }, { "b": "みに " }, { "b": "行", "r": "い" }, { "b": "きませんか。" }],
          "translation": "工作結束後要不要去喝杯酒呢？"
        }
      ]
    },
    {
      "id": "L34-G04",
      "pattern": "動詞1て形／動詞1ない形 ないで、動詞2",
      "explanation": "動詞1表示附隨在動詞2表示的動作、狀態下。例如下面的例句⑧⑨中，敘述的是「たべます」這個動作進行時，沾醬油還是不沾醬油。動詞1和動詞2的行為主體是同一個。",
      "examples": [
        {
          "id": "L34-S08",
          "ruby": [{ "b": "しょうゆを つけて " }, { "b": "食", "r": "た" }, { "b": "べます。" }],
          "translation": "沾醬油吃。"
        },
        {
          "id": "L34-S09",
          "ruby": [{ "b": "しょうゆを つけないで " }, { "b": "食", "r": "た" }, { "b": "べます。" }],
          "translation": "不沾醬油吃。"
        }
      ]
    },
    {
      "id": "L34-G05",
      "pattern": "動詞1ない形 ないで、動詞2",
      "explanation": "這個句型表示有兩個不能同時進行的事物（動詞1、動詞2），選擇其中一個（動詞2）進行的意思。",
      "examples": [
        {
          "id": "L34-S10",
          "ruby": [{ "b": "日曜日", "r": "にちようび" }, { "b": "は どこも " }, { "b": "行", "r": "い" }, { "b": "かないで、うちで ゆっくり " }, { "b": "休", "r": "やす" }, { "b": "みます。" }],
          "translation": "星期天哪裡也不去，要在家裡好好休息。"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L34-D01",
      "ruby": [{ "b": "一度", "r": "いちど" }, { "b": " " }, { "b": "茶道", "r": "さどう" }, { "b": "が " }, { "b": "見", "r": "み" }, { "b": "たいんですが……。" }],
      "translation": "我想看一次茶道……。",
      "speaker": "クララ"
    },
    {
      "id": "L34-D02",
      "ruby": [{ "b": "じゃ、" }, { "b": "来週", "r": "らいしゅう" }, { "b": "の " }, { "b": "土曜日", "r": "どようび" }, { "b": " いっしょに " }, { "b": "行", "r": "い" }, { "b": "きませんか。" }],
      "translation": "那麼，下週六要不要一起去呢？",
      "speaker": "渡辺"
    },
    {
      "id": "L34-D03",
      "ruby": [{ "b": "渡辺", "r": "わたなべ" }, { "b": "さん、お" }, { "b": "茶", "r": "ちゃ" }, { "b": "を たてて ください。" }],
      "translation": "渡邊先生，請您泡茶。",
      "speaker": "お茶の先生"
    },
    {
      "id": "L34-D04",
      "ruby": [{ "b": "クララさん、お" }, { "b": "菓子", "r": "かし" }, { "b": "を " }, { "b": "先", "r": "さき" }, { "b": "に どうぞ。" }],
      "translation": "克拉拉小姐，請先享用點心。",
      "speaker": "お茶の先生"
    },
    {
      "id": "L34-D05",
      "ruby": [{ "b": "えっ、" }, { "b": "先", "r": "さき" }, { "b": "に お" }, { "b": "菓子", "r": "かし" }, { "b": "を " }, { "b": "食", "r": "た" }, { "b": "べるんですか。" }],
      "translation": "咦，要先吃點心嗎？",
      "speaker": "クララ"
    },
    {
      "id": "L34-D06",
      "ruby": [{ "b": "ええ。" }, { "b": "甘", "r": "あま" }, { "b": "い お" }, { "b": "菓子", "r": "かし" }, { "b": "を " }, { "b": "食", "r": "た" }, { "b": "べた あとで、お" }, { "b": "茶", "r": "ちゃ" }, { "b": "を " }, { "b": "飲", "r": "の" }, { "b": "むと、おいしいんですよ。" }],
      "translation": "是的。吃了甜的點心之後再喝茶，會很好喝喔。",
      "speaker": "お茶の先生"
    },
    {
      "id": "L34-D07",
      "ruby": [{ "b": "そうですか。" }],
      "translation": "這樣啊。",
      "speaker": "クララ"
    },
    {
      "id": "L34-D08",
      "ruby": [{ "b": "では、お" }, { "b": "茶", "r": "ちゃ" }, { "b": "を " }, { "b": "飲", "r": "の" }, { "b": "みましょう。" }],
      "translation": "那麼，我們來喝茶吧。",
      "speaker": "お茶の先生"
    },
    {
      "id": "L34-D09",
      "ruby": [{ "b": "わたしが する とおりに、して くださいね。" }],
      "translation": "請照著我做的做喔。",
      "speaker": "お茶の先生"
    },
    {
      "id": "L34-D10",
