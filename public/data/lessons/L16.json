  "grammar": [
    {
      "id": "L16-G01",
      "pattern": "動詞て形、[動詞て形]、〜",
      "explanation": "連接動詞句時要用動詞的て形。這二個以上的動作連續發生時,按動作的先後順序用て形連接在一起,句子的時態由後面的動詞時態決定。",
      "examples": [
        {
          "id": "L16-S01",
          "ruby": [
            { "b": "朝", "r": "あさ" },
            { "b": " ジョギングを して、シャワーを " },
            { "b": "浴", "r": "あ" },
            { "b": "びて、" },
            { "b": "会社", "r": "かいしゃ" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "早上跑步,沖澡,然後去公司。"
        },
        {
          "id": "L16-S02",
          "ruby": [
            { "b": "神戸", "r": "こうべ" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "って、" },
            { "b": "映画", "r": "えいが" },
            { "b": "を " },
            { "b": "見", "r": "み" },
            { "b": "て、お " },
            { "b": "茶", "r": "ちゃ" },
            { "b": "を " },
            { "b": "飲", "r": "の" },
            { "b": "みました。" }
          ],
          "translation": "去神戶看了電影,喝了茶。"
        }
      ]
    },
    {
      "id": "L16-G02",
      "pattern": "い形容詞(〜い)→〜くて、〜",
      "explanation": "い形容詞句與其他句子連接時,去掉「い形容詞」的「い」,加上「くて」。「いい」為例外,變為「よくて」。",
      "examples": [
        {
          "id": "L16-S03",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "若", "r": "わか" },
            { "b": "くて、" },
            { "b": "元気", "r": "げんき" },
            { "b": "です。" }
          ],
          "translation": "米勒先生又年輕又健康。"
        },
        {
          "id": "L16-S04",
          "ruby": [
            { "b": "きのうは " },
            { "b": "天気", "r": "てんき" },
            { "b": "が よくて、" },
            { "b": "暑", "r": "あつ" },
            { "b": "かったです。" }
          ],
          "translation": "昨天天氣晴朗,很熱。"
        }
      ]
    },
    {
      "id": "L16-G03",
      "pattern": "名詞／な形容詞[な]で、〜",
      "explanation": "名詞句、な形容詞句的接續,把「です」改成「で」即可。〔註1〕這些接續除了相同的主題之外,也可以適用於不同主題的數個句子。〔註2〕這種接續方法不適用於價值觀相反的句子,這時要使用「が」(參考本書第8課7.助詞「が」)。",
      "examples": [
        {
          "id": "L16-S05",
          "ruby": [
            { "b": "カリナさんは インドネシア" },
            { "b": "人", "r": "じん" },
            { "b": "で、" },
            { "b": "京都大学", "r": "きょうとだいがく" },
            { "b": "の " },
            { "b": "留学生", "r": "りゅうがくせい" },
            { "b": "です。" }
          ],
          "translation": "卡莉娜小姐是印尼人,京都大學的留學生。"
        },
        {
          "id": "L16-S06",
          "ruby": [
            { "b": "ミラーさんは ハンサムで、" },
            { "b": "親切", "r": "しんせつ" },
            { "b": "です。" }
          ],
          "translation": "米勒先生既英俊又親切。"
        },
        {
          "id": "L16-S07",
          "ruby": [
            { "b": "奈良", "r": "なら" },
            { "b": "は " },
            { "b": "静", "r": "しず" },
            { "b": "かで、きれいな " },
            { "b": "町", "r": "まち" },
            { "b": "です。" }
          ],
          "translation": "奈良是既安靜又美麗的城市。"
        },
        {
          "id": "L16-S08",
          "ruby": [
            { "b": "カリナさんは " },
            { "b": "学生", "r": "がくせい" },
            { "b": "で、マリアさんは " },
            { "b": "主婦", "r": "しゅふ" },
            { "b": "です。" }
          ],
          "translation": "卡莉娜小姐是學生,而瑪麗亞女士是家庭主婦。"
        }
      ]
    },
    {
      "id": "L16-G04",
      "pattern": "動詞1て形から、動詞2",
      "explanation": "這個句型表示動詞1的動作結束後,接著進行動詞2動作的意思,句子的時態由最後一個動詞的時態決定。〔註〕從⑩句中的「コンサートが 終わってから」可以看出,從屬節的主語要用「が」表示。",
      "examples": [
        {
          "id": "L16-S09",
          "ruby": [
            { "b": "国", "r": "くに" },
            { "b": "へ " },
            { "b": "帰", "r": "かえ" },
            { "b": "ってから、" },
            { "b": "父", "r": "ちち" },
            { "b": "の " },
            { "b": "会社", "r": "かいしゃ" },
            { "b": "で " },
            { "b": "働", "r": "はたら" },
            { "b": "きます。" }
          ],
          "translation": "回國之後,要在父親的公司工作。"
        },
        {
          "id": "L16-S10",
          "ruby": [
            { "b": "コンサートが " },
            { "b": "終", "r": "お" },
            { "b": "わってから、レストランで " },
            { "b": "食事", "r": "しょくじ" },
            { "b": "しました。" }
          ],
          "translation": "音樂會結束之後,在餐廳進了餐。"
        }
      ]
    },
    {
      "id": "L16-G05",
      "pattern": "名詞1は 名詞2が 形容詞",
      "explanation": "這個句型是就「は」提示主題的事物或人的屬性等進行敘述。名詞1表示句子的主題;名詞2是形容詞表現的狀態、事物的主語。",
      "examples": [
        {
          "id": "L16-S11",
          "ruby": [
            { "b": "大阪", "r": "おおさか" },
            { "b": "は " },
            { "b": "食", "r": "た" },
            { "b": "べ" },
            { "b": "物", "r": "もの" },
            { "b": "が おいしいです。" }
          ],
          "translation": "大阪的食物很好吃。"
        },
        {
          "id": "L16-S12",
          "ruby": [
            { "b": "ドイツの フランケンは ワインが " },
            { "b": "有名", "r": "ゆうめい" },
            { "b": "です。" }
          ],
          "translation": "德國弗朗肯的葡萄酒很有名。"
        },
        {
          "id": "L16-S13",
          "ruby": [
            { "b": "マリアさんは " },
            { "b": "髪", "r": "かみ" },
            { "b": "が " },
            { "b": "長", "r": "なが" },
            { "b": "いです。" }
          ],
          "translation": "瑪麗亞女士的頭髮很長。"
        }
      ]
    },
    {
      "id": "L16-G06",
      "pattern": "どうやって",
