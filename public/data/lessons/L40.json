  "grammar": [
    {
      "id": "L40-G01",
      "pattern": "疑問詞 〜か、〜",
      "explanation": "這個句型是將含有疑問詞的疑問句組合在一個句子中時使用。",
      "examples": [
        {
          "id": "L40-S01",
          "ruby": [
            { "b": "JL107" },
            { "b": "便", "r": "びん" },
            { "b": "は " },
            { "b": "何時", "r": "なんじ" },
            { "b": "に " },
            { "b": "到着", "r": "とうちゃく" },
            { "b": "するか、" },
            { "b": "調", "r": "しら" },
            { "b": "べて ください。" }
          ],
          "translation": "請幫我查一下 JL107 班機幾點到。"
        },
        {
          "id": "L40-S02",
          "ruby": [
            { "b": "結婚", "r": "けっこん" },
            { "b": "の お" },
            { "b": "祝", "r": "いわ" },
            { "b": "いは " },
            { "b": "何", "r": "なに" },
            { "b": "が いいか、" },
            { "b": "話", "r": "はな" },
            { "b": "して います。" }
          ],
          "translation": "我們在談結婚的禮物要送什麼好。"
        },
        {
          "id": "L40-S03",
          "ruby": [
            { "b": "わたしたちが " },
            { "b": "初", "r": "はじ" },
            { "b": "めて " },
            { "b": "会", "r": "あ" },
            { "b": "ったのは いつか、" },
            { "b": "覚", "r": "おぼ" },
            { "b": "えて いますか。" }
          ],
          "translation": "我們第一次見面是什麼時候你記得嗎？"
        }
      ]
    },
    {
      "id": "L40-G02",
      "pattern": "〜か どうか、〜",
      "explanation": "將不含疑問詞的疑問句組合入一個句子中時使用這個句型。注意在「普通形か」後面必須接「どうか」。",
      "examples": [
        {
          "id": "L40-S04",
          "ruby": [
            { "b": "忘年会", "r": "ぼうねんかい" },
            { "b": "に " },
            { "b": "出席", "r": "しゅっせき" },
            { "b": "するか どうか、20" },
            { "b": "日", "r": "か" },
            { "b": "までに " },
            { "b": "返事", "r": "へんじ" },
            { "b": "を ください。" }
          ],
          "translation": "能否出席忘年會，請於 20 號前回答。"
        },
        {
          "id": "L40-S05",
          "ruby": [
            { "b": "その " },
            { "b": "話", "r": "はなし" },
            { "b": "は ほんとうか どうか、わかりません。" }
          ],
          "translation": "我不知道那個故事是不是真的。"
        },
        {
          "id": "L40-S06",
          "ruby": [
            { "b": "まちがいが ないか どうか、" },
            { "b": "調", "r": "しら" },
            { "b": "べて ください。" }
          ],
          "translation": "請檢查一下有沒有錯誤。"
        }
      ]
    },
    {
      "id": "L40-G03",
      "pattern": "(動詞て形) みます",
      "explanation": "用這個句型表示嘗試做某個動作的意思。",
      "examples": [
        {
          "id": "L40-S07",
          "ruby": [
            { "b": "もう " },
            { "b": "一度", "r": "いちど" },
            { "b": " " },
            { "b": "考", "r": "かんが" },
            { "b": "えて みます。" }
          ],
          "translation": "我會再次考慮的。"
        },
        {
          "id": "L40-S08",
          "ruby": [
            { "b": "宇宙", "r": "うちゅう" },
            { "b": "から " },
            { "b": "地球", "r": "ちきゅう" },
            { "b": "を " },
            { "b": "見", "r": "み" },
            { "b": "て みたいです。" }
          ],
          "translation": "想從宇宙看地球。"
        },
        {
          "id": "L40-S09",
          "ruby": [
            { "b": "この ズボンを はいて みても いいですか。" }
          ],
          "translation": "我能試穿這條褲子嗎？"
        }
      ]
    },
    {
      "id": "L40-G04",
      "pattern": "(い形容詞)〜い → 〜さ",
      "explanation": "い形容詞可以將語尾「い」改成「さ」作名詞用。",
      "examples": [
        {
          "id": "L40-S10",
          "ruby": [
            { "b": "山", "r": "やま" },
            { "b": "の " },
            { "b": "高", "r": "たか" },
            { "b": "さは どうやって " },
            { "b": "測", "r": "はか" },
            { "b": "るか、" },
            { "b": "知", "r": "し" },
            { "b": "って いますか。" }
          ],
          "translation": "你知道怎麼測量山的高度嗎？"
        },
        {
          "id": "L40-S11",
          "ruby": [
            { "b": "新", "r": "あたら" },
            { "b": "しい " },
            { "b": "橋", "r": "はし" },
            { "b": "の " },
            { "b": "長", "r": "なが" },
            { "b": "さは 3,911" },
            { "b": "メートルです。" }
          ],
          "translation": "新橋的長度為 3,911 公尺。"
        }
      ]
    },
    {
      "id": "L40-G05",
      "pattern": "〜でしょうか",
      "explanation": "「〜でしょうか」一般是在詢問對方可能不知道答案時用，但如果在對方可能知道答案仍然使用時，則為委婉的提問，也就是更有禮貌的提問。",
      "examples": [
        {
          "id": "L40-S12",
          "ruby": [
            { "b": "ハンスは " },
            { "b": "学校", "r": "がっこう" },
            { "b": "で どうでしょうか。" }
          ],
          "translation": "漢斯在學校的情況怎麼樣呢？"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L40-D01",
      "ruby": [
        { "b": "先生", "r": "せんせい" },
        { "b": "、ハンスは " },
        { "b": "学校", "r": "がっこう" },
        { "b": "で どうでしょうか。" },
        { "b": "友達", "r": "ともだち" },
        { "b": "が できたか どうか、" },
        { "b": "心配", "r": "しんぱい" },
        { "b": "なんですが……。" }
      ],
      "translation": "老師，漢斯在學校怎麼樣呢？我擔心他交到朋友了沒有……。",
      "speaker": "クララ"
    },
    {
      "id": "L40-D02",
      "ruby": [
        { "b": "大丈夫", "r": "だいじょうぶ" },
        { "b": "ですよ。ハンス" },
        { "b": "君", "r": "くん" },
        { "b": "は クラスで とても " },
        { "b": "人気", "r": "にんき" },
        { "b": "が あります。" }
      ],
      "translation": "沒問題的。漢斯在班上很受歡迎。",
      "speaker": "伊藤先生"
    },
    {
      "id": "L40-D03",
      "ruby": [
        { "b": "そうですか。" },
        { "b": "安心", "r": "あんしん" },
        { "b": "しました。" },
        { "b": "勉強", "r": "べんきょう" },
        { "b": "は どうですか。" },
        { "b": "漢字", "r": "かんじ" },
        { "b": "が " },
        { "b": "大変", "r": "たいへん" },
        { "b": "だと " },
        { "b": "言", "r": "い" },
        { "b": "って いますが……。" }
      ],
      "translation": "這樣啊。我放心了。功課方面怎麼樣呢？他說漢字很難……。",
      "speaker": "クララ"
    },
    {
      "id": "L40-D04",
      "ruby": [
        { "b": "毎日", "r": "まいにち" },
        { "b": " " },
        { "b": "漢字", "r": "かんじ" },
        { "b": "の テストを して いますが、ハンス" },
        { "b": "君", "r": "くん" },
        { "b": "は いい " },
        { "b": "成績", "r": "せいせき" },
        { "b": "ですよ。" }
      ],
      "translation": "雖然每天都考漢字測驗，但漢斯的成績很好喔。",
      "speaker": "伊藤先生"
    },
    {
      "id": "L40-D05",
      "ruby": [
