  "grammar": [
    {
      "id": "L07-G01",
      "pattern": "名詞（工具／手段）で 動詞",
      "explanation": "助詞「で」表示手段、方法。",
      "examples": [
        {
          "id": "L07-S01",
          "ruby": [{ "b": "はしで " }, { "b": "食", "r": "た" }, { "b": "べます。" }],
          "translation": "用筷子吃。"
        },
        {
          "id": "L07-S02",
          "ruby": [
            { "b": "日本語", "r": "にほんご" },
            { "b": "で レポートを " },
            { "b": "書", "r": "か" },
            { "b": "きます。" }
          ],
          "translation": "用日語寫報告。"
        }
      ]
    },
    {
      "id": "L07-G02",
      "pattern": "“詞／句” は 〜語で 何ですか",
      "explanation": "以這個疑問句，詢問某個詞或句子用別的語言怎麼說。",
      "examples": [
        {
          "id": "L07-S03",
          "ruby": [
            { "b": "「ありがとう」は " },
            { "b": "英語", "r": "えいご" },
            { "b": "で " },
            { "b": "何", "r": "なん" },
            { "b": "ですか。" }
          ],
          "translation": "“謝謝”用英語怎麼說？"
        },
        {
          "id": "L07-S04",
          "ruby": [{ "b": "…「Thank you」です。" }],
          "translation": "…是 “Thank you”。"
        },
        {
          "id": "L07-S05",
          "ruby": [
            { "b": "「Thank you」は " },
            { "b": "日本語", "r": "にほんご" },
            { "b": "で " },
            { "b": "何", "r": "なん" },
            { "b": "ですか。" }
          ],
          "translation": "“謝謝”用日語怎麼說？"
        },
        {
          "id": "L07-S06",
          "ruby": [{ "b": "…「ありがとう」です。" }],
          "translation": "…是 “ありがとう”。"
        }
      ]
    },
    {
      "id": "L07-G03",
      "pattern": "名詞（人）に あげます，等",
      "explanation": "「あげます」「かします」「おしえます」等動詞，都有給、借、教的對象人物，這個對象用助詞「に」表示。〔註〕「おくります」「でんわを かけます」之類的情況，對象除了人以外也可以是場所名詞。這時，除助詞「に」之外有時還會使用「へ」，例如「会社に 電話を かけます」。",
      "examples": [
        {
          "id": "L07-S07",
          "ruby": [
            { "b": "山田", "r": "やまだ" },
            { "b": "さんは " },
            { "b": "木村", "r": "きむら" },
            { "b": "さんに " },
            { "b": "花", "r": "はな" },
            { "b": "を " },
            { "b": "あげました。" }
          ],
          "translation": "山田先生送花給木村小姐。"
        },
        {
          "id": "L07-S08",
          "ruby": [
            { "b": "イーさんに " },
            { "b": "本", "r": "ほん" },
            { "b": "を " },
            { "b": "貸", "r": "か" },
            { "b": "しました。" }
          ],
          "translation": "借書給了李小姐。"
        },
        {
          "id": "L07-S09",
          "ruby": [
            { "b": "太郎", "r": "たろう" },
            { "b": "君", "r": "くん" },
            { "b": "に " },
            { "b": "英語", "r": "えいご" },
            { "b": "を " },
            { "b": "教", "r": "おし" },
            { "b": "えます。" }
          ],
          "translation": "教太郎英語。"
        },
        {
          "id": "L07-S10",
          "ruby": [
            { "b": "会社", "r": "かいしゃ" },
            { "b": "に " },
            { "b": "電話", "r": "でんわ" },
            { "b": "を " },
            { "b": "かけます。" }
          ],
          "translation": "打電話給公司。"
        }
      ]
    },
    {
      "id": "L07-G04",
      "pattern": "名詞（人）に もらいます，等",
      "explanation": "「もらいます」「かります」「ならいます」等動詞，是站在承受動作的人這方來說的。“得到”、“借”、“學習”的對象用助詞「に」表示。這個句型中，「に」可以用「から」代替。尤其當對象不是人，而是公司或學校等組織時，就要用「から」而不用「に」。",
      "examples": [
        {
          "id": "L07-S11",
          "ruby": [
            { "b": "木村", "r": "きむら" },
            { "b": "さんは " },
            { "b": "山田", "r": "やまだ" },
            { "b": "さんに " },
            { "b": "花", "r": "はな" },
            { "b": "を " },
            { "b": "もらいました。" }
          ],
          "translation": "木村小姐收到了山田先生送的花。"
        },
        {
          "id": "L07-S12",
          "ruby": [
            { "b": "カリナさんに ＣＤを " },
            { "b": "借", "r": "か" },
            { "b": "りました。" }
          ],
          "translation": "我向卡莉娜小姐借了 ＣＤ。"
        },
        {
          "id": "L07-S13",
          "ruby": [
            { "b": "ワンさんに " },
            { "b": "中国", "r": "ちゅうごく" },
            { "b": "を " },
            { "b": "習", "r": "なら" },
            { "b": "います。" }
          ],
          "translation": "跟王先生學中文。"
        },
        {
          "id": "L07-S14",
          "ruby": [
            { "b": "木村", "r": "きむら" },
            { "b": "さんは " },
            { "b": "山田", "r": "やまだ" },
            { "b": "さんから " },
            { "b": "花", "r": "はな" },
            { "b": "を もらいました。" }
          ],
          "translation": "木村小姐收到了山田先生送的花。"
        },
        {
          "id": "L07-S15",
          "ruby": [
            { "b": "銀行", "r": "ぎんこう" },
            { "b": "から お " },
            { "b": "金", "r": "かね" },
            { "b": "を " },
            { "b": "借", "r": "か" },
            { "b": "りました。" }
          ],
          "translation": "從銀行借了錢。"
        }
      ]
    },
    {
      "id": "L07-G05",
      "pattern": "もう 動詞 ました",
      "explanation": "「もう」是“已經”的意思，與「動詞ました」一起使用。這時的「動詞ました」，是現在的行為或事物已經結束的意思。對「もう 動詞ました」的回答，肯定時用「はい、もう 動詞ました」，否定用「いいえ、まだです」。這個句型的問句，回答若是否定時，不能用「動詞ませんでした」。「動詞ませんでした」表示過去沒做過某件事，不表示還沒做某件事。",
      "examples": [
        {
          "id": "L07-S16",
          "ruby": [
            { "b": "もう " },
            { "b": "荷物", "r": "にもつ" },
            { "b": "を " },
            { "b": "送", "r": "おく" },
            { "b": "りましたか。" }
          ],
          "translation": "行李已經送去了嗎？"
        },
        {
          "id": "L07-S17",
          "ruby": [
            { "b": "…はい、〔もう〕 " },
            { "b": "送", "r": "おく" },
            { "b": "りました。" }
          ],
          "translation": "…是，已經送去了。"
        },
        {
          "id": "L07-S18",
          "ruby": [{ "b": "…いいえ、まだです。" }],
          "translation": "…不，還沒有。"
        }
      ]
    }
  ],
