  "grammar": [
    {
      "id": "L35-G01",
      "pattern": "假定形(条件形)的變換方法",
      "explanation": "動詞 Ⅰ類:將「ます形」的最後一個假名換成「え段」音,再加上「ば」。Ⅱ類:在「ます形」後加上「れば」。Ⅲ類:「きます」是「くれば」,「します」是「すれば」。い形容詞:將い形容詞最後的假名「い」換成「ければ」。な形容詞:去掉な形容詞最後的假名「な」,加上「なら」。名詞:直接在名詞後加上「なら」。",
      "examples": [
        {
          "id": "L35-S01",
          "ruby": [
            { "b": "ボタンを " },
            { "b": "押", "r": "お" },
            { "b": "せば、" },
            { "b": "窓", "r": "まど" },
            { "b": "が " },
            { "b": "開", "r": "あ" },
            { "b": "きます。" }
          ],
          "translation": "按一下鈕,窗戶就會打開。"
        },
        {
          "id": "L35-S02",
          "ruby": [
            { "b": "彼", "r": "かれ" },
            { "b": "が " },
            { "b": "行", "r": "い" },
            { "b": "けば、わたしも " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "如果他去,我也去。"
        },
        {
          "id": "L35-S03",
          "ruby": [
            { "b": "いい " },
            { "b": "天気", "r": "てんき" },
            { "b": "なら、" },
            { "b": "向", "r": "む" },
            { "b": "こうに " },
            { "b": "島", "r": "しま" },
            { "b": "が " },
            { "b": "見", "r": "み" },
            { "b": "えます。" }
          ],
          "translation": "天氣好的話,就看得到對面的島。"
        }
      ]
    },
    {
      "id": "L35-G02",
      "pattern": "假定形、〜",
      "explanation": "為了使某件事情成立,將其必要條件以假定形放在句子前半部分。句子前半部分與後半部分的主語相同時,則前半部分和後半部分都不能用意志動詞。用於表示某件事情成立的必要條件時,或根據對方說的話或按當時的情況、由說話人進行判斷時。",
      "examples": [
        {
          "id": "L35-S04",
          "ruby": [
            { "b": "ほかに " },
            { "b": "意見", "r": "いけん" },
            { "b": "が なければ、これで " },
            { "b": "終", "r": "お" },
            { "b": "わりましょう。" }
          ],
          "translation": "如果沒有其他意見的話,就到此結束吧。"
        },
        {
          "id": "L35-S05",
          "ruby": [
            { "b": "あしたまでに レポートを " },
            { "b": "出", "r": "だ" },
            { "b": "さなければ なりませんか。" }
          ],
          "translation": "必須在明天以前交報告嗎?"
        },
        {
          "id": "L35-S06",
          "ruby": [
            { "b": "…" },
            { "b": "無理", "r": "むり" },
            { "b": "なら、" },
            { "b": "金曜日", "r": "きんようび" },
            { "b": "までに " },
            { "b": "出", "r": "だ" },
            { "b": "して ください。" }
          ],
          "translation": "…來不及的話,請在星期五以前交。"
        }
      ]
    },
    {
      "id": "L35-G03",
      "pattern": "名詞 なら、〜",
      "explanation": "「名詞なら、〜」也可以使用於就對方提出的話題再提供一些訊息時。",
      "examples": [
        {
          "id": "L35-S07",
          "ruby": [
            { "b": "温泉", "r": "おんせん" },
            { "b": "に " },
            { "b": "行", "r": "い" },
            { "b": "きたいんですが、どこか いい " },
            { "b": "所", "r": "ところ" },
            { "b": " ありませんか。" }
          ],
          "translation": "我想去溫泉,有什麼好的地方嗎?"
        },
        {
          "id": "L35-S08",
          "ruby": [
            { "b": "…" },
            { "b": "温泉", "r": "おんせん" },
            { "b": "なら、" },
            { "b": "白馬", "r": "はくば" },
            { "b": "が いいですよ。" }
          ],
          "translation": "…溫泉的話,白馬比較好。"
        }
      ]
    },
    {
      "id": "L35-G04",
      "pattern": "疑問詞 + 動詞假定形 + いいですか",
      "explanation": "這個句型在說話人就做某事的方法和應該做的事,向聽話人尋求建議和指示時使用。它和第26課中學過的「〜たら いいですか」用法相同。",
      "examples": [
        {
          "id": "L35-S09",
          "ruby": [
            { "b": "本", "r": "ほん" },
            { "b": "を " },
            { "b": "借", "r": "か" },
            { "b": "りたいんですが、どう すれば いいですか。" }
          ],
          "translation": "我想借書,應該怎麼做呢?"
        },
        {
          "id": "L35-S10",
          "ruby": [
            { "b": "本", "r": "ほん" },
            { "b": "を " },
            { "b": "借", "r": "か" },
            { "b": "りたいんですが、どう したら いいですか。" }
          ],
          "translation": "我想借書,應該怎麼做呢?(第26課)"
        }
      ]
    },
    {
      "id": "L35-G05",
      "pattern": "動詞/い形容詞/な形容詞 假定形 〜ば 〜ほど",
      "explanation": "同一句子中「〜ば／なら」和「〜ほど」前面,會出現相同的動詞、形容詞。這是隨著前半部分敘述的條件程度變化,後半部分敘述的內容程度和範圍也隨之增減的表達方式。",
      "examples": [
        {
          "id": "L35-S11",
          "ruby": [
            { "b": "ビートルズの " },
            { "b": "音楽", "r": "おんがく" },
            { "b": "は " },
            { "b": "聞", "r": "き" },
            { "b": "けば " },
            { "b": "聞", "r": "き" },
            { "b": "くほど " },
            { "b": "好", "r": "す" },
            { "b": "きに なります。" }
          ],
          "translation": "披頭四的音樂越聽越喜歡。"
        },
        {
          "id": "L35-S12",
          "ruby": [
            { "b": "パソコンは " },
            { "b": "操作", "r": "そうさ" },
            { "b": "が " },
            { "b": "簡単", "r": "かんたん" },
            { "b": "なほど いいです。" }
          ],
          "translation": "電腦的操作越簡單越好。"
        }
      ]
    }
  ],
