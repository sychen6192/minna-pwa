  "grammar": [
    {
      "id": "L09-G01",
      "pattern": "名詞が あります／わかります、名詞が 好きです／嫌いです／上手です／下手です",
      "explanation": "帶受詞的動詞,原則上在受詞後用助詞「を」表示,而「あります」「わかります」的對象則用「が」表示。另外如「すきです」「きらいです」「じょうずです」「へたです」這類的形容詞要表示對象時也用「が」。助詞「が」多用在形容詞、動詞表示嗜好、希求、能力、所有等時。",
      "examples": [
        {
          "id": "L09-S01",
          "ruby": [{ "b": "わたしは イタリア" }, { "b": "料理", "r": "りょうり" }, { "b": "が " }, { "b": "好", "r": "す" }, { "b": "きです。" }],
          "translation": "我喜歡義大利菜。"
        },
        {
          "id": "L09-S02",
          "ruby": [{ "b": "わたしは " }, { "b": "日本語", "r": "にほんご" }, { "b": "が わかります。" }],
          "translation": "我懂日語。"
        },
        {
          "id": "L09-S03",
          "ruby": [{ "b": "わたしは " }, { "b": "車", "r": "くるま" }, { "b": "が あります。" }],
          "translation": "我有車。"
        }
      ]
    },
    {
      "id": "L09-G02",
      "pattern": "どんな 名詞",
      "explanation": "除了第8課學過的用法之外,どんな也用在詢問某個名詞範疇內的事物或事情的具體名稱上。",
      "examples": [
        {
          "id": "L09-S04",
          "ruby": [{ "b": "どんな スポーツが " }, { "b": "好", "r": "す" }, { "b": "きですか。" }],
          "translation": "你喜歡什麼運動？"
        },
        {
          "id": "L09-S05",
          "ruby": [{ "b": "…サッカーが " }, { "b": "好", "r": "す" }, { "b": "きです。" }],
          "translation": "…我喜歡足球。"
        }
      ]
    },
    {
      "id": "L09-G03",
      "pattern": "よく／だいたい／たくさん／少し／あまり／全然",
      "explanation": "這些都是副詞,放在所修飾動詞之前。〔註〕「すこし」和「ぜんぜん」也可以修飾形容詞。",
      "examples": [
        {
          "id": "L09-S06",
          "ruby": [{ "b": "英語", "r": "えいご" }, { "b": "が よく わかります。" }],
          "translation": "我精通英語。"
        },
        {
          "id": "L09-S07",
          "ruby": [{ "b": "英語", "r": "えいご" }, { "b": "が " }, { "b": "少", "r": "すこ" }, { "b": "し わかります。" }],
          "translation": "我懂一點英語。"
        },
        {
          "id": "L09-S08",
          "ruby": [{ "b": "英語", "r": "えいご" }, { "b": "が あまり わかりません。" }],
          "translation": "我不太懂英語。"
        },
        {
          "id": "L09-S09",
          "ruby": [{ "b": "お" }, { "b": "金", "r": "かね" }, { "b": "が たくさん あります。" }],
          "translation": "有很多錢。"
        },
        {
          "id": "L09-S10",
          "ruby": [{ "b": "お" }, { "b": "金", "r": "かね" }, { "b": "が " }, { "b": "全然", "r": "ぜんぜん" }, { "b": " ありません。" }],
          "translation": "完全沒有錢。"
        },
        {
          "id": "L09-S11",
          "ruby": [{ "b": "ここは " }, { "b": "少", "r": "すこ" }, { "b": "し " }, { "b": "寒", "r": "さむ" }, { "b": "いです。" }],
          "translation": "這裡有點冷。"
        },
        {
          "id": "L09-S12",
          "ruby": [{ "b": "あの " }, { "b": "映画", "r": "えいが" }, { "b": "は " }, { "b": "全然", "r": "ぜんぜん" }, { "b": " おもしろくないです。" }],
          "translation": "那部電影一點都不好看。"
        }
      ]
    },
    {
      "id": "L09-G04",
      "pattern": "句子 1から、句子 2",
      "explanation": "「から」將二個句子連接成一個句子。句1是句2的原因、理由。也可以先陳述句2,再以句1から的形態補充理由。",
      "examples": [
        {
          "id": "L09-S13",
          "ruby": [{ "b": "時間", "r": "じかん" }, { "b": "が ありませんから、" }, { "b": "新聞", "r": "しんぶん" }, { "b": "を " }, { "b": "読", "r": "よ" }, { "b": "みません。" }],
          "translation": "沒有時間,所以不看報紙。"
        },
        {
          "id": "L09-S14",
          "ruby": [{ "b": "毎朝", "r": "まいあさ" }, { "b": " " }, { "b": "新聞", "r": "しんぶん" }, { "b": "を " }, { "b": "読", "r": "よ" }, { "b": "みますか。" }],
          "translation": "每天看報紙嗎？"
        },
        {
          "id": "L09-S15",
          "ruby": [{ "b": "…いいえ、" }, { "b": "読", "r": "よ" }, { "b": "みません、" }, { "b": "時間", "r": "じかん" }, { "b": "が ありませんから。" }],
          "translation": "…不看,因為沒有時間。"
        }
      ]
    },
    {
      "id": "L09-G05",
      "pattern": "どうして",
      "explanation": "用疑問詞「どうして」詢問原因。回答時句尾加「から」。在詢問對方原因時,不重複對方說的話而說「どうしてですか」也可以。",
      "examples": [
        {
          "id": "L09-S16",
          "ruby": [{ "b": "どうして " }, { "b": "朝", "r": "あさ" }, { "b": " " }, { "b": "新聞", "r": "しんぶん" }, { "b": "を " }, { "b": "読", "r": "よ" }, { "b": "みませんか。" }],
          "translation": "為什麼早上不看報紙呢？"
        },
        {
          "id": "L09-S17",
          "ruby": [{ "b": "…" }, { "b": "時間", "r": "じかん" }, { "b": "が ありませんから。" }],
          "translation": "…因為沒有時間。"
        },
        {
          "id": "L09-S18",
          "ruby": [{ "b": "きょうは " }, { "b": "早", "r": "はや" }, { "b": "く " }, { "b": "帰", "r": "かえ" }, { "b": "ります。" }],
          "translation": "今天要早點回去。"
        },
        {
          "id": "L09-S19",
          "ruby": [{ "b": "…どうしてですか。" }],
          "translation": "…為什麼？"
        },
        {
          "id": "L09-S20",
          "ruby": [{ "b": "子", "r": "こ" }, { "b": "どもの " }, { "b": "誕生日", "r": "たんじょうび" }, { "b": "ですから。" }],
          "translation": "因為今天是孩子的生日。"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L09-D01",
      "ruby": [{ "b": "もしもし、ミラーです。" }],
      "translation": "喂,我是米勒。",
      "speaker": "ミラー"
    },
    {
      "id": "L09-D02",
      "ruby": [{ "b": "ああ、ミラーさん、こんばんは。お" }, { "b": "元気", "r": "げんき" }, { "b": "ですか。" }],
      "translation": "啊,米勒先生,晚安。你好嗎？",
      "speaker": "木村"
    },
    {
      "id": "L09-D03",
      "ruby": [{ "b": "ええ、" }, { "b": "元気", "r": "げんき" }, { "b": "です。あのう、" }, { "b": "木村", "r": "きむら" }, { "b": "さん、" }, { "b": "小沢征爾", "r": "おざわせいじ" }, { "b": "の コンサート、いっしょに いかがですか。" }],
      "translation": "嗯,我很好。對了,木村小姐,小澤征爾的音樂會,要不要一起去呢？",
      "speaker": "ミラー"
    },
    {
      "id": "L09-D04",
      "ruby": [{ "b": "いいですね。いつですか。" }],
      "translation": "好啊。是什麼時候呢？",
      "speaker": "木村"
    },
    {
      "id": "L09-D05",
      "ruby": [{ "b": "来週", "r": "らいしゅう" }, { "b": "の " }, { "b": "金曜日", "r": "きんようび" }, { "b": "の " }, { "b": "晩", "r": "ばん" }, { "b": "です。" }],
      "translation": "下週五的晚上。",
      "speaker": "ミラー"
    },
    {
      "id": "L09-D06",
      "ruby": [{ "b": "金曜日", "r": "きんようび" }, { "b": "ですか。" }, { "b": "金曜日", "r": "きんようび" }, { "b": "の " }, { "b": "晩", "r": "ばん" }, { "b": "は ちょっと……。" }],
