  "grammar": [
    {
      "id": "L38-G01",
      "pattern": "動詞普通形 + の",
      "explanation": "動詞普通形後加上助詞「の」,這個句子就可以名詞化。",
      "examples": [
        {
          "id": "L38-S01",
          "ruby": [
            { "b": "絵", "r": "え" },
            { "b": "を かくのは " },
            { "b": "楽", "r": "たの" },
            { "b": "しいです。" }
          ],
          "translation": "畫畫很有趣。"
        }
      ]
    },
    {
      "id": "L38-G02",
      "pattern": "動詞字典形 のは 形容詞 です",
      "explanation": "①只是就運動項目的「網球」進行敘述;②是對「打網球」;③是對「看網球」做了更具體的說明。在這個句型中常用的形容詞有「むずかしい」「やさしい」「おもしろい」「たのしい」「きけん［な］」「たいへん［な］」等。",
      "examples": [
        {
          "id": "L38-S02",
          "ruby": [{ "b": "テニスは おもしろいです。" }],
          "translation": "網球很有趣。"
        },
        {
          "id": "L38-S03",
          "ruby": [{ "b": "テニスを するのは おもしろいです。" }],
          "translation": "打網球很有趣。"
        },
        {
          "id": "L38-S04",
          "ruby": [
            { "b": "テニスを " },
            { "b": "見", "r": "み" },
            { "b": "るのは おもしろいです。" }
          ],
          "translation": "看網球很有趣。"
        }
      ]
    },
    {
      "id": "L38-G03",
      "pattern": "動詞字典形 のが 形容詞 です",
      "explanation": "這個句型中應使用表示嗜好、技能、能力的形容詞,例如:「すき［な］」「きらい［な］」「じょうず［な］」「へた［な］」「はやい」「おそい」等。",
      "examples": [
        {
          "id": "L38-S05",
          "ruby": [
            { "b": "わたしは " },
            { "b": "花", "r": "はな" },
            { "b": "が " },
            { "b": "好", "r": "す" },
            { "b": "きです。" }
          ],
          "translation": "我喜歡花。"
        },
        {
          "id": "L38-S06",
          "ruby": [
            { "b": "わたしは " },
            { "b": "花", "r": "はな" },
            { "b": "を " },
            { "b": "育", "r": "そだ" },
            { "b": "てるのが " },
            { "b": "好", "r": "す" },
            { "b": "きです。" }
          ],
          "translation": "我喜歡種花。"
        },
        {
          "id": "L38-S07",
          "ruby": [
            { "b": "東京", "r": "とうきょう" },
            { "b": "の " },
            { "b": "人", "r": "ひと" },
            { "b": "は " },
            { "b": "歩", "r": "ある" },
            { "b": "くのが " },
            { "b": "速", "r": "はや" },
            { "b": "いです。" }
          ],
          "translation": "東京人走路很快。"
        }
      ]
    },
    {
      "id": "L38-G04",
      "pattern": "動詞字典形 のを 忘れました",
      "explanation": "例句⑧表示「預定好要買牛奶卻忘了」;例句⑨則是「應該關上車窗的,結果沒關窗就下車了」的意思。",
      "examples": [
        {
          "id": "L38-S08",
          "ruby": [
            { "b": "かぎを " },
            { "b": "忘", "r": "わす" },
            { "b": "れました。" }
          ],
          "translation": "忘了鑰匙了。"
        },
        {
          "id": "L38-S09",
          "ruby": [
            { "b": "牛乳", "r": "ぎゅうにゅう" },
            { "b": "を " },
            { "b": "買", "r": "か" },
            { "b": "うのを " },
            { "b": "忘", "r": "わす" },
            { "b": "れました。" }
          ],
          "translation": "忘了買牛奶了。"
        },
        {
          "id": "L38-S10",
          "ruby": [
            { "b": "車", "r": "くるま" },
            { "b": "の " },
            { "b": "窓", "r": "まど" },
            { "b": "を " },
            { "b": "閉", "r": "し" },
            { "b": "めるのを " },
            { "b": "忘", "r": "わす" },
            { "b": "れました。" }
          ],
          "translation": "忘了關車窗了。"
        }
      ]
    },
    {
      "id": "L38-G05",
      "pattern": "動詞普通形 のを 知って いますか",
      "explanation": "這是詢問對方是否知道「の」前面敘述的事情。〔註〕「しりません」和「しりませんでした」的區別:例句⑪中,聽話人被問之前並不知道「生了孩子」,因為被問才知道的,所以回答「しりませんでした」。而例句⑫中無論是被問前還是被問後都不知道,所以回答「しりません」。",
      "examples": [
        {
          "id": "L38-S11",
          "ruby": [
            { "b": "鈴木", "r": "すずき" },
            { "b": "さんが " },
            { "b": "来月", "r": "らいげつ" },
            { "b": "結婚", "r": "けっこん" },
            { "b": "するのを " },
            { "b": "知", "r": "し" },
            { "b": "って いますか。" }
          ],
          "translation": "你知道鈴木下個月要結婚嗎？"
        },
        {
          "id": "L38-S12",
          "ruby": [
            { "b": "木村", "r": "きむら" },
            { "b": "さんに " },
            { "b": "赤", "r": "あか" },
            { "b": "ちゃんが " },
            { "b": "生", "r": "う" },
            { "b": "まれたのを " },
            { "b": "知", "r": "し" },
            { "b": "って いますか。" }
          ],
          "translation": "你知道木村小姐生小孩了嗎？"
        },
        {
          "id": "L38-S13",
          "ruby": [
            { "b": "…いいえ、" },
            { "b": "知", "r": "し" },
            { "b": "りませんでした。" }
          ],
          "translation": "…不,不知道。"
        },
        {
          "id": "L38-S14",
          "ruby": [
            { "b": "ミラーさんの " },
            { "b": "住所", "r": "じゅうしょ" },
            { "b": "を " },
            { "b": "知", "r": "し" },
            { "b": "って いますか。" }
          ],
          "translation": "你知道米勒先生的地址嗎？"
        },
        {
          "id": "L38-S15",
          "ruby": [
            { "b": "…いいえ、" },
            { "b": "知", "r": "し" },
            { "b": "りません。" }
          ],
          "translation": "…不,不知道。"
        }
      ]
    },
    {
      "id": "L38-G06",
      "pattern": "動詞／い形容詞／な形容詞／名詞 普通形 のは 名詞 です",
      "explanation": "這個句型用於「の」代替表示物、人、場所等的名詞,並作為話題提出時。例如例句⑬是「女兒出生的地點」;例句⑭是將「一年裡最忙的時候」作為話題提出,與其相關的訊息用「は〜」表示。な形容詞與名詞的普通形「〜だ」接「の」時變為「〜な」。",
      "examples": [
        {
          "id": "L38-S16",
          "ruby": [
            { "b": "娘", "r": "むすめ" },
            { "b": "は " },
            { "b": "北海道", "r": "ほっかいどう" },
            { "b": "の " },
            { "b": "小", "r": "ちい" },
            { "b": "さな " },
            { "b": "町", "r": "まち" },
            { "b": "で " },
            { "b": "生", "r": "う" },
            { "b": "まれました。" }
          ],
          "translation": "女兒在北海道一個很小的城鎮出生的。"
        },
        {
          "id": "L38-S17",
          "ruby": [
            { "b": "娘", "r": "むすめ" },
            { "b": "が " },
            { "b": "生", "r": "う" },
            { "b": "まれたのは " },
            { "b": "北海道", "r": "ほっかいどう" },
            { "b": "の " },
            { "b": "小", "r": "ちい" },
            { "b": "さな " },
            { "b": "町", "r": "まち" },
            { "b": "です。" }
          ],
          "translation": "女兒出生在北海道一個很小的城鎮。"
        },
