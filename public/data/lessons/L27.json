  "grammar": [
    {
      "id": "L27-G01",
      "pattern": "可能動詞",
      "explanation": "可能動詞的變換方法（參考本冊12頁第27課練習A1）。Ⅰ類:かきます→かけます／かける、かいます→かえます／かえる;Ⅱ類:たべます→たべられます／たべられる;Ⅲ類:きます→こられます／こられる、します→できます／できる。可能動詞的變化是以第二類動詞的形式,變換成字典形、ない形、て形等。例:かける、かけ（ない）、かけて。「わかる」本身就表示可能的意思,所以不說「わかれる」。",
      "examples": [
        {
          "id": "L27-S01",
          "ruby": [{ "b": "かける、かけ（ない）、かけて" }],
          "translation": "（會寫、寫不了、寫著）"
        }
      ]
    },
    {
      "id": "L27-G02",
      "pattern": "可能動詞句",
      "explanation": "可能動詞不是表示動作而是表示狀態。他動詞的受詞可以用助詞「を」表示,但是可能動詞句中,對象一般用「が」表示。「を」以外的助詞不變化。可能動詞裡包含著人擁有的行為能力(⑤),和某種狀態下行為的可能性(⑥)這二個意思。",
      "examples": [
        {
          "id": "L27-S02",
          "ruby": [
            { "b": "わたしは " },
            { "b": "日本語", "r": "にほんご" },
            { "b": "を " },
            { "b": "話", "r": "はな" },
            { "b": "します。" }
          ],
          "translation": "我說日語。"
        },
        {
          "id": "L27-S03",
          "ruby": [
            { "b": "わたしは " },
            { "b": "日本語", "r": "にほんご" },
            { "b": "が " },
            { "b": "話", "r": "はな" },
            { "b": "せます。" }
          ],
          "translation": "我會說日語。"
        },
        {
          "id": "L27-S04",
          "ruby": [
            { "b": "一人", "r": "ひとり" },
            { "b": "で " },
            { "b": "病院", "r": "びょういん" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "けますか。" }
          ],
          "translation": "一個人能去醫院嗎？"
        },
        {
          "id": "L27-S05",
          "ruby": [
            { "b": "田中", "r": "たなか" },
            { "b": "さんに " },
            { "b": "会", "r": "あ" },
            { "b": "えませんでした。" }
          ],
          "translation": "沒能見到田中先生。"
        },
        {
          "id": "L27-S06",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "漢字", "r": "かんじ" },
            { "b": "が " },
            { "b": "読", "r": "よ" },
            { "b": "めます。" }
          ],
          "translation": "米勒先生會讀漢字。"
        },
        {
          "id": "L27-S07",
          "ruby": [
            { "b": "この " },
            { "b": "銀行", "r": "ぎんこう" },
            { "b": "で ドルが " },
            { "b": "換", "r": "か" },
            { "b": "えられます。" }
          ],
          "translation": "這家銀行可以兌換美元。"
        }
      ]
    },
    {
      "id": "L27-G03",
      "pattern": "「見えます」和「聞こえます」",
      "explanation": "「みます」「ききます」的可能形是「みられます」「きけます」。這表示主體看和聽的意志得以實現。相對於此,「みえます」「きこえます」則與本人的意志無關,只表示某一對象物能在視野裡捕捉到,或者某種聲響或聲音傳到耳朵裡。用「みえます」「きこえます」的句子,對象物是主語,用助詞「が」表示。",
      "examples": [
        {
          "id": "L27-S08",
          "ruby": [
            { "b": "新宿", "r": "しんじゅく" },
            { "b": "で " },
            { "b": "今", "r": "いま" },
            { "b": " " },
            { "b": "黒沢", "r": "くろさわ" },
            { "b": "の " },
            { "b": "映画", "r": "えいが" },
            { "b": "が " },
            { "b": "見", "r": "み" },
            { "b": "られます。" }
          ],
          "translation": "在新宿現在可以看黑澤明導演的電影。"
        },
        {
          "id": "L27-S09",
          "ruby": [
            { "b": "新幹線", "r": "しんかんせん" },
            { "b": "から " },
            { "b": "富士山", "r": "ふじさん" },
            { "b": "が " },
            { "b": "見", "r": "み" },
            { "b": "えます。" }
          ],
          "translation": "從新幹線看得到富士山。"
        },
        {
          "id": "L27-S10",
          "ruby": [
            { "b": "電話", "r": "でんわ" },
            { "b": "で " },
            { "b": "天気予報", "r": "てんきよほう" },
            { "b": "が " },
            { "b": "聞", "r": "き" },
            { "b": "けます。" }
          ],
          "translation": "用電話可以聽天氣預報。"
        },
        {
          "id": "L27-S11",
          "ruby": [
            { "b": "ラジオの " },
            { "b": "音", "r": "おと" },
            { "b": "が " },
            { "b": "聞", "r": "き" },
            { "b": "こえます。" }
          ],
          "translation": "聽得到收音機的聲音。"
        }
      ]
    },
    {
      "id": "L27-G04",
      "pattern": "できます",
      "explanation": "這裡學習的動詞「できます」,表示產生、完成、做完、能做等意思。",
      "examples": [
        {
          "id": "L27-S12",
          "ruby": [
            { "b": "駅", "r": "えき" },
            { "b": "の " },
            { "b": "前", "r": "まえ" },
            { "b": "に " },
            { "b": "大", "r": "おお" },
            { "b": "きい スーパーが できました。" }
          ],
          "translation": "車站前完成了一座大型超市。"
        },
        {
          "id": "L27-S13",
          "ruby": [
            { "b": "時計", "r": "とけい" },
            { "b": "の " },
            { "b": "修理", "r": "しゅうり" },
            { "b": "は いつ できますか。" }
          ],
          "translation": "錶的修理什麼時候能完成呢？"
        }
      ]
    },
    {
      "id": "L27-G05",
      "pattern": "は",
      "explanation": "1）では／には／へは／からは／までは等:「は」用於把名詞提示為主題時,正如第10、17、26課中所學,將助詞「が」「を」前的名詞提示為主題時,「は」將取代「が」「を」。後續的是其他的助詞（例如:で﹑に﹑へ等）時,「は」則放在其後來提示。2）「は」有對比的功能。",
      "examples": [
        {
          "id": "L27-S14",
          "ruby": [
            { "b": "わたしの " },
            { "b": "学校", "r": "がっこう" },
            { "b": "には アメリカ " },
            { "b": "人", "r": "じん" },
            { "b": "の " },
            { "b": "先生", "r": "せんせい" },
            { "b": "が います。" }
          ],
          "translation": "我的學校裡有美籍老師。"
        },
        {
          "id": "L27-S15",
          "ruby": [
            { "b": "わたしの " },
            { "b": "学校", "r": "がっこう" },
            { "b": "では " },
            { "b": "中国語", "r": "ちゅうごくご" },
            { "b": "が " },
            { "b": "習", "r": "なら" },
            { "b": "えます。" }
          ],
          "translation": "我的學校裡可以學中文。"
        },
        {
          "id": "L27-S16",
          "ruby": [
            { "b": "きのうは " },
            { "b": "山", "r": "やま" },
            { "b": "が " },
            { "b": "見", "r": "み" },
            { "b": "えましたが、きょうは " },
            { "b": "見", "r": "み" },
            { "b": "えません。" }
          ],
          "translation": "昨天看到了山,今天看不到。"
        },
        {
          "id": "L27-S17",
          "ruby": [
            { "b": "ワインは " },
            { "b": "飲", "r": "の" },
            { "b": "みますが、ビールは " },
            { "b": "飲", "r": "の" },
            { "b": "みません。" }
          ],
          "translation": "我喝葡萄酒,但不喝啤酒。"
        },
        {
          "id": "L27-S18",
          "ruby": [
            { "b": "京都", "r": "きょうと" },
            { "b": "へは " },
            { "b": "行", "r": "い" },
            { "b": "きますが、 " },
            { "b": "大阪", "r": "おおさか" },
            { "b": "へは " },
            { "b": "行", "r": "い" },
