        }
      ]
    },
    {
      "id": "L27-G06",
      "pattern": "も",
      "explanation": "和「は」相同,助詞「も」和其他的助詞一起使用時,雖然可以取代「を」、「が」,但要放在其他助詞之後。助詞是「へ」時可以省略。",
      "examples": [
        {
          "id": "L27-S19",
          "ruby": [
            { "b": "クララさんは " },
            { "b": "英語", "r": "えいご" },
            { "b": "が " },
            { "b": "話", "r": "はな" },
            { "b": "せます。 フランス " },
            { "b": "語", "r": "ご" },
            { "b": "も " },
            { "b": "話", "r": "はな" },
            { "b": "せます。" }
          ],
          "translation": "克拉拉既會說英語,也會說法語。"
        },
        {
          "id": "L27-S20",
          "ruby": [
            { "b": "去年", "r": "きょねん" },
            { "b": " アメリカへ " },
            { "b": "行", "r": "い" },
            { "b": "きました。 メキシコ［へ］も " },
            { "b": "行", "r": "い" },
            { "b": "きました。" }
          ],
          "translation": "去年我去了美國,也去了墨西哥。"
        },
        {
          "id": "L27-S21",
          "ruby": [
            { "b": "わたしの " },
            { "b": "部屋", "r": "へや" },
            { "b": "から " },
            { "b": "海", "r": "うみ" },
            { "b": "が " },
            { "b": "見", "r": "み" },
            { "b": "えます。 " },
            { "b": "弟", "r": "おとうと" },
            { "b": "の " },
            { "b": "部屋", "r": "へや" },
            { "b": "からも " },
            { "b": "見", "r": "み" },
            { "b": "えます。" }
          ],
          "translation": "從我的房間可以看到海,從弟弟的房間也看得到。"
        }
      ]
    },
    {
      "id": "L27-G07",
      "pattern": "しか",
      "explanation": "「しか」接續名詞、數量詞之後,常和表示否定的詞一起使用,表示只強調和限定一項,此外都是否定的意思。可以取代「が」「を」,但要接在其他助詞之後。相對於「だけ」用於表示肯定的語感,「しか」則用於否定的語感。",
      "examples": [
        {
          "id": "L27-S22",
          "ruby": [
            { "b": "ローマ " },
            { "b": "字", "r": "じ" },
            { "b": "しか " },
            { "b": "書", "r": "か" },
            { "b": "けません。" }
          ],
          "translation": "只會寫羅馬拚音。"
        },
        {
          "id": "L27-S23",
          "ruby": [
            { "b": "ローマ " },
            { "b": "字", "r": "じ" },
            { "b": "だけ " },
            { "b": "書", "r": "か" },
            { "b": "けます。" }
          ],
          "translation": "只會寫羅馬拚音。"
        }
      ]
    }
  ],
