  "grammar": [
    {
      "id": "L41-G01",
      "pattern": "授受表達方式",
      "explanation": "第7課和第24課學習了物及行為的授受表達，這一課將進一步學習反映給予者和接受者關係的授受表達方式。名詞1に 名詞2を やります:當物的接受者是比自己地位低的人或動植物時，通常用「やります」。但是最近在對人時多用「あげます」。要對接受者表示敬意時，用「さしあげます」。名詞1に 名詞2を いただきます:從地位高的人那裡得到東西時，不用「もらいます」，而用「いただきます」。［わたしに］名詞を くださいます:當地位高的人給自己東西時，不用「くれます」，應使用「くださいます」;「くださいます」在接受者是說話人的家人時也能用。",
      "examples": [
        {
          "id": "L41-S01",
          "ruby": [
            { "b": "わたしは " },
            { "b": "息子", "r": "むすこ" },
            { "b": "に お" },
            { "b": "菓子", "r": "かし" },
            { "b": "を やりました（あげました）。" }
          ],
          "translation": "我給了兒子點心。"
        },
        {
          "id": "L41-S02",
          "ruby": [
            { "b": "わたしは " },
            { "b": "犬", "r": "いぬ" },
            { "b": "に えさを やりました。" }
          ],
          "translation": "我餵了狗。"
        },
        {
          "id": "L41-S03",
          "ruby": [
            { "b": "わたしは " },
            { "b": "部長", "r": "ぶちょう" },
            { "b": "に お" },
            { "b": "土産", "r": "みやげ" },
            { "b": "を いただきました。" }
          ],
          "translation": "經理送給我紀念品。"
        },
        {
          "id": "L41-S04",
          "ruby": [
            { "b": "部長", "r": "ぶちょう" },
            { "b": "が わたしに お" },
            { "b": "土産", "r": "みやげ" },
            { "b": "を くださいました。" }
          ],
          "translation": "經理送給我紀念品。"
        },
        {
          "id": "L41-S05",
          "ruby": [
            { "b": "部長", "r": "ぶちょう" },
            { "b": "が " },
            { "b": "娘", "r": "むすめ" },
            { "b": "に お" },
            { "b": "土産", "r": "みやげ" },
            { "b": "を くださいました。" }
          ],
          "translation": "經理送了我女兒紀念品。"
        }
      ]
    },
    {
      "id": "L41-G02",
      "pattern": "行為的授受",
      "explanation": "在表達行為的授受時，要用「やります」「いただきます」「くださいます」。動詞て形 やります;動詞て形 いただきます;動詞て形 くださいます。〔註〕與第24課學的「〜て あげます」一樣，用「〜て あげます／さしあげます」，也會給人以尊大的印象，所以在對上司、長輩當面說話時最好不用這種說法。",
      "examples": [
        {
          "id": "L41-S06",
          "ruby": [
            { "b": "わたしは " },
            { "b": "息子", "r": "むすこ" },
            { "b": "に " },
            { "b": "紙飛行機", "r": "かみひこうき" },
            { "b": "を " },
            { "b": "作", "r": "つく" },
            { "b": "って やりました（あげました）。" }
          ],
          "translation": "我替兒子折了架紙飛機。"
        },
        {
          "id": "L41-S07",
          "ruby": [
            { "b": "わたしは " },
            { "b": "犬", "r": "いぬ" },
            { "b": "を " },
            { "b": "散歩", "r": "さんぽ" },
            { "b": "に " },
            { "b": "連", "r": "つ" },
            { "b": "れて " },
            { "b": "行", "r": "い" },
            { "b": "って やりました。" }
          ],
          "translation": "我帶狗散了步。"
        },
        {
          "id": "L41-S08",
          "ruby": [
            { "b": "わたしは " },
            { "b": "娘", "r": "むすめ" },
            { "b": "の " },
            { "b": "宿題", "r": "しゅくだい" },
            { "b": "を " },
            { "b": "見", "r": "み" },
            { "b": "て やりました（あげました）。" }
          ],
          "translation": "我幫女兒看了她的作業。"
        },
        {
          "id": "L41-S09",
          "ruby": [
            { "b": "わたしは " },
