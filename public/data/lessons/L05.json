  "grammar": [
    {
      "id": "L05-G01",
      "pattern": "名詞（場所）へ 行きます／来ます／帰ります",
      "explanation": "使用移動動詞時,移動的方向用助詞「へ」表示。〔註〕助詞「へ」讀作「え」。",
      "examples": [
        {
          "id": "L05-S01",
          "ruby": [
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "我要去京都。"
        },
        {
          "id": "L05-S02",
          "ruby": [
            { "b": "日本", "r": "にほん" },
            { "b": "へ " },
            { "b": "来", "r": "き" },
            { "b": "ました。" }
          ],
          "translation": "我來到了日本。"
        },
        {
          "id": "L05-S03",
          "ruby": [
            { "b": "うちへ " },
            { "b": "帰", "r": "かえ" },
            { "b": "ります。" }
          ],
          "translation": "我要回家。"
        }
      ]
    },
    {
      "id": "L05-G02",
      "pattern": "どこ〔へ〕も 行きません／行きませんでした",
      "explanation": "完全否定疑問詞所問的全部範疇時,用助詞「も」。與否定形一起使用。",
      "examples": [
        {
          "id": "L05-S04",
          "ruby": [
            { "b": "どこ〔へ〕も " },
            { "b": "行", "r": "い" },
            { "b": "きません。" }
          ],
          "translation": "哪裡也不去。"
        },
        {
          "id": "L05-S05",
          "ruby": [
            { "b": "何", "r": "なに" },
            { "b": "も " },
            { "b": "食", "r": "た" },
            { "b": "べません。" }
          ],
          "translation": "什麼也不吃。（第 6 課）"
        },
        {
          "id": "L05-S06",
          "ruby": [{ "b": "だれも いません。" }],
          "translation": "沒有任何人在。（第 10 課）"
        }
      ]
    },
    {
      "id": "L05-G03",
      "pattern": "名詞（交通工具）で 行きます／来ます／帰ります",
      "explanation": "助詞「で」表示手段、方法。接表示交通工具的名詞後,與移動動詞（いきます、きます、かえります 等）一起使用,表示交通工具。走路時,用「あるいて」表示,不用助詞「で」。",
      "examples": [
        {
          "id": "L05-S07",
          "ruby": [
            { "b": "電車", "r": "でんしゃ" },
            { "b": "で " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "坐電車去。"
        },
        {
          "id": "L05-S08",
          "ruby": [
            { "b": "タクシーで " },
            { "b": "来", "r": "き" },
            { "b": "ました。" }
          ],
          "translation": "坐計程車來的。"
        },
        {
          "id": "L05-S09",
          "ruby": [
            { "b": "駅", "r": "えき" },
            { "b": "から " },
            { "b": "歩", "r": "ある" },
            { "b": "いて " },
            { "b": "帰", "r": "かえ" },
            { "b": "りました。" }
          ],
          "translation": "我從車站走回來的。"
        }
      ]
    },
    {
      "id": "L05-G04",
      "pattern": "名詞（人／動物）と 動詞",
      "explanation": "用助詞「と」表示一起做某個動作的人（動物）。單獨行動時,用「ひとりで」表示。這時,不用助詞「と」。",
      "examples": [
        {
          "id": "L05-S10",
          "ruby": [
            { "b": "家族", "r": "かぞく" },
            { "b": "と " },
            { "b": "日本", "r": "にほん" },
            { "b": "へ " },
            { "b": "来", "r": "き" },
            { "b": "ました。" }
          ],
          "translation": "我和家人來到了日本。"
        },
        {
          "id": "L05-S11",
          "ruby": [
            { "b": "一人", "r": "ひとり" },
            { "b": "で " },
            { "b": "東京", "r": "とうきょう" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "一個人去東京。"
        }
      ]
    },
    {
      "id": "L05-G05",
      "pattern": "いつ",
      "explanation": "詢問時間時,除了使用「なんじ」「なんようび」「なんがつなんにち」等量詞前面加「なん」的疑問詞以外,還可以用疑問詞「いつ」。「いつ」後不能加助詞「に」。",
      "examples": [
        {
          "id": "L05-S12",
          "ruby": [
            { "b": "いつ " },
            { "b": "日本", "r": "にほん" },
            { "b": "へ " },
            { "b": "来", "r": "き" },
            { "b": "ましたか。" }
          ],
          "translation": "什麼時候來到日本的？"
        },
        {
          "id": "L05-S13",
          "ruby": [
            { "b": "…3" },
            { "b": "月", "r": "がつ" },
            { "b": "25" },
            { "b": "日", "r": "にち" },
            { "b": "に " },
            { "b": "来", "r": "き" },
            { "b": "ました。" }
          ],
          "translation": "…3 月 25 日來的。"
        },
        {
          "id": "L05-S14",
          "ruby": [
            { "b": "いつ " },
            { "b": "広島", "r": "ひろしま" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きますか。" }
          ],
          "translation": "什麼時候要去廣島？"
        },
        {
          "id": "L05-S15",
          "ruby": [
            { "b": "…" },
            { "b": "来週", "r": "らいしゅう" },
            { "b": " " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "…下星期要去。"
        }
      ]
    },
    {
      "id": "L05-G06",
      "pattern": "句子 よ",
      "explanation": "「よ」用於句尾,使用在告知對方不知道的事情,或以強烈語氣告訴對方自己的判斷和意見時。",
      "examples": [
        {
          "id": "L05-S16",
          "ruby": [
            { "b": "この " },
            { "b": "電車", "r": "でんしゃ" },
            { "b": "は " },
            { "b": "甲子園", "r": "こうしえん" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きますか。" }
          ],
          "translation": "這班電車去甲子園嗎？"
        },
        {
          "id": "L05-S17",
          "ruby": [
            { "b": "…いいえ、 " },
            { "b": "行", "r": "い" },
            { "b": "きません。 " },
            { "b": "次", "r": "つぎ" },
            { "b": "の " },
            { "b": "普通", "r": "ふつう" },
            { "b": "ですよ。" }
          ],
          "translation": "…不去。下一班普通車去。"
        },
        {
          "id": "L05-S18",
          "ruby": [
            { "b": "無理", "r": "むり" },
            { "b": "な ダイエットは " },
            { "b": "体", "r": "からだ" },
            { "b": "に よくないですよ。" }
          ],
          "translation": "過度的減肥對身體並不好哦！（第 19 課）"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L05-D01",
      "ruby": [
        { "b": "すみません。" },
        { "b": "甲子園", "r": "こうしえん" },
        { "b": "まで いくらですか。" }
      ],
      "translation": "不好意思,到甲子園多少錢？",
      "speaker": "サントス"
