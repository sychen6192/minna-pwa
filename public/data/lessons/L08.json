  "grammar": [
    {
      "id": "L08-G01",
      "pattern": "形容詞",
      "explanation": "形容詞有 1) 成為受詞,和 2) 修飾名詞二種用法。可以活用,根據活用的方式,分為「い 形容詞」和「な 形容詞」。",
      "examples": [
        {
          "id": "L08-S01",
          "ruby": [
            { "b": "ワット " },
            { "b": "先生", "r": "せんせい" },
            { "b": "は " },
            { "b": "親切", "r": "しんせつ" },
            { "b": "です。" }
          ],
          "translation": "瓦特老師很親切。"
        }
      ]
    },
    {
      "id": "L08-G02",
      "pattern": "名詞は な形容詞〔／な〕です／名詞は い形容詞(〜い)です",
      "explanation": "1) 形容詞句句尾的「です」表示對聽話人禮貌的態度。な 形容詞去掉「な」,い 形容詞用原形(〜い)與「です」接續。「です」是非過去式肯定句的句尾形式。2) な 形容詞「な〔/〕です」的否定形,是「な形容詞〔な〕じゃ ありません(な形容詞〔な〕では ありません)」。3) い 形容詞(〜い)です 的否定形,是去掉最後的「い」加上「くないです」。「いいです」的否定形是「よくないです」。4) 形容詞句的疑問句形式,也和名詞句動詞句相同。回答時要重複疑問句中的形容詞。不能用「そうです」「そうじゃ ありません」來回答。",
      "examples": [
        {
          "id": "L08-S02",
          "ruby": [
            { "b": "ワット " },
            { "b": "先生", "r": "せんせい" },
            { "b": "は " },
            { "b": "親切", "r": "しんせつ" },
            { "b": "です。" }
          ],
          "translation": "瓦特老師很親切。"
        },
        {
          "id": "L08-S03",
          "ruby": [
            { "b": "富士山", "r": "ふじさん" },
            { "b": "は " },
            { "b": "高", "r": "たか" },
            { "b": "いです。" }
          ],
          "translation": "富士山很高。"
        },
        {
          "id": "L08-S04",
          "ruby": [
            { "b": "あそこは " },
            { "b": "静", "r": "しず" },
            { "b": "かじゃ ありません。" }
          ],
          "translation": "那裡不安靜。"
        },
        {
          "id": "L08-S05",
          "ruby": [
            { "b": "この " },
            { "b": "本", "r": "ほん" },
            { "b": "は おもしろくないです。" }
          ],
          "translation": "這本書沒意思。"
        },
        {
          "id": "L08-S06",
          "ruby": [
            { "b": "ペキンは " },
            { "b": "寒", "r": "さむ" },
            { "b": "いですか。" }
          ],
          "translation": "北京冷嗎？"
        },
        {
          "id": "L08-S07",
          "ruby": [
            { "b": "…はい、" },
            { "b": "寒", "r": "さむ" },
            { "b": "いです。" }
          ],
          "translation": "…是的,很冷。"
        },
        {
          "id": "L08-S08",
          "ruby": [
            { "b": "琵琶湖", "r": "びわこ" },
            { "b": "の " },
            { "b": "水", "r": "みず" },
            { "b": "は きれいですか。" }
          ],
          "translation": "琵琶湖的湖水很乾淨嗎？"
        },
        {
          "id": "L08-S09",
          "ruby": [{ "b": "…いいえ、きれいじゃ ありません。" }],
          "translation": "…不,不乾淨。"
        }
      ]
    },
    {
      "id": "L08-G03",
      "pattern": "な形容詞 な 名詞／い形容詞(〜い) 名詞",
      "explanation": "形容詞放在名詞前面修飾名詞。な 形容詞以「な」的形式接續名詞。",
      "examples": [
        {
          "id": "L08-S10",
          "ruby": [
            { "b": "ワント " },
            { "b": "先生", "r": "せんせい" },
            { "b": "は " },
            { "b": "親切", "r": "しんせつ" },
            { "b": "な " },
            { "b": "先生", "r": "せんせい" },
            { "b": "です。" }
          ],
          "translation": "瓦特老師是親切的老師。"
        },
        {
          "id": "L08-S11",
          "ruby": [
            { "b": "富士山", "r": "ふじさん" },
            { "b": "は " },
            { "b": "高", "r": "たか" },
            { "b": "い " },
            { "b": "山", "r": "やま" },
            { "b": "です。" }
          ],
          "translation": "富士山是很高的山。"
        }
      ]
    },
    {
      "id": "L08-G04",
      "pattern": "とても／あまり",
      "explanation": "「とても」和「あまり」都是程度副詞,修飾形容詞時放在形容詞前面。「とても」是“很”的意思,用在肯定句中;「あまり」和否定形併用,表示“不太”的意思。",
      "examples": [
        {
          "id": "L08-S12",
          "ruby": [
            { "b": "ペキンは とても " },
            { "b": "寒", "r": "さむ" },
            { "b": "いです。" }
          ],
          "translation": "北京很冷。"
        },
        {
          "id": "L08-S13",
          "ruby": [
            { "b": "これは とても " },
            { "b": "有名", "r": "ゆうめい" },
            { "b": "な " },
            { "b": "映画", "r": "えいが" },
            { "b": "です。" }
          ],
          "translation": "這是很有名的電影。"
        },
        {
          "id": "L08-S14",
          "ruby": [
            { "b": "シャンハイは あまり " },
            { "b": "寒", "r": "さむ" },
            { "b": "くないです。" }
          ],
          "translation": "上海不太冷。"
        },
        {
          "id": "L08-S15",
          "ruby": [
            { "b": "さくら " },
            { "b": "大学", "r": "だいがく" },
            { "b": "は あまり " },
            { "b": "有名", "r": "ゆうめい" },
            { "b": "な " },
            { "b": "大学", "r": "だいがく" },
            { "b": "じゃ ありません。" }
          ],
          "translation": "櫻花大學不是很有名的大學。"
        }
      ]
    },
    {
      "id": "L08-G05",
      "pattern": "名詞は どうですか",
      "explanation": "這個疑問句,是詢問對方對經歷過的事情、到過的地方、見過的人有什麼印象、意見和感想的句子。",
      "examples": [
        {
          "id": "L08-S16",
          "ruby": [
            { "b": "日本", "r": "にほん" },
            { "b": "の " },
            { "b": "生活", "r": "せいかつ" },
            { "b": "は どうですか。" }
          ],
          "translation": "日本的生活怎麼樣？"
        },
        {
          "id": "L08-S17",
          "ruby": [
            { "b": "…" },
            { "b": "楽", "r": "たの" },
            { "b": "しいです。" }
          ],
          "translation": "…很愉快。"
        }
      ]
    },
    {
      "id": "L08-G06",
      "pattern": "名詞1は どんな 名詞2 ですか",
      "explanation": "要求就名詞1進行描寫和說明時用這個疑問句。名詞2是名詞1所屬的範疇。「どんな」應放在名詞前。",
      "examples": [
        {
          "id": "L08-S18",
          "ruby": [
            { "b": "奈良", "r": "なら" },
            { "b": "は どんな " },
            { "b": "町", "r": "まち" },
            { "b": "ですか。" }
          ],
          "translation": "奈良是什麼樣的城市？"
        },
        {
          "id": "L08-S19",
          "ruby": [
            { "b": "…" },
            { "b": "古", "r": "ふる" },
            { "b": "い " },
