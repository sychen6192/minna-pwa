  "grammar": [
    {
      "id": "L30-G01",
      "pattern": "動詞て形 あります",
      "explanation": "「動詞て形 あります」表示某人在某種意圖下所做行為的結果和發生的狀態,這裡用的動詞是他動詞並且是意志動詞。句型1)「名詞1に 名詞2が 動詞て形 あります」表示某人為了某目的所做行為的結果狀態;句型2)「名詞2は 名詞1に 動詞て形 あります」用於將名詞2提示為主題敘述時;此句型也可表示事情準備完畢的狀態,多和「もう」一起使用。與「動詞て形 います」的區別:後者多用自動詞,只敘述狀態;前者用他動詞,表示為某種意圖而由某人行為產生的結果。",
      "examples": [
        {
          "id": "L30-S01",
          "ruby": [
            { "b": "机", "r": "つくえ" },
            { "b": "の " },
            { "b": "上", "r": "うえ" },
            { "b": "に メモが " },
            { "b": "置", "r": "お" },
            { "b": "いて あります。" }
          ],
          "translation": "桌子上放著記錄。"
        },
        {
          "id": "L30-S02",
          "ruby": [
            { "b": "カレンダーに " },
            { "b": "今月", "r": "こんげつ" },
            { "b": "の " },
            { "b": "予定", "r": "よてい" },
            { "b": "が " },
            { "b": "書", "r": "か" },
            { "b": "いて あります。" }
          ],
          "translation": "月曆上寫著本月的計劃。"
        },
        {
          "id": "L30-S03",
          "ruby": [
            { "b": "メモは どこですか。" }
          ],
          "translation": "記錄在哪裡？"
        },
        {
          "id": "L30-S04",
          "ruby": [
            { "b": "…［メモは］ " },
            { "b": "机", "r": "つくえ" },
            { "b": "の" },
            { "b": "上", "r": "うえ" },
            { "b": "に " },
            { "b": "置", "r": "お" },
            { "b": "いて あります。" }
          ],
          "translation": "…〔記錄〕放在桌子上。"
        },
        {
          "id": "L30-S05",
          "ruby": [
            { "b": "今月", "r": "こんげつ" },
            { "b": "の " },
            { "b": "予定", "r": "よてい" },
            { "b": "は カレンダーに " },
            { "b": "書", "r": "か" },
            { "b": "いて あります。" }
          ],
          "translation": "本月的計劃寫在月曆上。"
        },
        {
          "id": "L30-S06",
          "ruby": [
            { "b": "誕生日", "r": "たんじょうび" },
            { "b": "の プレゼントは もう " },
            { "b": "買", "r": "か" },
            { "b": "って あります。" }
          ],
          "translation": "生日禮物已經買好了。"
        },
        {
          "id": "L30-S07",
          "ruby": [
            { "b": "ホテルは もう " },
            { "b": "予約", "r": "よやく" },
            { "b": "して あります。" }
          ],
          "translation": "飯店已經預定了。"
        },
        {
          "id": "L30-S08",
          "ruby": [
            { "b": "窓", "r": "まど" },
            { "b": "が " },
            { "b": "閉", "r": "し" },
            { "b": "まって います。" }
          ],
          "translation": "窗子關著。"
        },
        {
          "id": "L30-S09",
          "ruby": [
            { "b": "窓", "r": "まど" },
            { "b": "が " },
            { "b": "閉", "r": "し" },
            { "b": "めて あります。" }
          ],
          "translation": "窗子關上了。"
        }
      ]
    },
    {
      "id": "L30-G02",
      "pattern": "動詞て形 おきます",
      "explanation": "1)表示在某一時間之前結束必要的動作、行為的用法。2)表示為下次使用而完成必要的動作,或採取一時的措施。3)表示讓結果狀態持續下去。〔註〕在口語中常常把「〜て おきます」說成「〜ときます」。",
      "examples": [
        {
          "id": "L30-S10",
          "ruby": [
            { "b": "旅行", "r": "りょこう" },
            { "b": "の " },
            { "b": "前", "r": "まえ" },
            { "b": "に " },
            { "b": "切符", "r": "きっぷ" },
            { "b": "を " },
            { "b": "買", "r": "か" },
            { "b": "って おきます。" }
          ],
          "translation": "旅行前要買好票。"
        },
        {
          "id": "L30-S11",
          "ruby": [
            { "b": "次", "r": "つぎ" },
            { "b": "の " },
            { "b": "会議", "r": "かいぎ" },
            { "b": "までに " },
            { "b": "何", "r": "なに" },
            { "b": "を して おいたら いいですか。" }
          ],
          "translation": "下次會議以前應該怎麼做才好。"
        },
        {
          "id": "L30-S12",
          "ruby": [
            { "b": "…この " },
            { "b": "資料", "r": "しりょう" },
            { "b": "を " },
            { "b": "読", "r": "よ" },
            { "b": "んで おいて ください。" }
          ],
          "translation": "…請先閱讀好這分資料。"
        },
        {
          "id": "L30-S13",
          "ruby": [
            { "b": "はさみを " },
            { "b": "使", "r": "つか" },
            { "b": "ったら、" },
            { "b": "元", "r": "もと" },
            { "b": "の " },
            { "b": "所", "r": "ところ" },
            { "b": "に " },
            { "b": "戻", "r": "もど" },
            { "b": "して おいて ください。" }
          ],
          "translation": "用完剪刀之後,請放回原來的地方。"
        },
        {
          "id": "L30-S14",
          "ruby": [
            { "b": "あした " },
            { "b": "会議", "r": "かいぎ" },
            { "b": "が ありますから、いすは この ままに して おいて ください。" }
          ],
          "translation": "明天有會議,椅子請保持原狀。"
        },
        {
          "id": "L30-S15",
          "ruby": [
            { "b": "そこに " },
            { "b": "置", "r": "お" },
            { "b": "いといて (" },
            { "b": "置", "r": "お" },
            { "b": "いて おいて)ください。" }
          ],
          "translation": "請放在那裡。"
        }
      ]
    },
    {
      "id": "L30-G03",
      "pattern": "まだ 動詞（肯定形）",
      "explanation": "例句中的「まだ」表示動作、狀態仍然持續的意思。",
      "examples": [
        {
          "id": "L30-S16",
          "ruby": [
            { "b": "まだ " },
            { "b": "雨", "r": "あめ" },
            { "b": "が " },
            { "b": "降", "r": "ふ" },
            { "b": "って います。" }
          ],
          "translation": "雨還在下。"
        },
        {
