  "grammar": [
    {
      "id": "L06-G01",
      "pattern": "名詞 を 動詞（他動詞）",
      "explanation": "用助詞「を」表示他動詞的直接受詞。〔註〕「を」的發音和「お」相同。「を」只用在表示助詞時。",
      "examples": [
        {
          "id": "L06-S01",
          "ruby": [
            { "b": "ジュースを " },
            { "b": "飲", "r": "の" },
            { "b": "みます。" }
          ],
          "translation": "我喝果汁。"
        }
      ]
    },
    {
      "id": "L06-G02",
      "pattern": "名詞 を します",
      "explanation": "日語的動詞「します」,可以將極大範圍的名詞列為受詞。意思是實行該受詞表示的內容。下面舉幾個例子。1)運動、遊戲等;2)集會、活動等;3)其他。",
      "examples": [
        {
          "id": "L06-S02",
          "ruby": [
            { "b": "サッカーを します。" }
          ],
          "translation": "踢足球"
        },
        {
          "id": "L06-S03",
          "ruby": [
            { "b": "トランプを します。" }
          ],
          "translation": "玩撲克牌"
        },
        {
          "id": "L06-S04",
          "ruby": [
            { "b": "パーティーを します。" }
          ],
          "translation": "舉行派對"
        },
        {
          "id": "L06-S05",
          "ruby": [
            { "b": "会議", "r": "かいぎ" },
            { "b": "を します。" }
          ],
          "translation": "召開會議"
        },
        {
          "id": "L06-S06",
          "ruby": [
            { "b": "宿題", "r": "しゅくだい" },
            { "b": "を します。" }
          ],
          "translation": "做作業"
        },
        {
          "id": "L06-S07",
          "ruby": [
            { "b": "仕事", "r": "しごと" },
            { "b": "を します。" }
          ],
          "translation": "做工作"
        }
      ]
    },
    {
      "id": "L06-G03",
      "pattern": "何を しますか",
      "explanation": "這是詢問要做什麼的用法。〔註〕日期等表示時間的詞加上「は」可以提示主題。",
      "examples": [
        {
          "id": "L06-S08",
          "ruby": [
            { "b": "月曜日", "r": "げつようび" },
            { "b": " " },
            { "b": "何", "r": "なに" },
            { "b": "を しますか。" }
          ],
          "translation": "星期一要做什麼？"
        },
        {
          "id": "L06-S09",
          "ruby": [
            { "b": "…" },
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "…要去京都。"
        },
        {
          "id": "L06-S10",
          "ruby": [
            { "b": "きのう " },
            { "b": "何", "r": "なに" },
            { "b": "を しましたか。" }
          ],
          "translation": "昨天做了什麼？"
        },
        {
          "id": "L06-S11",
          "ruby": [
            { "b": "…サッカーを しました。" }
          ],
          "translation": "…踢了足球。"
        },
        {
          "id": "L06-S12",
          "ruby": [
            { "b": "月曜日", "r": "げつようび" },
            { "b": "は " },
            { "b": "何", "r": "なに" },
            { "b": "を しますか。" }
          ],
          "translation": "星期一要做什麼？"
        },
        {
          "id": "L06-S13",
          "ruby": [
            { "b": "…" },
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "…要去京都。"
        }
      ]
    },
    {
      "id": "L06-G04",
      "pattern": "なん 和 なに",
      "explanation": "「なん」和「なに」的意思都是“什麼”。1)「なん」用在以下情況中。(1)後續單字的第一個音是た行、だ行、な行時。(2)詢問帶量詞的數量時。2)上述1)以外的情況用「なに」。",
      "examples": [
        {
          "id": "L06-S14",
          "ruby": [
            { "b": "それは " },
            { "b": "何", "r": "なん" },
            { "b": "ですか。" }
          ],
          "translation": "那是什麼？"
        },
        {
          "id": "L06-S15",
          "ruby": [
            { "b": "何", "r": "なん" },
            { "b": "の " },
            { "b": "本", "r": "ほん" },
            { "b": "ですか。" }
          ],
          "translation": "是什麼書？"
        },
        {
          "id": "L06-S16",
          "ruby": [
            { "b": "寝", "r": "ね" },
            { "b": "る まえに、 " },
            { "b": "何", "r": "なん" },
            { "b": "と " },
            { "b": "言", "r": "い" },
            { "b": "いますか。" }
          ],
          "translation": "睡覺之前要說什麼？（第21課）"
        },
        {
          "id": "L06-S17",
          "ruby": [
            { "b": "テレサちゃんは " },
            { "b": "何歳", "r": "なんさい" },
            { "b": "ですか。" }
          ],
          "translation": "德勒莎幾歲了？"
        },
        {
          "id": "L06-S18",
          "ruby": [
            { "b": "何", "r": "なに" },
            { "b": "を " },
            { "b": "買", "r": "か" },
            { "b": "いますか。" }
          ],
          "translation": "要買什麼？"
        }
      ]
    },
    {
      "id": "L06-G05",
      "pattern": "名詞（場所）で 動詞",
      "explanation": "這裡要學的「で」,是接在表示場所的名詞後,表示動作發生的場所。",
      "examples": [
        {
          "id": "L06-S19",
          "ruby": [
            { "b": "駅", "r": "えき" },
            { "b": "で " },
            { "b": "新聞", "r": "しんぶん" },
            { "b": "を " },
            { "b": "買", "r": "か" },
            { "b": "います。" }
          ],
          "translation": "在車站買報紙。"
        }
      ]
    },
    {
      "id": "L06-G06",
      "pattern": "動詞 ませんか",
      "explanation": "這是邀請聽話人的表達方式。",
      "examples": [
        {
          "id": "L06-S20",
          "ruby": [
            { "b": "いっしょに " },
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きませんか。" }
          ],
          "translation": "一起去京都好嗎？"
        },
        {
          "id": "L06-S21",
          "ruby": [
            { "b": "…ええ、いいですね。" }
          ],
          "translation": "…好啊！"
        }
      ]
    },
    {
      "id": "L06-G07",
      "pattern": "動詞 ましょう",
      "explanation": "積極的提議、邀請。也用在積極地響應提議、邀請時。〔註〕「動詞ませんか」和「動詞ましょう」都是邀請對方的表達方式,但是「動詞ませんか」比「動詞ましょう」更尊重對方。",
      "examples": [
        {
          "id": "L06-S22",
          "ruby": [
            { "b": "ちょっと " },
            { "b": "休", "r": "やす" },
            { "b": "みましょう。" }
          ],
          "translation": "稍微休息一下吧。"
        },
        {
          "id": "L06-S23",
          "ruby": [
            { "b": "いっしょに " },
            { "b": "昼", "r": "ひる" },
            { "b": "ごはんを " },
