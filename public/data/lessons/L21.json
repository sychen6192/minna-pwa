  "grammar": [
    {
      "id": "L21-G01",
      "pattern": "普通形 と 思います",
      "explanation": "「おもいます」的內容附加助詞「と」來表示。表示推量時,推量否定的內容須將「と」前面的句子改成否定形。闡述意見時用「〜に ついて どう おもいますか」詢問,「どう」後面不需要用「と」。對他人的意見表示同意或不同意時亦以此句型表達。",
      "examples": [
        {
          "id": "L21-S01",
          "ruby": [
            { "b": "あした " },
            { "b": "雨", "r": "あめ" },
            { "b": "が " },
            { "b": "降", "r": "ふ" },
            { "b": "ると " },
            { "b": "思", "r": "おも" },
            { "b": "います。" }
          ],
          "translation": "我想明天會下雨。"
        },
        {
          "id": "L21-S02",
          "ruby": [
            { "b": "テレサちゃんは もう " },
            { "b": "寝", "r": "ね" },
            { "b": "たと " },
            { "b": "思", "r": "おも" },
            { "b": "います。" }
          ],
          "translation": "我想德勒莎已經睡了。"
        },
        {
          "id": "L21-S03",
          "ruby": [
            { "b": "ミラーさんは この ニュースを " },
            { "b": "知", "r": "し" },
            { "b": "って いますか。" }
          ],
          "translation": "米勒先生知道這個消息嗎？"
        },
        {
          "id": "L21-S04",
          "ruby": [
            { "b": "…いいえ、たぶん " },
            { "b": "知", "r": "し" },
            { "b": "らないと " },
            { "b": "思", "r": "おも" },
            { "b": "います。" }
          ],
          "translation": "…我想他大概不知道。"
        },
        {
          "id": "L21-S05",
          "ruby": [
            { "b": "日本", "r": "にほん" },
            { "b": "は " },
            { "b": "物価", "r": "ぶっか" },
            { "b": "が " },
            { "b": "高", "r": "たか" },
            { "b": "いと " },
            { "b": "思", "r": "おも" },
            { "b": "います。" }
          ],
          "translation": "我覺得日本的物價高。"
        },
        {
          "id": "L21-S06",
          "ruby": [
            { "b": "新", "r": "あたら" },
            { "b": "しい " },
            { "b": "空港", "r": "くうこう" },
            { "b": "に ついて どう " },
            { "b": "思", "r": "おも" },
            { "b": "いますか。" }
          ],
          "translation": "你覺得新機場怎麼樣？"
        },
        {
          "id": "L21-S07",
          "ruby": [
            { "b": "…きれいですが、ちょっと " },
            { "b": "交通", "r": "こうつう" },
            { "b": "が " },
            { "b": "不便", "r": "ふべん" },
            { "b": "だと " },
            { "b": "思", "r": "おも" },
            { "b": "います。" }
          ],
          "translation": "…很漂亮，但是交通不太方便。"
        },
        {
          "id": "L21-S08",
          "ruby": [
            { "b": "Ａ:ファクスは " },
            { "b": "便利", "r": "べんり" },
            { "b": "ですね。" }
          ],
          "translation": "A：傳真很方便嘛！"
        },
        {
          "id": "L21-S09",
          "ruby": [
            { "b": "Ｂ:わたしも そう " },
            { "b": "思", "r": "おも" },
            { "b": "います。" }
          ],
          "translation": "B：我也覺得。"
        },
        {
          "id": "L21-S10",
          "ruby": [
            { "b": "Ｃ:わたしは そう［は］ " },
            { "b": "思", "r": "おも" },
            { "b": "いません。" }
          ],
          "translation": "C：我不覺得。"
        }
      ]
    },
    {
      "id": "L21-G02",
      "pattern": "“句子”／普通形 と 言います",
      "explanation": "說的內容附加助詞「と」來表示。直接引用時,將該內容直接放進「」中。間接引用時,「と」之前用普通形,引用句的時態不受主句時態的影響。",
      "examples": [
        {
          "id": "L21-S11",
          "ruby": [
            { "b": "寝", "r": "ね" },
            { "b": "る まえに " },
            { "b": "「お" },
            { "b": "休", "r": "やす" },
            { "b": "みなさい」と " },
            { "b": "言", "r": "い" },
            { "b": "います。" }
          ],
          "translation": "睡覺前要說：「晚安」。"
        },
        {
          "id": "L21-S12",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "「来週", "r": "らいしゅう" },
            { "b": " " },
            { "b": "東京", "r": "とうきょう" },
            { "b": "へ " },
            { "b": "出張", "r": "しゅっちょう" },
            { "b": "します」と " },
            { "b": "言", "r": "い" },
            { "b": "いました。" }
          ],
          "translation": "米勒先生說：「下週要去東京出差」。"
        },
        {
          "id": "L21-S13",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "来週", "r": "らいしゅう" },
            { "b": " " },
            { "b": "東京", "r": "とうきょう" },
            { "b": "へ " },
            { "b": "出張", "r": "しゅっちょう" },
            { "b": "すると " },
            { "b": "言", "r": "い" },
            { "b": "いました。" }
          ],
          "translation": "米勒先生說他下週要去東京出差。"
        }
      ]
    },
    {
      "id": "L21-G03",
      "pattern": "動詞／い形容詞／な形容詞〜だ／名詞〜だ + でしょう？",
      "explanation": "說話人認為聽話人理當知道該話題,而且希望聽話人同意自己的意見時,用上升調「でしょう」來確認聽話人同意。",
      "examples": [
        {
          "id": "L21-S14",
          "ruby": [
            { "b": "あした パーティーに " },
            { "b": "行", "r": "い" },
            { "b": "くでしょう？" }
          ],
          "translation": "明天你會去參加派對吧？"
        },
        {
          "id": "L21-S15",
          "ruby": [
            { "b": "…ええ、 " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "…嗯，會去。"
        },
        {
          "id": "L21-S16",
          "ruby": [
            { "b": "北海道", "r": "ほっかいどう" },
            { "b": "は " },
            { "b": "寒", "r": "さむ" },
            { "b": "かったでしょう？" }
          ],
          "translation": "北海道很冷吧？"
        },
        {
          "id": "L21-S17",
          "ruby": [
            { "b": "…いいえ、そんなに " },
            { "b": "寒", "r": "さむ" },
            { "b": "くなかったです。" }
          ],
          "translation": "…不，並不很冷。"
        }
      ]
    },
    {
      "id": "L21-G04",
      "pattern": "名詞1（地點）で 名詞2が あります",
      "explanation": "當名詞2表示晚會、音樂會、節日、事件、災害、慶祝活動時,這個「あります」就表示舉行、發生的意思。",
      "examples": [
        {
          "id": "L21-S18",
          "ruby": [
            { "b": "東京", "r": "とうきょう" },
            { "b": "で " },
            { "b": "日本", "r": "にほん" },
            { "b": "と ブラジルの サッカーの " },
            { "b": "試合", "r": "しあい" },
            { "b": "が あります。" }
          ],
          "translation": "在東京要舉行日本和巴西的足球比賽。"
        }
      ]
    },
    {
      "id": "L21-G05",
      "pattern": "名詞（場合）で",
      "explanation": "事情發生的場所用「で」表示。",
      "examples": [
        {
          "id": "L21-S19",
          "ruby": [
            { "b": "会議", "r": "かいぎ" },
            { "b": "で " },
            { "b": "何", "r": "なに" },
            { "b": "か " },
            { "b": "意見", "r": "いけん" },
            { "b": "を " },
            { "b": "言", "r": "い" },
            { "b": "いましたか。" }
          ],
          "translation": "在會議上（你）發表什麼意見了嗎？"
        }
      ]
    },
    {
      "id": "L21-G06",
      "pattern": "名詞 でも 動詞",
      "explanation": "建議他人做某事或提議時;舉出同一範疇的物品之一為例時,用助詞「でも」。",
      "examples": [
        {
          "id": "L21-S20",
          "ruby": [
            { "b": "ちょっと ビールでも " },
            { "b": "飲", "r": "の" },
            { "b": "みませんか。" }
          ],
          "translation": "一起去喝點啤酒什麼的好嗎？"
        }
      ]
    },
    {
      "id": "L21-G07",
      "pattern": "動詞ない形 ないと……",
      "explanation": "這個句型,是省略「動詞ない形ないと いけません」中「いけません」的表達方式。「動詞ない形ないと いけません」和第17課學習的「動詞ない形なければ なりません」是類似的表達方式。",
      "examples": [
        {
          "id": "L21-S21",
          "ruby": [
            { "b": "もう " },
            { "b": "帰", "r": "かえ" },
            { "b": "らないと……。" }
          ],
          "translation": "我該回去了。"
        }
      ]
    }
  ],
