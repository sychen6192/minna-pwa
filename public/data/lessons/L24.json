  "grammar": [
    {
      "id": "L24-G01",
      "pattern": "くれます",
      "explanation": "第7課裡我們學過「あげます」是“給”的意思,但是這個動詞不能用在說話人及說話人的家屬等是接受者的時候。(× さとうさんは わたしに クリスマスカードを あげました),這時要用「くれます」。",
      "examples": [
        {
          "id": "L24-S01",
          "ruby": [
            { "b": "わたしは " },
            { "b": "佐藤", "r": "さとう" },
            { "b": "さんに " },
            { "b": "花", "r": "はな" },
            { "b": "を あげました。" }
          ],
          "translation": "我送了花給佐藤小姐。"
        },
        {
          "id": "L24-S02",
          "ruby": [
            { "b": "佐藤", "r": "さとう" },
            { "b": "さんは わたしに クリスマスカードを くれました。" }
          ],
          "translation": "佐藤小姐送了聖誕卡給我。"
        },
        {
          "id": "L24-S03",
          "ruby": [
            { "b": "佐藤", "r": "さとう" },
            { "b": "さんは " },
            { "b": "妹", "r": "いもうと" },
            { "b": "に お" },
            { "b": "菓子", "r": "かし" },
            { "b": "を くれました。" }
          ],
          "translation": "佐藤小姐給了妹妹點心。"
        }
      ]
    },
    {
      "id": "L24-G02",
      "pattern": "動詞て形 あげます／もらいます／くれます",
      "explanation": "「あげます、もらいます、くれます」用於表示東西互贈的場合,也可用在動作上,在明確表現出誰為誰進行該行為的同時,還表達了好意和感謝等意思。這時,行為由動詞的て形表現出來。1) 動詞て形 あげます:表現出基於好意做出的行為帶給對方好處的意思。因此,當動作者是說話人的時候,由於會給人一種強加於人的印象,對關係不太親近而地位高的人最好避免直接使用。此外在主動提出會帶給關係不親密的對方好處的行為,或有利對方的行為時,應該使用「動詞ます形ましょうか」(參照本書第14課6)。2) 動詞て形 もらいます:這是個得到好處一方心存感謝的表達方式。3) 動詞て形 くれます:與「動詞て形 もらいます」相同,是個得到好處的人心存感謝的表達方式。但是,「動詞て形 もらいます」是以得到好處的人為主語;而「動詞て形 くれます」則是以動作者為主語,動作者(主語)主動去做的語感較強。另外,當行為的接受者是說話人的時候,表示接受者的「わたしに」一般會加以省略。",
      "examples": [
        {
          "id": "L24-S04",
          "ruby": [
            { "b": "わたしは " },
            { "b": "木村", "r": "きむら" },
            { "b": "さんに " },
            { "b": "本", "r": "ほん" },
            { "b": "を " },
            { "b": "貸", "r": "か" },
            { "b": "して あげました。" }
          ],
          "translation": "我借了書給木村小姐。"
        },
        {
          "id": "L24-S05",
          "ruby": [
            { "b": "タクシーを " },
            { "b": "呼", "r": "よ" },
            { "b": "びましょうか。" }
          ],
          "translation": "我來叫計程車吧!(14課)"
        },
        {
          "id": "L24-S06",
          "ruby": [
            { "b": "手伝", "r": "てつだ" },
            { "b": "いましょうか。" }
          ],
          "translation": "我來幫忙吧!(14課)"
        },
        {
          "id": "L24-S07",
          "ruby": [
            { "b": "わたしは " },
            { "b": "山田", "r": "やまだ" },
            { "b": "さんに " },
            { "b": "図書館", "r": "としょかん" },
            { "b": "の " },
            { "b": "電話番号", "r": "でんわばんごう" },
            { "b": "を " },
            { "b": "教", "r": "おし" },
            { "b": "えて もらいました。" }
          ],
          "translation": "我向山田先生請教了圖書館的電話號碼。"
        },
        {
          "id": "L24-S08",
          "ruby": [
            { "b": "母", "r": "はは" },
            { "b": "は［わたしに］セーターを " },
            { "b": "送", "r": "おく" },
            { "b": "って くれました。" }
          ],
          "translation": "母親幫我寄來了毛衣。"
        }
      ]
    },
    {
      "id": "L24-G03",
      "pattern": "名詞(人)が 動詞",
      "explanation": "對方以領帶為話題,說出了「すてきな ネクタイですね」,對此,就這條領帶敘述對方所不知道的資訊「［この ネクタイは］さとうさんが くれました」。表示新資訊的句子主語要用「が」來表示。",
      "examples": [
        {
          "id": "L24-S09",
          "ruby": [
            { "b": "すてきな ネクタイですね。" }
          ],
          "translation": "真是漂亮的領帶呀!"
        },
        {
          "id": "L24-S10",
          "ruby": [
            { "b": "…ええ、" },
            { "b": "佐藤", "r": "さとう" },
            { "b": "さんが くれました。" }
          ],
          "translation": "…是呀,佐藤小姐送的。"
        }
      ]
    },
    {
      "id": "L24-G04",
      "pattern": "疑問詞 が 動詞",
      "explanation": "我們在第10課的「あります／います」句型,以及第12課的形容詞句中已學過了疑問詞作為主語時,主語要用「が」表示。上述以外的動詞句,在疑問詞作主語時,主語也用「が」表示。",
      "examples": [
        {
          "id": "L24-S11",
          "ruby": [
            { "b": "だれが " },
            { "b": "手伝", "r": "てつだ" },
            { "b": "いに " },
            { "b": "行", "r": "い" },
            { "b": "きますか。" }
          ],
          "translation": "誰要去幫忙呀?"
        },
        {
          "id": "L24-S12",
          "ruby": [
            { "b": "…カリナさんが " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "…卡莉娜小姐要去。"
        }
      ]
    }
  ],
