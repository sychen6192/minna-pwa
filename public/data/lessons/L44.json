  "grammar": [
    {
      "id": "L44-G01",
      "pattern": "(動詞ます形／い形容詞〜い／な形容詞［な］)すぎます",
      "explanation": "「〜すぎます」表示行為或狀態的程度超過了容許的範圍,因此一般用於不希望有某種狀態時。「〜すぎます」屬於第二類動詞,所以活用也相同。例:のみすぎる、のみすぎ(ない)、のみすぎた。",
      "examples": [
        {
          "id": "L44-S01",
          "ruby": [
            { "b": "ゆうべ お" },
            { "b": "酒", "r": "さけ" },
            { "b": "を " },
            { "b": "飲", "r": "の" },
            { "b": "みすぎました。" }
          ],
          "translation": "昨晚酒喝多了。"
        },
        {
          "id": "L44-S02",
          "ruby": [
            { "b": "この セーターは " },
            { "b": "大", "r": "おお" },
            { "b": "きすぎます。" }
          ],
          "translation": "這件毛衣太大了。"
        },
        {
          "id": "L44-S03",
          "ruby": [
            { "b": "最近", "r": "さいきん" },
            { "b": "の " },
            { "b": "車", "r": "くるま" },
            { "b": "は " },
            { "b": "操作", "r": "そうさ" },
            { "b": "が " },
            { "b": "簡単", "r": "かんたん" },
            { "b": "すぎて、" },
            { "b": "運転", "r": "うんてん" },
            { "b": "が おもしろくないです。" }
          ],
          "translation": "最近的汽車操作太簡單,開車沒什麼意思。"
        },
        {
          "id": "L44-S04",
          "ruby": [
            { "b": "いくら " },
            { "b": "好", "r": "す" },
            { "b": "きでも、" },
            { "b": "飲", "r": "の" },
            { "b": "みすぎると、" },
            { "b": "体", "r": "からだ" },
            { "b": "に " },
            { "b": "悪", "r": "わる" },
            { "b": "いですよ。" }
          ],
          "translation": "不管多喜歡,一旦飲酒過度就對身體不好。"
        }
      ]
    },
    {
      "id": "L44-G02",
      "pattern": "(動詞ます形)やすいです／にくいです",
      "explanation": "1)表示對於某個對象進行某個動作時,具有容易或者困難的性質。2)表示主體的物體或人容易成為那樣,或者不容易成為那樣。或者表示某件事容易發生或不容易發生。〔註〕「〜やすい」「〜にくい」的活用和い形容詞相同。",
      "examples": [
        {
          "id": "L44-S05",
          "ruby": [
            { "b": "この パソコンは " },
            { "b": "使", "r": "つか" },
            { "b": "いやすいです。" }
          ],
          "translation": "這台電腦很好用。"
        },
        {
          "id": "L44-S06",
          "ruby": [
            { "b": "東京", "r": "とうきょう" },
            { "b": "は " },
            { "b": "住", "r": "す" },
            { "b": "みにくいです。" }
          ],
          "translation": "東京住起來不方便。"
        },
        {
          "id": "L44-S07",
          "ruby": [
            { "b": "白", "r": "しろ" },
            { "b": "い シャツは " },
            { "b": "汚", "r": "よご" },
            { "b": "れやすいです。" }
          ],
          "translation": "白襯衫容易髒。"
        },
        {
          "id": "L44-S08",
          "ruby": [
            { "b": "雨", "r": "あめ" },
            { "b": "の " },
            { "b": "日", "r": "ひ" },
            { "b": "は " },
            { "b": "洗濯物", "r": "せんたくもの" },
            { "b": "が " },
            { "b": "乾", "r": "かわ" },
            { "b": "きにくいです。" }
          ],
          "translation": "下雨天洗的衣物不容易乾。"
        },
        {
          "id": "L44-S09",
          "ruby": [
            { "b": "この " },
            { "b": "薬", "r": "くすり" },
            { "b": "は " },
            { "b": "砂糖", "r": "さとう" },
            { "b": "を " },
            { "b": "入", "r": "い" },
            { "b": "れると、" },
            { "b": "飲", "r": "の" },
            { "b": "みやすく なりますよ。" }
          ],
          "translation": "這個藥加點糖就容易下口了。"
        },
        {
          "id": "L44-S10",
          "ruby": [
            { "b": "この コップは " },
            { "b": "割", "r": "わ" },
            { "b": "れにくくて、" },
            { "b": "安全", "r": "あんぜん" },
            { "b": "ですよ。" }
          ],
          "translation": "這個杯子不容易破,很安全。"
        }
      ]
    },
    {
      "id": "L44-G03",
      "pattern": "(い形容詞〜い→〜く／な形容詞［な］→に／名詞 に) します",
      "explanation": "第19課學的「〜く／に なります」,是表示某個主體變化成某個狀態,而⑪〜⑬的「〜く／〜に します」,則表示由某人讓某個對象變成某個狀態。",
      "examples": [
        {
          "id": "L44-S11",
          "ruby": [
            { "b": "音", "r": "おと" },
            { "b": "を " },
            { "b": "大", "r": "おお" },
            { "b": "きく します。" }
          ],
          "translation": "把聲音調大。"
        },
        {
          "id": "L44-S12",
          "ruby": [
            { "b": "部屋", "r": "へや" },
            { "b": "を きれいに します。" }
          ],
          "translation": "把房間打掃乾淨。"
        },
        {
          "id": "L44-S13",
          "ruby": [
            { "b": "塩", "r": "しお" },
            { "b": "の " },
            { "b": "量", "r": "りょう" },
            { "b": "を " },
            { "b": "半分", "r": "はんぶん" },
            { "b": "に しました。" }
          ],
          "translation": "把鹽的分量減半。"
        }
      ]
    },
    {
      "id": "L44-G04",
      "pattern": "(名詞)に します",
      "explanation": "這個句型表示選擇和決定。",
      "examples": [
        {
          "id": "L44-S14",
          "ruby": [
            { "b": "部屋", "r": "へや" },
            { "b": "は シングルに しますか、ツインに しますか。" }
          ],
          "translation": "房間要單人房還是雙人房呢?"
        },
        {
          "id": "L44-S15",
          "ruby": [
            { "b": "会議", "r": "かいぎ" },
            { "b": "は あしたに します。" }
          ],
          "translation": "會議在明天開。"
        }
      ]
    },
    {
      "id": "L44-G05",
      "pattern": "(い形容詞〜い→く／な形容詞［な］→に) 動詞",
      "explanation": "如上述般,改變形容詞的形式作為副詞使用。",
      "examples": [
        {
          "id": "L44-S16",
          "ruby": [
            { "b": "野菜", "r": "やさい" },
            { "b": "を " },
            { "b": "細", "r": "こま" },
            { "b": "かく " },
            { "b": "切", "r": "き" },
            { "b": "って ください。" }
          ],
          "translation": "請把蔬菜切細一點。"
        },
        {
          "id": "L44-S17",
          "ruby": [
            { "b": "電気", "r": "でんき" },
            { "b": "や " },
            { "b": "水", "r": "みず" },
            { "b": "は " },
            { "b": "大切", "r": "たいせつ" },
            { "b": "に " },
            { "b": "使", "r": "つか" },
            { "b": "いましょう。" }
          ],
          "translation": "要愛惜使用水電。"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L44-D01",
      "ruby": [
        { "b": "いらっしゃいませ。きょうは どう なさいますか。" }
      ],
      "translation": "歡迎光臨。今天要怎麼做呢?",
      "speaker": "美容師"
    },
    {
      "id": "L44-D02",
      "ruby": [
        { "b": "カット、お" },
        { "b": "願", "r": "ねが" },
        { "b": "いします。" }
      ],
      "translation": "我要剪髮,麻煩你了。",
      "speaker": "イー"
    },
    {
      "id": "L44-D03",
      "ruby": [
        { "b": "じゃ、シャンプーを しますから、こちらへ どうぞ。" }
      ],
      "translation": "那麼,先幫您洗頭,請往這邊走。",
      "speaker": "美容師"
    },
    {
      "id": "L44-D04",
      "ruby": [
        { "b": "カットは どういうふうに なさいますか。" }
      ],
      "translation": "頭髮要怎麼剪呢?",
      "speaker": "美容師"
    },
    {
      "id": "L44-D05",
      "ruby": [
        { "b": "ショートに したいんですけど……。" },
        { "b": "この " },
        { "b": "写真", "r": "しゃしん" },
        { "b": "みたいに して ください。" }
      ],
      "translation": "我想剪成短髮……。請剪成像這張照片一樣。",
      "speaker": "イー"
    },
    {
      "id": "L44-D06",
      "ruby": [
        { "b": "あ、すてきですね。" }
      ],
      "translation": "啊,很好看呢。",
      "speaker": "美容師"
    },
    {
      "id": "L44-D07",
      "ruby": [
        { "b": "前", "r": "まえ" },
        { "b": "の " },
        { "b": "長", "r": "なが" },
        { "b": "さは これで よろしいでしょうか。" }
      ],
      "translation": "前面的長度這樣可以嗎?",
      "speaker": "美容師"
    },
    {
      "id": "L44-D08",
      "ruby": [
        { "b": "そうですね。もう " },
        { "b": "少", "r": "すこ" },
        { "b": "し " },
        { "b": "短", "r": "みじか" },
        { "b": "く して ください。" }
      ],
      "translation": "嗯……,請再剪短一點。",
      "speaker": "イー"
    },
    {
      "id": "L44-D09",
      "ruby": [
        { "b": "どうも お" },
        { "b": "疲", "r": "つか" },
        { "b": "れさまでした。いかがですか。" }
      ],
      "translation": "您辛苦了。覺得如何呢?",
      "speaker": "美容師"
    },
    {
      "id": "L44-D10",
      "ruby": [
        { "b": "けっこうです。どうも ありがとう。" }
      ],
      "translation": "很好。謝謝你。",
      "speaker": "イー"
    }
  ]
}
