  "grammar": [
    {
      "id": "L23-G01",
      "pattern": "(動詞字典形／ない形／い形容詞／な形容詞 な／名詞 の)とき、〜",
      "explanation": "「とき」用於連接兩個句子,表示由後續主句表現的狀態、動作,和現象成立的時間。而動詞、い形容詞、な形容詞、名詞的接續方法如上表所示,與修飾名詞時相同。修飾「とき」的形容詞句和名詞句的時態,不受主句時態的影響(參考⑥⑦)。",
      "examples": [
        {
          "id": "L23-S01",
          "ruby": [
            { "b": "図書館", "r": "としょかん" },
            { "b": "で " },
            { "b": "本", "r": "ほん" },
            { "b": "を " },
            { "b": "借", "r": "か" },
            { "b": "りる とき、カードが " },
            { "b": "要", "r": "い" },
            { "b": "ります。" }
          ],
          "translation": "在圖書館借書時,需要借書卡。"
        },
        {
          "id": "L23-S02",
          "ruby": [
            { "b": "使", "r": "つか" },
            { "b": "い" },
            { "b": "方", "r": "かた" },
            { "b": "が わからない とき、わたしに " },
            { "b": "聞", "r": "き" },
            { "b": "いて ください。" }
          ],
          "translation": "不明白使用方法時,請問我。"
        },
        {
          "id": "L23-S03",
          "ruby": [
            { "b": "体", "r": "からだ" },
            { "b": "の " },
            { "b": "調子", "r": "ちょうし" },
            { "b": "が " },
            { "b": "悪", "r": "わる" },
            { "b": "い とき、「 " },
            { "b": "元気茶", "r": "げんきちゃ" },
            { "b": "」を " },
            { "b": "飲", "r": "の" },
            { "b": "みます。" }
          ],
          "translation": "身體狀況不好時,會喝「元氣茶」。"
        },
        {
          "id": "L23-S04",
          "ruby": [
            { "b": "暇", "r": "ひま" },
            { "b": "な とき、うちへ " },
            { "b": "遊", "r": "あそ" },
            { "b": "びに " },
            { "b": "来", "r": "き" },
            { "b": "ませんか。" }
          ],
          "translation": "有空的時候來我家玩好嗎?"
        },
        {
          "id": "L23-S05",
          "ruby": [
            { "b": "妻", "r": "つま" },
            { "b": "が " },
            { "b": "病気", "r": "びょうき" },
            { "b": "の とき、 " },
            { "b": "会社", "r": "かいしゃ" },
            { "b": "を " },
            { "b": "休", "r": "やす" },
            { "b": "みました。" }
          ],
          "translation": "太太生病時,我沒去公司上班。"
        },
        {
          "id": "L23-S06",
          "ruby": [
            { "b": "若", "r": "わか" },
            { "b": "い とき、あまり " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "しませんでした。" }
          ],
          "translation": "年輕時我不太用功。"
        },
        {
          "id": "L23-S07",
          "ruby": [
            { "b": "子", "r": "こ" },
            { "b": "どもの とき、よく " },
            { "b": "川", "r": "かわ" },
            { "b": "で " },
            { "b": "泳", "r": "およ" },
            { "b": "ぎました。" }
          ],
          "translation": "小時候,經常在河裡游泳。"
        }
      ]
    },
    {
      "id": "L23-G02",
      "pattern": "(動詞字典形／動詞 た形)とき、〜",
      "explanation": "「とき」前的述語的字典形表現動作尚未結束,た形表示動作已經結束。⑧句中,「かえる」表示動作尚未完成,還沒回到國內,在回國途中的某國(包括日本)買了皮包;而⑨句中的「かえった」則表示動作已經結束,是回國後在國內買的皮包。",
      "examples": [
        {
          "id": "L23-S08",
          "ruby": [
            { "b": "国", "r": "くに" },
            { "b": "へ " },
            { "b": "帰", "r": "かえ" },
            { "b": "る とき、かばんを " },
            { "b": "買", "r": "か" },
            { "b": "いました。" }
          ],
          "translation": "回國時買了皮包。"
        },
        {
          "id": "L23-S09",
          "ruby": [
            { "b": "国", "r": "くに" },
            { "b": "へ " },
            { "b": "帰", "r": "かえ" },
            { "b": "った とき、かばんを " },
            { "b": "買", "r": "か" },
            { "b": "いました。" }
          ],
          "translation": "回國之後買了皮包。"
        }
      ]
    },
    {
      "id": "L23-G03",
      "pattern": "(動詞字典形)と、〜",
      "explanation": "做某個動作的結果,必然會導致別的作用或事件的相繼發生,這時用「と」連接兩個句子。在「〜と」之後的句子中,不能使用意志、希望、勸誘、委託等表達。這些要用第25課要學的條件表達方式「〜たら、〜」來表達。",
      "examples": [
        {
          "id": "L23-S10",
          "ruby": [
            { "b": "この ボタンを " },
            { "b": "押", "r": "お" },
            { "b": "すと、お " },
            { "b": "釣", "r": "つ" },
            { "b": "りが " },
            { "b": "出", "r": "で" },
            { "b": "ます。" }
          ],
          "translation": "一按這個按鈕,找的零錢就會出來。"
        },
        {
          "id": "L23-S11",
          "ruby": [
            { "b": "これを " },
            { "b": "回", "r": "まわ" },
            { "b": "すと、 " },
            { "b": "音", "r": "おと" },
            { "b": "が " },
            { "b": "大", "r": "おお" },
            { "b": "きく なります。" }
          ],
          "translation": "一旋轉這個,聲音就會變大。"
        },
        {
          "id": "L23-S12",
          "ruby": [
            { "b": "右", "r": "みぎ" },
            { "b": "へ " },
            { "b": "曲", "r": "ま" },
            { "b": "がると、 " },
            { "b": "郵便局", "r": "ゆうびんきょく" },
            { "b": "が あります。" }
          ],
          "translation": "一向右轉,就是郵局。"
        }
      ]
    },
    {
      "id": "L23-G04",
      "pattern": "(名詞)が (形容詞／動詞)",
      "explanation": "描寫自然現象時,我們在14課已經學過用「が」表示主體,至於對某個狀態或場面進行直接描寫時,主體也要用「が」表示。",
      "examples": [
        {
          "id": "L23-S13",
          "ruby": [
            { "b": "音", "r": "おと" },
            { "b": "が " },
            { "b": "小", "r": "ちい" },
            { "b": "さいです。" }
          ],
          "translation": "聲音很小。"
        },
        {
          "id": "L23-S14",
          "ruby": [
            { "b": "電気", "r": "でんき" },
            { "b": "が " },
            { "b": "明", "r": "あか" },
            { "b": "るく なりました。" }
          ],
          "translation": "電燈變亮了。"
        },
        {
          "id": "L23-S15",
          "ruby": [
            { "b": "この ボタンを " },
            { "b": "押", "r": "お" },
            { "b": "すと、 " },
            { "b": "切符", "r": "きっぷ" },
            { "b": "が " },
            { "b": "出", "r": "で" },
            { "b": "ます。" }
          ],
          "translation": "一按這個按鈕,票就會出來。"
        }
      ]
    },
    {
      "id": "L23-G05",
      "pattern": "(名詞〔場所〕)を (移動動詞)",
      "explanation": "助詞「を」用來表示人或動作通過的場所。「さんぽします、わたります、あるきます」等移動動詞可用在這個句型。",
      "examples": [
        {
          "id": "L23-S16",
          "ruby": [
            { "b": "公園", "r": "こうえん" },
            { "b": "を " },
            { "b": "散歩", "r": "さんぽ" },
