            { "b": "渡", "r": "わた" },
            { "b": "ります。" }
          ],
          "translation": "過馬路。"
        },
        {
          "id": "L23-S18",
          "ruby": [
            { "b": "交差点", "r": "こうさてん" },
            { "b": "を " },
            { "b": "右", "r": "みぎ" },
            { "b": "へ " },
            { "b": "曲", "r": "ま" },
            { "b": "がります。" }
          ],
          "translation": "在十字路口向右轉。"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L23-D01",
      "ruby": [
        { "b": "どうやって " },
        { "b": "行", "r": "い" },
        { "b": "きますか" }
      ],
      "translation": "怎麼去呢"
    },
    {
      "id": "L23-D02",
      "ruby": [
        { "b": "はい、みどり" },
        { "b": "図書館", "r": "としょかん" },
        { "b": "です。" }
      ],
      "translation": "您好,這裡是綠圖書館。",
      "speaker": "図書館の人"
    },
    {
      "id": "L23-D03",
      "ruby": [
        { "b": "あのう、そちらまで どうやって " },
        { "b": "行", "r": "い" },
        { "b": "きますか。" }
      ],
      "translation": "不好意思,請問到你們那裡要怎麼去呢?",
      "speaker": "カリナ"
    },
    {
      "id": "L23-D04",
      "ruby": [
        { "b": "本田駅", "r": "ほんだえき" },
        { "b": "から 12" },
        { "b": "番", "r": "ばん" },
        { "b": "の バスに " },
        { "b": "乗", "r": "の" },
        { "b": "って、" },
        { "b": "図書館前", "r": "としょかんまえ" },
        { "b": "で " },
        { "b": "降", "r": "お" },
        { "b": "りて ください。3つ" },
        { "b": "目", "r": "め" },
        { "b": "です。" }
      ],
      "translation": "請從本田站搭乘12路公車,在圖書館前下車。是第三站。",
      "speaker": "図書館の人"
    },
    {
      "id": "L23-D05",
      "ruby": [
        { "b": "3つ" },
        { "b": "目", "r": "め" },
        { "b": "ですね。" }
      ],
      "translation": "第三站對吧。",
      "speaker": "カリナ"
    },
    {
      "id": "L23-D06",
      "ruby": [
        { "b": "ええ。" },
        { "b": "降", "r": "お" },
        { "b": "りると、" },
        { "b": "前", "r": "まえ" },
        { "b": "に " },
        { "b": "公園", "r": "こうえん" },
        { "b": "が あります。" },
        { "b": "図書館", "r": "としょかん" },
        { "b": "は その " },
        { "b": "公園", "r": "こうえん" },
        { "b": "の " },
        { "b": "中", "r": "なか" },
        { "b": "の " },
        { "b": "白", "r": "しろ" },
        { "b": "い " },
        { "b": "建物", "r": "たてもの" },
        { "b": "です。" }
      ],
      "translation": "是的。一下車,前面就有一座公園。圖書館就是那座公園裡的白色建築物。",
      "speaker": "図書館の人"
    },
    {
      "id": "L23-D07",
      "ruby": [{ "b": "わかりました。" }],
      "translation": "我知道了。",
      "speaker": "カリナ"
    },
    {
      "id": "L23-D08",
      "ruby": [
        { "b": "それから " },
        { "b": "本", "r": "ほん" },
        { "b": "を " },
        { "b": "借", "r": "か" },
        { "b": "りる とき、" },
        { "b": "何", "r": "なに" },
        { "b": "か " },
        { "b": "要", "r": "い" },
        { "b": "りますか。" }
      ],
      "translation": "還有,借書的時候,需要帶什麼東西嗎?",
      "speaker": "カリナ"
    },
    {
      "id": "L23-D09",
      "ruby": [
