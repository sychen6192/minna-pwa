  "grammar": [
    {
      "id": "L33-G01",
      "pattern": "命令形、禁止形",
      "explanation": "1)命令形的變換方法（參考進階Ⅰ本冊94頁第33課練習A1）：Ⅰ類動詞將「ます形」的最後的假名改成「え段」音；Ⅱ類動詞在「ます形」後加上「ろ」；Ⅲ類動詞「きます」是「こい」，「します」是「しろ」。〔註〕「わかる」「できる」「ある」等不帶意志的動詞沒有命令形。2)禁止形的變換方法：任何動詞的禁止形都是字典形後加上「な」。",
      "examples": [
        {
          "id": "L33-S01",
          "ruby": [{ "b": "急", "r": "いそ" }, { "b": "げ。" }],
          "translation": "快一點。"
        },
        {
          "id": "L33-S02",
          "ruby": [{ "b": "触", "r": "さわ" }, { "b": "るな。" }],
          "translation": "不要碰。"
        }
      ]
    },
    {
      "id": "L33-G02",
      "pattern": "命令形和禁止形的用法",
      "explanation": "1)命令形是強行要對方做某個動作時使用，而禁止形則是命令對方不要做某個動作時使用。由於這兩種形式都帶有壓迫性和強烈的聲響，因此很少用於句尾。而且使用在口頭上時，幾乎都是男性。2)命令形、禁止形在單獨或句尾使用的場合：(1)地位和年齡居上位的男性對下位的男性，或者父親對孩子使用。(2)男性的朋友之間，在使用時為了緩和語氣，多在句尾加上助詞「よ」。(3)在工廠共同作業時的指示和在火災、地震等緊急情況下，沒有時間考慮對對方的談話方式時，但這時也往往只限於地位和年齡居上位的男性使用。(4)團體訓練、學校或社團的體育活動中發出號令時。(5)運動競賽觀戰為選手加油時，這時女性也可以用。(6)交通標誌或標語等要達到強烈效果或重視用語簡潔時。〔註〕命令形式中也有「動詞ます形なさい」的形式。這是父母對孩子、教師對學生等使用的表達方式，語氣比動詞命令形親切，所以女性用它取代命令形使用。但是不能用於長輩或上級。",
      "examples": [
        {
          "id": "L33-S03",
          "ruby": [{ "b": "早", "r": "はや" }, { "b": "く " }, { "b": "寝", "r": "ね" }, { "b": "ろ。" }],
          "translation": "早點睡！"
        },
        {
          "id": "L33-S04",
          "ruby": [{ "b": "遅", "r": "おく" }, { "b": "れるな。" }],
          "translation": "別遲到！"
        },
        {
          "id": "L33-S05",
          "ruby": [{ "b": "あした うちへ " }, { "b": "来", "r": "こ" }, { "b": "い［よ］。" }],
          "translation": "明天到我家來（吧）！"
        },
        {
          "id": "L33-S06",
          "ruby": [{ "b": "あまり " }, { "b": "飲", "r": "の" }, { "b": "むな［よ］。" }],
          "translation": "別喝多了！"
        },
        {
          "id": "L33-S07",
          "ruby": [{ "b": "逃", "r": "に" }, { "b": "げろ。" }],
          "translation": "快逃！"
        },
        {
          "id": "L33-S08",
          "ruby": [{ "b": "エレベーターを " }, { "b": "使", "r": "つか" }, { "b": "うな。" }],
          "translation": "不要用電梯！"
        },
        {
          "id": "L33-S09",
          "ruby": [{ "b": "休", "r": "やす" }, { "b": "め。" }],
          "translation": "稍息！"
        },
        {
          "id": "L33-S10",
          "ruby": [{ "b": "休", "r": "やす" }, { "b": "むな。" }],
          "translation": "不准休息！"
        },
        {
          "id": "L33-S11",
          "ruby": [{ "b": "頑張", "r": "がんば" }, { "b": "れ。" }],
          "translation": "加油！"
        },
        {
          "id": "L33-S12",
          "ruby": [{ "b": "負", "r": "ま" }, { "b": "けるな。" }],
          "translation": "不可以輸！"
        },
        {
          "id": "L33-S13",
          "ruby": [{ "b": "止", "r": "と" }, { "b": "まれ。" }],
          "translation": "停車再開。"
        },
        {
          "id": "L33-S14",
          "ruby": [{ "b": "入", "r": "はい" }, { "b": "るな。" }],
          "translation": "禁止進入。"
        },
        {
          "id": "L33-S15",
          "ruby": [{ "b": "勉強", "r": "べんきょう" }, { "b": "しなさい。" }],
          "translation": "去念書。"
        }
      ]
    },
    {
      "id": "L33-G03",
      "pattern": "「〜と 読みます」和「〜と 書いて あります」",
      "explanation": "例句⑭⑮中的「と」和「〜と いいます」（第21課）的「と」起著相同的作用。",
      "examples": [
        {
          "id": "L33-S16",
          "ruby": [{ "b": "あの " }, { "b": "漢字", "r": "かんじ" }, { "b": "は " }, { "b": "何", "r": "なん" }, { "b": "と " }, { "b": "読", "r": "よ" }, { "b": "むんですか。" }],
          "translation": "那個漢字怎麼唸"
        },
        {
          "id": "L33-S17",
          "ruby": [{ "b": "あそこに「" }, { "b": "止", "r": "と" }, { "b": "まれ」と " }, { "b": "書", "r": "か" }, { "b": "いて あります。" }],
          "translation": "那裡寫著“停車再開”。"
        }
      ]
    },
    {
      "id": "L33-G04",
      "pattern": "Ｘは Ｙと いう 意味です",
      "explanation": "Ｘ 是 Ｙ 的意思。這是用於給某一單詞（X）下定義時。「と いう」是從「と いいます」轉來的。對意思發問時，疑問詞用「どういう」。",
      "examples": [
        {
          "id": "L33-S18",
          "ruby": [{ "b": "「" }, { "b": "立入禁止", "r": "たちいりきんし" }, { "b": "」は " }, { "b": "入", "r": "はい" }, { "b": "るなと いう " }, { "b": "意味", "r": "いみ" }, { "b": "です。" }],
          "translation": "“禁止進入”是不准進入的意思。"
        },
        {
          "id": "L33-S19",
          "ruby": [{ "b": "この マークは どういう " }, { "b": "意味", "r": "いみ" }, { "b": "ですか。" }],
          "translation": "這個標誌是什麼意思？"
        },
        {
          "id": "L33-S20",
          "ruby": [{ "b": "…" }, { "b": "洗濯機", "r": "せんたくき" }, { "b": "で " }, { "b": "洗", "r": "あら" }, { "b": "えると いう " }, { "b": "意味", "r": "いみ" }, { "b": "です。" }],
          "translation": "…可以用洗衣機洗的意思。"
        }
      ]
    },
    {
      "id": "L33-G05",
      "pattern": "“句子(普通形)”と 言って いました",
      "explanation": "引用第三者的話時用「〜と いいました」（第21課），但轉告第三者的話時要用「〜と いって いました」。",
      "examples": [
