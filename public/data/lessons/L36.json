  "grammar": [
    {
      "id": "L36-G01",
      "pattern": "動詞辞書形／ない形ない ように、動詞2",
      "explanation": "動詞1表示目的或目標的狀態、動詞2表示為了達到目標的意志性動作。「ように」之前要使用非意志動詞（例如:可能動詞、「わかります」「みえます」「きこえます」「なります」等）的字典形或動詞的否定形。",
      "examples": [
        {
          "id": "L36-S01",
          "ruby": [
            { "b": "速", "r": "はや" },
            { "b": "く " },
            { "b": "泳", "r": "およ" },
            { "b": "げるように、" },
            { "b": "毎日", "r": "まいにち" },
            { "b": " " },
            { "b": "練習", "r": "れんしゅう" },
            { "b": "して います。" }
          ],
          "translation": "為了能游得更快、每天都在練習。"
        },
        {
          "id": "L36-S02",
          "ruby": [
            { "b": "忘", "r": "わす" },
            { "b": "れないように、メモして ください。" }
          ],
          "translation": "為了不會忘記、請做筆記。"
        }
      ]
    },
    {
      "id": "L36-G02",
      "pattern": "動詞辞書形 ように／ない形なく なります",
      "explanation": "「なります」表示從一種狀態變化到另一種狀態、可用可能動詞或「わかります」「みえます」等表示能力、可能的動詞。「動詞字典形ように なります」表示從不能的狀態變化到能的狀態。「動詞ない形なく なります」剛好相反（也就是說某種狀態發生了變化、原來的狀態消失了）。對於像「〜ように なりましたか」般的疑問句、用「いいえ」回答時用「いいえ、まだ〜ません」。〔註〕若使用表示能力以外的動詞、則表示有了以前沒有的習慣或捨棄了以前的習慣;「なれる」「ふとる」「やせる」等本來就表示變化的動詞不能用於這個句型。",
      "examples": [
        {
          "id": "L36-S03",
          "ruby": [
            { "b": "毎日", "r": "まいにち" },
            { "b": " " },
            { "b": "練習", "r": "れんしゅう" },
            { "b": "すれば、" },
            { "b": "泳", "r": "およ" },
            { "b": "げるように なります。" }
          ],
          "translation": "如果每天練習、就會游泳了。"
        },
        {
          "id": "L36-S04",
          "ruby": [
            { "b": "やっと " },
            { "b": "自転車", "r": "じてんしゃ" },
            { "b": "に " },
            { "b": "乗", "r": "の" },
            { "b": "れるように なりました。" }
          ],
          "translation": "終於會騎腳踏車了。"
        },
        {
          "id": "L36-S05",
          "ruby": [
            { "b": "年", "r": "とし" },
            { "b": "を " },
            { "b": "取", "r": "と" },
            { "b": "ると、" },
            { "b": "小", "r": "ちい" },
            { "b": "さい " },
            { "b": "字", "r": "じ" },
            { "b": "が " },
            { "b": "読", "r": "よ" },
            { "b": "めなく なります。" }
          ],
          "translation": "年紀一大、小的字就看不見了。"
        },
        {
          "id": "L36-S06",
          "ruby": [
            { "b": "太", "r": "ふと" },
            { "b": "りましたから、" },
            { "b": "好", "r": "す" },
            { "b": "きな " },
            { "b": "服", "r": "ふく" },
            { "b": "が " },
            { "b": "着", "r": "き" },
            { "b": "られなく なりました。" }
          ],
          "translation": "長胖了、喜歡的衣服都穿不下了。"
        },
        {
          "id": "L36-S07",
          "ruby": [
            { "b": "ショパンが " },
            { "b": "弾", "r": "ひ" },
            { "b": "けるように なりましたか。" }
          ],
          "translation": "蕭邦的作品會彈了嗎？"
        },
        {
          "id": "L36-S08",
          "ruby": [
            { "b": "…いいえ、まだ " },
            { "b": "弾", "r": "ひ" },
            { "b": "けません。" }
          ],
          "translation": "…不、還不會彈。"
        },
        {
          "id": "L36-S09",
          "ruby": [
            { "b": "日本人", "r": "にほんじん" },
            { "b": "は 100 " },
            { "b": "年", "r": "ねん" },
            { "b": "ぐらいまえから " },
            { "b": "牛肉", "r": "ぎゅうにく" },
            { "b": "や " },
            { "b": "豚肉", "r": "ぶたにく" },
            { "b": "を " },
            { "b": "食", "r": "た" },
            { "b": "べるように なりました。" }
          ],
          "translation": "日本人從100年以前開始吃牛肉和豬肉的。"
        },
        {
          "id": "L36-S10",
          "ruby": [
            { "b": "車", "r": "くるま" },
            { "b": "を " },
            { "b": "買", "r": "か" },
            { "b": "ってから、わたしは あまり " },
            { "b": "歩", "r": "ある" },
            { "b": "かなく なりました。" }
          ],
