  "dialogues": [
    {
      "id": "L36-D01",
      "ruby": [
        { "b": "皆", "r": "みな" },
        { "b": "さん、こんにちは。" },
        { "b": "健康", "r": "けんこう" },
        { "b": "の " },
        { "b": "時間", "r": "じかん" },
        { "b": "です。きょうの お" },
        { "b": "客様", "r": "きゃくさま" },
        { "b": "は ことし 80" },
        { "b": "歳", "r": "さい" },
        { "b": "の " },
        { "b": "小川", "r": "おがわ" },
        { "b": "よねさんです。" }
      ],
      "translation": "各位、午安。健康時間到了。今天的來賓是今年80歲的小川米女士。",
      "speaker": "アナウンサー"
    },
    {
      "id": "L36-D02",
