        }
      ]
    },
    {
      "id": "L36-G03",
      "pattern": "動詞辞書形／ない形ない ように します",
      "explanation": "這個句型表示習慣性或持續性地努力做或不做某個動作。「〜ように して います」表示習慣性、持續性注意的事情。「〜ように して ください」是間接的請求、和「〜て／〜ないで ください」相比是更禮貌的請求、用於要求向習慣性目標努力或禮貌地提出僅此一次的努力目標;但不能使用於當場的請求。",
      "examples": [
        {
          "id": "L36-S11",
          "ruby": [
            { "b": "毎日", "r": "まいにち" },
            { "b": " " },
            { "b": "運動", "r": "うんどう" },
            { "b": "して、" },
            { "b": "何", "r": "なん" },
            { "b": "でも " },
            { "b": "食", "r": "た" },
            { "b": "べるように して います。" }
          ],
          "translation": "我每天運動、什麼都吃。"
        },
        {
          "id": "L36-S12",
          "ruby": [
            { "b": "歯", "r": "は" },
            { "b": "に " },
            { "b": "悪", "r": "わる" },
            { "b": "いですから、" },
            { "b": "甘", "r": "あま" },
            { "b": "い " },
            { "b": "物", "r": "もの" },
            { "b": "を " },
            { "b": "食", "r": "た" },
            { "b": "べないように して います。" }
          ],
          "translation": "因為對牙齒不好、所以我不吃甜食。"
        },
        {
          "id": "L36-S13",
          "ruby": [
            { "b": "もっと " },
            { "b": "野菜", "r": "やさい" },
            { "b": "を " },
            { "b": "食", "r": "た" },
            { "b": "べるように して ください。" }
          ],
          "translation": "請再多吃些蔬菜。"
        },
        {
          "id": "L36-S14",
          "ruby": [
            { "b": "あしたは " },
            { "b": "絶対", "r": "ぜったい" },
            { "b": "に " },
            { "b": "時間", "r": "じかん" },
            { "b": "に " },
            { "b": "遅", "r": "おく" },
            { "b": "れないように して ください。" }
          ],
          "translation": "明天請絕對不要遲到。"
        },
        {
          "id": "L36-S15",
          "ruby": [
            { "b": "すみませんが、" },
            { "b": "塩", "r": "しお" },
            { "b": "を " },
            { "b": "取", "r": "と" },
            { "b": "って ください。" }
          ],
          "translation": "對不起、請拿一下鹽。"
        }
      ]
    },
    {
      "id": "L36-G04",
      "pattern": "〜とか",
      "explanation": "「〜とか」和「〜や」一樣用於舉例、但「〜とか」較口語化。另外和「〜や」不一樣、「〜とか」還可以放在最後的名詞之後。",
      "examples": [
        {
          "id": "L36-S16",
          "ruby": [
            { "b": "どんな スポーツを して いますか。" }
          ],
          "translation": "你都做些什麼運動？"
        },
