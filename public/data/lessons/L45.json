  "grammar": [
    {
      "id": "L45-G01",
      "pattern": "〜場合は、〜",
      "explanation": "「〜ばあいは」是預想某種狀況的表達方式。後續的句子則表示應對的方法,或是成為某種結果。「ばあい」可接在動詞、形容詞、名詞等詞之後,因為「ばあい」是名詞,所以接續的方法和修飾名詞的接續法一樣。",
      "examples": [
        {
          "id": "L45-S01",
          "ruby": [
            { "b": "会議", "r": "かいぎ" },
            { "b": "に " },
            { "b": "間", "r": "ま" },
            { "b": "に " },
            { "b": "合", "r": "あ" },
            { "b": "わない " },
            { "b": "場合", "r": "ばあい" },
            { "b": "は、" },
            { "b": "連絡", "r": "れんらく" },
            { "b": "して ください。" }
          ],
          "translation": "如果趕不上會議時,請和我連絡。"
        },
        {
          "id": "L45-S02",
          "ruby": [
            { "b": "時間", "r": "じかん" },
            { "b": "に " },
            { "b": "遅", "r": "おく" },
            { "b": "れた " },
            { "b": "場合", "r": "ばあい" },
            { "b": "は、" },
            { "b": "会場", "r": "かいじょう" },
            { "b": "に " },
            { "b": "入", "r": "はい" },
            { "b": "れません。" }
          ],
          "translation": "如果誤了時間的話,就進不了會場。"
        },
        {
          "id": "L45-S03",
          "ruby": [
            { "b": "ファクスの " },
            { "b": "調子", "r": "ちょうし" },
            { "b": "が " },
            { "b": "悪", "r": "わる" },
            { "b": "い " },
            { "b": "場合", "r": "ばあい" },
            { "b": "は、どう したら いいですか。" }
          ],
          "translation": "傳真機的狀態不太好時,該怎麼辦呢？"
        },
        {
          "id": "L45-S04",
          "ruby": [
            { "b": "領収書", "r": "りょうしゅうしょ" },
            { "b": "が " },
            { "b": "必要", "r": "ひつよう" },
            { "b": "な " },
            { "b": "場合", "r": "ばあい" },
            { "b": "は、" },
            { "b": "係", "r": "かかり" },
            { "b": "に " },
            { "b": "言", "r": "い" },
            { "b": "って ください。" }
          ],
          "translation": "需要收據時,請和工作人員說一聲。"
        },
        {
          "id": "L45-S05",
          "ruby": [
            { "b": "火事", "r": "かじ" },
            { "b": "や " },
            { "b": "地震", "r": "じしん" },
            { "b": "の " },
            { "b": "場合", "r": "ばあい" },
            { "b": "は、エレベーターを " },
            { "b": "使", "r": "つか" },
            { "b": "わないで ください。" }
          ],
          "translation": "遇到火災或地震時,請不要使用電梯。"
        }
      ]
    },
    {
      "id": "L45-G02",
      "pattern": "〜のに、〜",
      "explanation": "「のに」可以接在動詞、形容詞、名詞的任何一種之後。「のに」用於從前半部分來看理所當然的情況,但在後半部分卻出現了預料之外的結果時。後半部一般都含有意外或不滿的心情。「〜のに」和「〜が」／「〜ても」不同,只能表示既定的事情,且後半部可為非常強烈的責難表達方式,此時也不能用「〜が」「〜ても」替換。",
      "examples": [
        {
          "id": "L45-S06",
          "ruby": [
            { "b": "約束", "r": "やくそく" },
            { "b": "を したのに、" },
            { "b": "彼女", "r": "かのじょ" },
            { "b": "は " },
            { "b": "来", "r": "き" },
            { "b": "ませんでした。" }
          ],
          "translation": "事先約好了,她卻沒來。"
        },
        {
          "id": "L45-S07",
          "ruby": [
            { "b": "きょうは " },
            { "b": "日曜日", "r": "にちようび" },
            { "b": "なのに、" },
            { "b": "働", "r": "はたら" },
            { "b": "かなければ なりません。" }
          ],
          "translation": "今天是星期天,卻必須工作。"
        },
        {
          "id": "L45-S08",
          "ruby": [
            { "b": "わたしの " },
            { "b": "部屋", "r": "へや" },
            { "b": "は " },
            { "b": "狭", "r": "せま" },
            { "b": "いですが、きれいです。" }
          ],
          "translation": "我的房間雖小,但是很乾淨。"
        },
        {
          "id": "L45-S09",
          "ruby": [
            { "b": "あした " },
            { "b": "雨", "r": "あめ" },
            { "b": "が " },
            { "b": "降", "r": "ふ" },
            { "b": "っても、" },
            { "b": "出", "r": "で" },
            { "b": "かけます。" }
          ],
          "translation": "即使明天下雨也要出去。"
        },
        {
          "id": "L45-S10",
          "ruby": [
            { "b": "約束", "r": "やくそく" },
            { "b": "を したのに、どうして " },
            { "b": "来", "r": "こ" },
            { "b": "なかったんですか。" }
          ],
          "translation": "明明約好了,為什麼沒來。"
        }
      ]
    }
  ],
  "dialogues": [
    {
