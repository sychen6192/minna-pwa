      "id": "L19-D03",
      "ruby": [
        { "b": "ええ。" },
        { "b": "実", "r": "じつ" },
        { "b": "は きのうから ダイエットを して います。" }
      ],
      "translation": "嗯。老實說，我從昨天開始減肥了。",
      "speaker": "マリア"
    },
    {
      "id": "L19-D04",
      "ruby": [
        { "b": "そうですか。わたしも " },
        { "b": "何回", "r": "なんかい" },
        { "b": "も ダイエットを した ことが あります。" }
      ],
      "translation": "這樣啊。我也減過好幾次肥呢。",
      "speaker": "松本良子"
    },
    {
      "id": "L19-D05",
      "ruby": [{ "b": "どんな ダイエットですか。" }],
      "translation": "是什麼樣的減肥法呢？",
      "speaker": "マリア"
    },
    {
      "id": "L19-D06",
      "ruby": [
        { "b": "毎日", "r": "まいにち" },
        { "b": " りんごだけ " },
        { "b": "食", "r": "た" },
        { "b": "べたり、" },
        { "b": "水", "r": "みず" },
        { "b": "を たくさん " },
        { "b": "飲", "r": "の" },
        { "b": "んだり しました。" }
      ],
      "translation": "每天只吃蘋果、喝很多水之類的。",
      "speaker": "松本良子"
    },
    {
      "id": "L19-D07",
      "ruby": [
        { "b": "しかし、" },
        { "b": "無理", "r": "むり" },
        { "b": "な ダイエットは " },
        { "b": "体", "r": "からだ" },
        { "b": "に よくないですよ。" }
      ],
      "translation": "可是，勉強的減肥對身體不好喔。",
      "speaker": "松本部長"
    },
    {
      "id": "L19-D08",
      "ruby": [{ "b": "そうですね。" }],
      "translation": "說的也是。",
      "speaker": "マリア"
    },
    {
      "id": "L19-D09",
      "ruby": [
        { "b": "マリアさん、この ケーキ、おいしいですよ。" }
      ],
      "translation": "瑪麗亞小姐，這個蛋糕很好吃喔。",
      "speaker": "松本良子"
    },
    {
      "id": "L19-D10",
      "ruby": [
        { "b": "そうですか。……。ダイエットは また あしたから します。" }
      ],
      "translation": "這樣啊。……。減肥還是從明天開始吧。",
      "speaker": "マリア"
    }
  ]
}
