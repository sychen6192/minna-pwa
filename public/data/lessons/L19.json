  "grammar": [
    {
      "id": "L19-G01",
      "pattern": "動詞 た形",
      "explanation": "本課學習た形。動詞た形的變化如下。（參考初級Ⅱ本冊70頁第19課練習A1）た形是將て形的「て、で」分別改成「た、だ」就行了。Ⅰ類:かいて→かいた、のんで→のんだ;Ⅱ類:たべて→たべた;Ⅲ類:きて→きた、して→した。",
      "examples": [
        {
          "id": "L19-S01",
          "ruby": [{ "b": "かいて" }],
          "translation": "（て形）寫"
        },
        {
          "id": "L19-S02",
          "ruby": [{ "b": "かいた" }],
          "translation": "（た形）寫了"
        }
      ]
    },
    {
      "id": "L19-G02",
      "pattern": "動詞 た形 ことが あります",
      "explanation": "在敘述過去體驗過的事情時,用這個句型來表達。這個句型和第9課學過「わたしは 名詞が あります」的句子基本上相同。經驗的內容用「動詞た形こと」這個名詞子句來表示。要注意這個句型和單純表示過去某一時間做了某個動作的句子不同。",
      "examples": [
        {
          "id": "L19-S03",
          "ruby": [
            { "b": "馬", "r": "うま" },
            { "b": "に " },
            { "b": "乗", "r": "の" },
            { "b": "った ことが あります。" }
          ],
          "translation": "我騎過馬。"
        },
        {
          "id": "L19-S04",
          "ruby": [
            { "b": "去年", "r": "きょねん" },
            { "b": " " },
            { "b": "北海道", "r": "ほっかいどう" },
            { "b": "で " },
            { "b": "馬", "r": "うま" },
            { "b": "に " },
            { "b": "乗", "r": "の" },
            { "b": "りました。" }
          ],
          "translation": "去年在北海道騎了馬。"
        }
      ]
    },
    {
      "id": "L19-G03",
      "pattern": "動詞 た形 り、動詞 た形 り します",
      "explanation": "在第10課學過從很多事物或人之中選取幾個敘述的句型（〜や 〜［など］）。而這裡則是從很多動作中選取幾個敘述時的句型。時態在句尾表示。〔註〕這個句型和16課學過的「動詞て形、動詞て形、動詞」句型意思不同,注意不要混淆。例句⑤中打完網球後再看電影的動作很明顯,而例句④裡則列舉了星期天做的事情中有打網球、看電影,只是暗示還做了別的事情,二者之間沒有時間上的關聯。此外,用「〜たり 〜たり します」句型表示每天一定會做的事情（如早上起床、吃飯、晚上睡覺等）並不自然。",
      "examples": [
        {
          "id": "L19-S05",
          "ruby": [
            { "b": "日曜日", "r": "にちようび" },
            { "b": "は テニスを したり、" },
            { "b": "映画", "r": "えいが" },
            { "b": "を " },
            { "b": "見", "r": "み" },
            { "b": "たり します。" }
          ],
          "translation": "星期天要打網球、看電影。"
        },
        {
          "id": "L19-S06",
          "ruby": [
            { "b": "日曜日", "r": "にちようび" },
            { "b": "は テニスを したり、" },
            { "b": "映画", "r": "えいが" },
            { "b": "を " },
            { "b": "見", "r": "み" },
            { "b": "たり しました。" }
          ],
          "translation": "星期天打了網球、看了電影。"
        },
        {
          "id": "L19-S07",
          "ruby": [
            { "b": "日曜日", "r": "にちようび" },
            { "b": "は テニスを して、" },
            { "b": "映画", "r": "えいが" },
            { "b": "を " },
            { "b": "見", "r": "み" },
            { "b": "ました。" }
          ],
          "translation": "星期天打網球後,看了電影。"
        }
      ]
    },
    {
      "id": "L19-G04",
      "pattern": "い形容詞（〜く）／な形容詞・名詞（に）なります",
      "explanation": "「なります」表示狀態的變化。い形容詞〜い→〜く、な形容詞［な］→に、名詞→に,再接「なります」,表示「變成…」。",
      "examples": [
        {
          "id": "L19-S08",
          "ruby": [
            { "b": "寒", "r": "さむ" },
            { "b": "い → " },
            { "b": "寒", "r": "さむ" },
            { "b": "く なります" }
          ],
          "translation": "變冷"
        },
        {
          "id": "L19-S09",
          "ruby": [
            { "b": "元気", "r": "げんき" },
            { "b": "［な］ → " },
            { "b": "元気", "r": "げんき" },
            { "b": "に なります" }
          ],
          "translation": "變健康"
        },
        {
          "id": "L19-S10",
          "ruby": [
            { "b": "25" },
            { "b": "歳", "r": "さい" },
            { "b": " → 25" },
            { "b": "歳", "r": "さい" },
            { "b": "に なります" }
          ],
          "translation": "即將25歲"
        }
      ]
    },
    {
      "id": "L19-G05",
      "pattern": "そうですね",
      "explanation": "「そうですね」表示同意對方說的話或有同感。同樣的句子還有下降調的「そうですか」（參考第2課6.）。「そうですか」是得到未知的資訊,而接受或感嘆的表達,而「そうですね」,則是在對方提到自己也作如是想或知道的事情時,表示同意或同感的用法。",
      "examples": [
        {
          "id": "L19-S11",
          "ruby": [
            { "b": "寒", "r": "さむ" },
            { "b": "く なりましたね。" }
          ],
          "translation": "變冷了哦!"
        },
        {
          "id": "L19-S12",
          "ruby": [{ "b": "…そうですね。" }],
          "translation": "…真是耶!"
        }
      ]
    }
  ],
