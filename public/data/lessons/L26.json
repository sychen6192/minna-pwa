  "grammar": [
    {
      "id": "L26-G01",
      "pattern": "〜んです",
      "explanation": "「〜んです」是強調說明原因、理由、根據等的表達方式。口語中用「〜んです」，而文章語中則用「〜のです」。接續:動詞、い形容詞用普通形;な形容詞、名詞用普通形，但「〜だ」要改為「〜な」。1）〜んですか:(1)說話人對於看到、聽到的事，推測理由和原因並進行確認時;(2)對看到、聽到的事實尋求更詳細的說明時;(3)向聽話人詢問理由和原因時;(4)尋求對事態的說明時。〔註〕「〜んですか」句中有時包含說話人驚訝或懷疑的情緒及強烈的好奇心，用得不恰當會使聽話人不高興，要注意使用方法。2）〜んです:(1)回答1）的(3)、(4)的疑問句並說明理由和原因時;(2)說話人對自己說的話附加理由和原因時。〔註〕只是說明事實時不用「〜んです」(例:×わたしは マイク・ミラーなんです)。",
      "examples": [
        {
          "id": "L26-S01",
          "ruby": [
            { "b": "渡辺", "r": "わたなべ" },
            { "b": "さんは " },
            { "b": "時々", "r": "ときどき" },
            { "b": "大阪弁", "r": "おおさかべん" },
            { "b": "を " },
            { "b": "使", "r": "つか" },
            { "b": "いますね。" },
            { "b": "大阪", "r": "おおさか" },
            { "b": "に " },
            { "b": "住", "r": "す" },
            { "b": "んで いたんですか。" }
          ],
          "translation": "渡邊小姐有時說大阪方言呢。在大阪住過嗎？"
        },
        {
          "id": "L26-S02",
          "ruby": [
            { "b": "…ええ、15" },
            { "b": "歳", "r": "さい" },
            { "b": "まで " },
            { "b": "大阪", "r": "おおさか" },
            { "b": "に " },
            { "b": "住", "r": "す" },
            { "b": "んで いました。" }
          ],
          "translation": "…對，我 15 歲以前住在大阪。"
        },
        {
          "id": "L26-S03",
          "ruby": [
            { "b": "おもしろい デザインの " },
            { "b": "靴", "r": "くつ" },
            { "b": "ですね。どこで " },
            { "b": "買", "r": "か" },
            { "b": "ったんですか。" }
          ],
          "translation": "真是樣式別緻的鞋呀，在哪裡買的呢？"
        },
        {
          "id": "L26-S04",
          "ruby": [
            { "b": "…エドヤストアで " },
            { "b": "買", "r": "か" },
            { "b": "いました。" }
          ],
          "translation": "…在愛多雅商店買的。"
        },
        {
          "id": "L26-S05",
          "ruby": [
            { "b": "どうして " },
            { "b": "遅", "r": "おく" },
            { "b": "れたんですか。" }
          ],
          "translation": "為什麼遲到了？"
        },
        {
          "id": "L26-S06",
          "ruby": [{ "b": "どう したんですか。" }],
          "translation": "怎麼了？"
        },
        {
          "id": "L26-S07",
          "ruby": [
            { "b": "どうして " },
            { "b": "遅", "r": "おく" },
            { "b": "れたんですか。" }
          ],
          "translation": "為什麼遲到了？"
        },
        {
          "id": "L26-S08",
          "ruby": [
            { "b": "…バスが " },
            { "b": "来", "r": "こ" },
            { "b": "なかったんです。" }
          ],
          "translation": "…公共汽車沒來。"
        },
        {
          "id": "L26-S09",
          "ruby": [{ "b": "どう したんですか。" }],
          "translation": "怎麼了？"
        },
        {
          "id": "L26-S10",
          "ruby": [
            { "b": "…ちょっと " },
            { "b": "気分", "r": "きぶん" },
            { "b": "が " },
            { "b": "悪", "r": "わる" },
            { "b": "いんです。" }
          ],
          "translation": "…有點不舒服。"
        },
        {
          "id": "L26-S11",
          "ruby": [
            { "b": "毎朝", "r": "まいあさ" },
            { "b": "新聞", "r": "しんぶん" },
            { "b": "を " },
            { "b": "読", "r": "よ" },
            { "b": "みますか。" }
          ],
          "translation": "你每天早上看報紙嗎？"
        },
        {
          "id": "L26-S12",
          "ruby": [
            { "b": "…いいえ。" },
            { "b": "時間", "r": "じかん" },
            { "b": "が ないんです。" }
          ],
          "translation": "…不，沒有時間。"
        }
      ]
    },
    {
      "id": "L26-G02",
      "pattern": "〜んですが、〜",
      "explanation": "「〜んですが」有著提起話題的作用。後面一般接表示委託、勸誘或請求許可的詞，這時的「が」起著連接上下文的作用，表示猶疑和客氣。如⑩所示，「〜んですが」後面接續的詞，如果是說話人和聽話人都明白時多省略掉。",
      "examples": [
        {
          "id": "L26-S13",
          "ruby": [
            { "b": "日本語", "r": "にほんご" },
            { "b": "で " },
            { "b": "手紙", "r": "てがみ" },
            { "b": "を " },
            { "b": "書", "r": "か" },
            { "b": "いたんですが、ちょっと " },
            { "b": "見", "r": "み" },
            { "b": "て いただけませんか。" }
          ],
          "translation": "我用日語寫了封信，您能幫我看看嗎？"
        },
        {
          "id": "L26-S14",
          "ruby": [
            { "b": "ＮＨＫを " },
            { "b": "見学", "r": "けんがく" },
            { "b": "したいんですが、どう したら いいですか。" }
          ],
          "translation": "我想參觀 ＮＨＫ，應該怎麼辦呢？"
        },
        {
          "id": "L26-S15",
          "ruby": [
            { "b": "お" },
            { "b": "湯", "r": "ゆ" },
            { "b": "が " },
            { "b": "出", "r": "で" },
            { "b": "ないんですが……。" }
          ],
          "translation": "還沒有熱水……。"
        }
      ]
    },
    {
      "id": "L26-G03",
      "pattern": "動詞て形 いただけませんか",
      "explanation": "這是比「〜て ください」更禮貌的請求表達方式，意為「能幫我…嗎？」。",
      "examples": [
        {
          "id": "L26-S16",
          "ruby": [
            { "b": "いい " },
            { "b": "先生", "r": "せんせい" },
            { "b": "を " },
            { "b": "紹介", "r": "しょうかい" },
            { "b": "して いただけませんか。" }
          ],
          "translation": "您能幫我介紹一位好老師嗎？"
        }
      ]
    },
    {
      "id": "L26-G04",
      "pattern": "疑問詞 動詞た形ら いいですか",
      "explanation": "「〜たら いいですか」是說話人對自己應做或最好去做的事，徵求聽話人的建議或指示的表達方式，意為「…做才好呢？」。換句話說，⑫中說話人想買相機，但不知道在哪裡買，所以這個句子是希望聽話人推薦一個能買照相機的好商店。",
      "examples": [
        {
          "id": "L26-S17",
          "ruby": [
            { "b": "どこで カメラを " },
            { "b": "買", "r": "か" },
            { "b": "ったら いいですか。" }
          ],
          "translation": "在哪裡買照相機好呢？"
        },
        {
          "id": "L26-S18",
          "ruby": [
            { "b": "細", "r": "こま" },
            { "b": "かい お " },
            { "b": "金", "r": "かね" },
            { "b": "が ないんですが、どう したら いいですか。" }
          ],
          "translation": "我沒有零錢，該怎麼辦呢？"
        }
      ]
    },
    {
      "id": "L26-G05",
      "pattern": "名詞（目的）は 好きです／嫌いです、上手です／下手です、あります",
      "explanation": "將主語或以「を」表示的受詞，以助詞「は」提示為主題的用法，在初級Ⅰ、初級Ⅱ中已經學過（第10課、第17課）。「が」所表示的受詞，也可以用助詞「は」將其提示為主題。",
      "examples": [
        {
          "id": "L26-S19",
          "ruby": [
            { "b": "運動会", "r": "うんどうかい" },
            { "b": "に " },
            { "b": "参加", "r": "さんか" },
            { "b": "しますか。" }
          ],
          "translation": "你會參加運動會嗎？"
        },
        {
          "id": "L26-S20",
          "ruby": [
            { "b": "…いいえ。スポーツは あまり " },
            { "b": "好", "r": "す" },
            { "b": "きじゃ ないんです。" }
          ],
          "translation": "…不，我不太喜歡運動。"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L26-D01",
      "ruby": [
        { "b": "ミラーさん、" },
        { "b": "引", "r": "ひ" },
        { "b": "っ" },
        { "b": "越", "r": "こ" },
        { "b": "しの " },
        { "b": "荷物", "r": "にもつ" },
        { "b": "は " },
        { "b": "片", "r": "かた" },
        { "b": "づきましたか。" }
      ],
      "translation": "米勒先生，搬家的行李收拾好了嗎？",
      "speaker": "管理人"
    },
    {
      "id": "L26-D02",
      "ruby": [
        { "b": "はい、だいたい " },
        { "b": "片", "r": "かた" },
        { "b": "づきました。あのう、ごみを " },
        { "b": "捨", "r": "す" },
        { "b": "てたいんですが、どこに " },
        { "b": "出", "r": "だ" },
        { "b": "したら いいですか。" }
      ],
      "translation": "好的，大致上收拾好了。那個，我想丟垃圾，要丟在哪裡才好呢？",
      "speaker": "ミラー"
    },
    {
      "id": "L26-D03",
      "ruby": [
        { "b": "燃", "r": "も" },
        { "b": "える ごみは " },
        { "b": "月", "r": "げつ" },
        { "b": "・" },
        { "b": "水", "r": "すい" },
        { "b": "・" },
        { "b": "金", "r": "きん" },
        { "b": "の " },
        { "b": "朝", "r": "あさ" },
        { "b": "出", "r": "だ" },
        { "b": "して ください。ごみ" },
        { "b": "置", "r": "お" },
        { "b": "き" },
        { "b": "場", "r": "ば" },
        { "b": "は " },
        { "b": "駐車場", "r": "ちゅうしゃじょう" },
        { "b": "の " },
        { "b": "横", "r": "よこ" },
        { "b": "です。" }
      ],
      "translation": "可燃垃圾請在星期一、三、五的早上丟。垃圾放置處在停車場的旁邊。",
      "speaker": "管理人"
    },
    {
      "id": "L26-D04",
      "ruby": [
        { "b": "瓶", "r": "びん" },
        { "b": "や " },
        { "b": "缶", "r": "かん" },
        { "b": "は いつですか。" }
      ],
      "translation": "瓶子和罐子是什麼時候呢？",
      "speaker": "ミラー"
    },
    {
      "id": "L26-D05",
      "ruby": [
        { "b": "燃", "r": "も" },
        { "b": "えない ごみは " },
        { "b": "土曜日", "r": "どようび" },
        { "b": "です。" }
      ],
      "translation": "不可燃垃圾是星期六。",
      "speaker": "管理人"
    },
    {
      "id": "L26-D06",
      "ruby": [
        { "b": "はい、わかりました。それから、お" },
        { "b": "湯", "r": "ゆ" },
        { "b": "が " },
        { "b": "出", "r": "で" },
        { "b": "ないんですが……。" }
      ],
      "translation": "好的，我知道了。還有，沒有熱水……。",
      "speaker": "ミラー"
    },
    {
      "id": "L26-D07",
      "ruby": [
        { "b": "ガス" },
        { "b": "会社", "r": "がいしゃ" },
        { "b": "に " },
        { "b": "連絡", "r": "れんらく" },
        { "b": "したら、すぐ " },
        { "b": "来", "r": "き" },
        { "b": "て くれますよ。" }
      ],
      "translation": "聯絡瓦斯公司的話，他們馬上就會來喔。",
      "speaker": "管理人"
    },
    {
      "id": "L26-D08",
      "ruby": [
        { "b": "……" },
        { "b": "困", "r": "こま" },
        { "b": "ったなあ。" },
        { "b": "電話", "r": "でんわ" },
        { "b": "が ないんです。すみませんが、" },
        { "b": "連絡", "r": "れんらく" },
        { "b": "して いただけませんか。" }
      ],
      "translation": "……怎麼辦呢。我沒有電話。不好意思，能請您幫我聯絡嗎？",
      "speaker": "ミラー"
    },
    {
      "id": "L26-D09",
      "ruby": [{ "b": "ええ、いいですよ。" }],
      "translation": "好的，沒問題喔。",
      "speaker": "管理人"
    },
    {
      "id": "L26-D10",
      "ruby": [
        { "b": "すみません。お" },
        { "b": "願", "r": "ねが" },
        { "b": "いします。" }
      ],
      "translation": "謝謝。麻煩您了。",
      "speaker": "ミラー"
    }
  ]
}
