  "grammar": [
    {
      "id": "L48-G01",
      "pattern": "使役動詞",
      "explanation": "使役動詞的變換方法:第Ⅰ類動詞將ます形語幹的最後一音改為あ段音再加「せます」(行きます→行かせます);第Ⅱ類動詞加「させます」(食べます→食べさせます);第Ⅲ類「来ます→来させます」、「します→させます」。所有的使役動詞都屬於第2類動詞，按字典形、ない形、て形等變化。例:いかせる、いかせ（ない）、いかせて。",
      "examples": [
        {
          "id": "L48-S01",
          "ruby": [
            { "b": "行", "r": "い" },
            { "b": "きます → " },
            { "b": "行", "r": "い" },
            { "b": "かせます" }
          ],
          "translation": "去 → 讓（某人）去"
        },
        {
          "id": "L48-S02",
          "ruby": [
            { "b": "食", "r": "た" },
            { "b": "べます → " },
            { "b": "食", "r": "た" },
            { "b": "べさせます" }
          ],
          "translation": "吃 → 讓（某人）吃"
        },
        {
          "id": "L48-S03",
          "ruby": [
            { "b": "来", "r": "き" },
            { "b": "ます → " },
            { "b": "来", "r": "こ" },
            { "b": "させます" }
          ],
          "translation": "來 → 讓（某人）來"
        }
      ]
    },
    {
      "id": "L48-G02",
      "pattern": "名詞(人)を 使役動詞(自動詞)／名詞(人)に 名詞を 使役動詞(他動詞)",
      "explanation": "使役動詞中，動詞表示的動作主體，有用「を」來表示和用「に」來表示等二種。1)中原來的動詞屬於自動詞時用「を」;如2)所示屬他動詞時，不管是否敘述這個動詞的述語，都用「に」來表示。〔註〕作為例外，自動詞而且用「名詞(場所)を」的詞，要像③一樣，用「に」來表示動作的主體。如果句中沒有採用「を」時，則要像④一樣，動作的主體仍然按照原則使用「を」來表示。",
      "examples": [
        {
          "id": "L48-S04",
          "ruby": [
            { "b": "部長", "r": "ぶちょう" },
            { "b": "は " },
            { "b": "加藤", "r": "かとう" },
            { "b": "さんを " },
            { "b": "大阪", "r": "おおさか" },
            { "b": "へ " },
            { "b": "出張", "r": "しゅっちょう" },
            { "b": "させます。" }
          ],
          "translation": "部長讓加藤去大阪出差。"
        },
        {
          "id": "L48-S05",
          "ruby": [
            { "b": "わたしは " },
            { "b": "娘", "r": "むすめ" },
            { "b": "を " },
            { "b": "自由", "r": "じゆう" },
            { "b": "に " },
            { "b": "遊", "r": "あそ" },
            { "b": "ばせました。" }
          ],
          "translation": "我讓女兒自由地玩。"
        },
        {
          "id": "L48-S06",
          "ruby": [
            { "b": "わたしは " },
            { "b": "子", "r": "こ" },
            { "b": "どもに " },
            { "b": "道", "r": "みち" },
            { "b": "の " },
            { "b": "右側", "r": "みぎがわ" },
