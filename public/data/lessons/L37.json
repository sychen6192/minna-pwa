  "grammar": [
    {
      "id": "L37-G01",
      "pattern": "被動動詞",
      "explanation": "被動動詞的變換方法（參考進階Ⅰ本冊136頁第37課練習A1）。Ⅰ類:かきます→かかれます;Ⅱ類:ほめます→ほめられます;Ⅲ類:きます→こられます、します→されます。被動動詞全部是Ⅱ類動詞，有字典形、ない形、て形等變化形式。例如:かかれる、かかれ（ない）、かかれて。",
      "examples": [
        {
          "id": "L37-S00",
          "ruby": [
            { "b": "わたしは " },
            { "b": "犬", "r": "いぬ" },
            { "b": "に かまれました。" }
          ],
          "translation": "我被狗咬了。"
        }
      ]
    },
    {
      "id": "L37-G02",
      "pattern": "名詞1（人物1）は 名詞2（人物2）に 被動動詞",
      "explanation": "這個句型是人物2對人物1進行的動作，從受動人物1的立場敘述的句型。用被動動詞的被動句的主題是人物1，施動者（人物2）用助詞に來表示。施動者（名詞2）也可以是人以外能動的東西（動物或車等）。",
      "examples": [
        {
          "id": "L37-S01",
          "ruby": [
            { "b": "わたしは " },
            { "b": "先生", "r": "せんせい" },
            { "b": "に " },
            { "b": "褒", "r": "ほ" },
            { "b": "められました。" }
          ],
          "translation": "我被老師讚美了。"
        },
        {
          "id": "L37-S02",
          "ruby": [
            { "b": "わたしは " },
            { "b": "母", "r": "はは" },
            { "b": "に " },
            { "b": "買", "r": "か" },
            { "b": "い" },
            { "b": "物", "r": "もの" },
            { "b": "を " },
            { "b": "頼", "r": "たの" },
            { "b": "まれました。" }
          ],
          "translation": "我被媽媽要求去買東西。"
        },
        {
          "id": "L37-S03",
          "ruby": [
            { "b": "わたしは " },
            { "b": "犬", "r": "いぬ" },
            { "b": "に かまれました。" }
          ],
          "translation": "我被狗咬了。"
        }
      ]
    },
    {
      "id": "L37-G03",
      "pattern": "名詞1（人物1）は 名詞2（人物2）に 名詞3を 被動動詞",
      "explanation": "這個句型表示人物2對人物1的所有物等（名詞3）進行某種行為，而這種行為對人物1來說大都會感到受害。這個句型與句型2一樣，施動者也可以是人以外能動的東西。〔註1〕這個句型中作為主題提出來的，不是動詞的受詞（名詞3），而是對該行為感受到困擾的人。〔註2〕由於這個句型表示受動者感到困擾的行為，所以對所受行為表示感謝時不能用，這時要用「〜て もらいます」。",
      "examples": [
        {
          "id": "L37-S04",
          "ruby": [
            { "b": "わたしは " },
            { "b": "弟", "r": "おとうと" },
            { "b": "に パソコンを " },
            { "b": "壊", "r": "こわ" },
            { "b": "されました。" }
          ],
          "translation": "我的電腦被弟弟弄壞了。"
        },
        {
          "id": "L37-S05",
          "ruby": [
            { "b": "わたしは " },
            { "b": "犬", "r": "いぬ" },
            { "b": "に " },
            { "b": "手", "r": "て" },
            { "b": "を かまれました。" }
          ],
          "translation": "我被狗咬了手。"
        },
        {
          "id": "L37-S06",
          "ruby": [
            { "b": "わたしは " },
            { "b": "友達", "r": "ともだち" },
            { "b": "に " },
            { "b": "自転車", "r": "じてんしゃ" },
            { "b": "を " },
            { "b": "修理", "r": "しゅうり" },
            { "b": "して もらいました。" }
          ],
          "translation": "我請朋友幫我修理了腳踏車。"
        }
      ]
    },
    {
      "id": "L37-G04",
      "pattern": "名詞（物／事）が／は 被動動詞",
      "explanation": "敘述某件事情時，如果不把重點放在行為者身上，就可以把物或事作為主語，用被動動詞來表達。",
      "examples": [
        {
          "id": "L37-S07",
          "ruby": [
            { "b": "フランスで " },
            { "b": "昔", "r": "むかし" },
            { "b": "の " },
            { "b": "日本", "r": "にほん" },
            { "b": "の " },
            { "b": "絵", "r": "え" },
            { "b": "が " },
            { "b": "発見", "r": "はっけん" },
            { "b": "されました。" }
          ],
          "translation": "在法國發現了日本古代的繪畫。"
        },
        {
          "id": "L37-S08",
          "ruby": [
            { "b": "日本", "r": "にほん" },
            { "b": "の " },
            { "b": "車", "r": "くるま" },
            { "b": "は " },
            { "b": "世界中", "r": "せかいじゅう" },
            { "b": "へ " },
            { "b": "輸出", "r": "ゆしゅつ" },
            { "b": "されて います。" }
          ],
          "translation": "日本的汽車出口到全世界。"
        },
        {
          "id": "L37-S09",
          "ruby": [
            { "b": "会議", "r": "かいぎ" },
            { "b": "は " },
            { "b": "神戸", "r": "こうべ" },
            { "b": "で " },
            { "b": "開", "r": "ひら" },
            { "b": "かれました。" }
          ],
          "translation": "會議在神戶召開。"
        }
      ]
    },
    {
      "id": "L37-G05",
      "pattern": "名詞1は 名詞2（人）に よって 被動動詞",
      "explanation": "表示創造或發現的動詞（例如:かきます、はつめいします、はっけんします等）用被動形式時，行為者不用「に」，而是用「に よって」來表示。",
      "examples": [
        {
          "id": "L37-S10",
          "ruby": [
            { "b": "「" },
            { "b": "源氏物語", "r": "げんじものがたり" },
            { "b": "」は " },
            { "b": "紫式部", "r": "むらさきしきぶ" },
            { "b": "に よって " },
            { "b": "書", "r": "か" },
            { "b": "かれました。" }
          ],
          "translation": "“源氏物語”是紫式部所寫的。"
        },
        {
          "id": "L37-S11",
          "ruby": [
            { "b": "電話", "r": "でんわ" },
            { "b": "は ベルに よって " },
            { "b": "発明", "r": "はつめい" },
            { "b": "されました。" }
          ],
          "translation": "電話是貝爾發明的。"
        }
      ]
    },
    {
      "id": "L37-G06",
      "pattern": "名詞から／名詞で つくります",
      "explanation": "製造東西時，原料用「から」，材料用「で」表示。",
      "examples": [
        {
          "id": "L37-S12",
          "ruby": [
            { "b": "ビールは " },
            { "b": "麦", "r": "むぎ" },
            { "b": "から " },
            { "b": "造", "r": "つく" },
            { "b": "られます。" }
          ],
          "translation": "啤酒是用麥子釀造的。"
        },
        {
          "id": "L37-S13",
          "ruby": [
            { "b": "昔", "r": "むかし" },
            { "b": " " },
            { "b": "日本", "r": "にほん" },
            { "b": "の " },
            { "b": "家", "r": "いえ" },
            { "b": "は " },
            { "b": "木", "r": "き" },
            { "b": "で " },
            { "b": "造", "r": "つく" },
            { "b": "られました。" }
          ],
          "translation": "古代日本的房子是用木材建造的。"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L37-D01",
      "ruby": [
        { "b": "シュミットさん、" },
        { "b": "関西空港", "r": "かんさいくうこう" },
        { "b": "は " },
        { "b": "初", "r": "はじ" },
        { "b": "めてですか。" }
      ],
      "translation": "施密特先生，這是您第一次來關西機場嗎？",
      "speaker": "松本"
    },
    {
      "id": "L37-D02",
      "ruby": [
        { "b": "ええ。ほんとうに " },
        { "b": "海", "r": "うみ" },
        { "b": "の " },
        { "b": "上", "r": "うえ" },
        { "b": "に あるんですね。" }
      ],
      "translation": "是的。它真的位在海上呢。",
      "speaker": "シュミット"
    },
    {
      "id": "L37-D03",
      "ruby": [
        { "b": "ええ。ここは " },
        { "b": "海", "r": "うみ" },
        { "b": "を " },
        { "b": "埋", "r": "う" },
        { "b": "め " },
        { "b": "立", "r": "た" },
        { "b": "てて " },
        { "b": "造", "r": "つく" },
        { "b": "られた " },
        { "b": "島", "r": "しま" },
        { "b": "なんです。" }
      ],
      "translation": "是的。這裡是填海造出來的島。",
      "speaker": "松本"
    },
    {
      "id": "L37-D04",
      "ruby": [
        { "b": "すごい " },
        { "b": "技術", "r": "ぎじゅつ" },
        { "b": "ですね。でも、どうして " },
        { "b": "海", "r": "うみ" },
        { "b": "の " },
        { "b": "上", "r": "うえ" },
        { "b": "に " },
        { "b": "造", "r": "つく" },
        { "b": "ったんですか。" }
      ],
      "translation": "真是了不起的技術呢。不過，為什麼要建在海上呢？",
      "speaker": "シュミット"
    },
    {
      "id": "L37-D05",
      "ruby": [
        { "b": "日本", "r": "にほん" },
        { "b": "は " },
        { "b": "土地", "r": "とち" },
        { "b": "が " },
        { "b": "狭", "r": "せま" },
        { "b": "いし、それに " },
        { "b": "海", "r": "うみ" },
        { "b": "の " },
        { "b": "上", "r": "うえ" },
        { "b": "なら、" },
        { "b": "騒音", "r": "そうおん" },
        { "b": "の " },
        { "b": "問題", "r": "もんだい" },
        { "b": "が ありませんからね。" }
      ],
