  "grammar": [
    {
      "id": "L39-G01",
      "pattern": "〜て、〜（原因・感情）",
      "explanation": "動詞て形／動詞ない形（〜なくて）／い形容詞（〜くて）／な形容詞（〜で）。這個句型前半部分表示原因，後半部分表示由這個原因引起的結果，這種形式和第9課中學的「〜から」不一樣，有很多限制。1)句型的後半部分可接的表現形式，主要為以下所列舉與意志無關的詞彙：(1)表示感情的動詞、形容詞（びっくりする、あんしんする、こまる、さびしい、うれしい、ざんねんだ等）；(2)可能動詞、表示狀態的動詞；(3)過去的狀況。2)後半部分不能使用含有意志的表現形式（意志、命令、勸誘、委託），若是含有意志的話，要用「〜から」。3)這個句型中前半部分和後半部分有時間上的先後關係，即先有前半的事情，後有後半的事情。",
      "examples": [
        {
          "id": "L39-S01",
          "ruby": [
            { "b": "ニュースを " },
            { "b": "聞", "r": "き" },
            { "b": "いて、びっくりしました。" }
          ],
          "translation": "聽到新聞後吃了一驚。"
        },
        {
          "id": "L39-S02",
          "ruby": [
            { "b": "家族", "r": "かぞく" },
            { "b": "に " },
            { "b": "会", "r": "あ" },
            { "b": "えなくて、" },
            { "b": "寂", "r": "さび" },
            { "b": "しいです。" }
          ],
          "translation": "見不到家人，很寂寞。"
        },
        {
          "id": "L39-S03",
          "ruby": [
            { "b": "土曜日", "r": "どようび" },
            { "b": "は " },
            { "b": "都合", "r": "つごう" },
            { "b": "が " },
            { "b": "悪", "r": "わる" },
            { "b": "くて、" },
            { "b": "行", "r": "い" },
            { "b": "けません。" }
          ],
          "translation": "星期六我有事，不能去。"
        },
        {
          "id": "L39-S04",
          "ruby": [
            { "b": "話", "r": "はなし" },
            { "b": "が " },
            { "b": "複雑", "r": "ふくざつ" },
            { "b": "で、よく わかりませんでした。" }
          ],
          "translation": "故事很複雜，看不太懂。"
        },
        {
          "id": "L39-S05",
          "ruby": [
            { "b": "事故", "r": "じこ" },
            { "b": "が あって、バスが " },
            { "b": "遅", "r": "おく" },
            { "b": "れて しまいました。" }
          ],
          "translation": "因為碰到車禍，公共汽車延誤了。"
        },
        {
          "id": "L39-S06",
          "ruby": [
            { "b": "授業", "r": "じゅぎょう" },
            { "b": "に " },
            { "b": "遅", "r": "おく" },
            { "b": "れて、" },
            { "b": "先生", "r": "せんせい" },
            { "b": "に しかられました。" }
          ],
          "translation": "上課遲到，被老師叱責。"
        }
      ]
    },
    {
      "id": "L39-G02",
      "pattern": "（名詞）で（原因）",
      "explanation": "這課學習的助詞「で」表示原因。這時使用的名詞中，像「じこ、じしん、かじ等」表示自然現象、事件、發生的事情等的詞比較多。述語部分和句型1一樣有限制，不能使用含有意志的表達方式。",
      "examples": [
        {
          "id": "L39-S07",
          "ruby": [
            { "b": "地震", "r": "じしん" },
            { "b": "で ビルが " },
            { "b": "倒", "r": "たお" },
            { "b": "れました。" }
          ],
          "translation": "因為地震，大廈倒塌了。"
        },
        {
          "id": "L39-S08",
          "ruby": [
            { "b": "病気", "r": "びょうき" },
            { "b": "で " },
            { "b": "会社", "r": "かいしゃ" },
            { "b": "を " },
            { "b": "休", "r": "やす" },
            { "b": "みました。" }
          ],
          "translation": "因病請假沒去公司。"
        }
      ]
    },
    {
      "id": "L39-G03",
      "pattern": "〜ので、〜",
      "explanation": "動詞／い形容詞接普通形，な形容詞・名詞接普通形（〜だ→〜な）＋ので。和第9課學過的「〜から」一樣，「〜ので」也表示原因、理由。相對於「〜から」的主觀陳述原因理由，「〜ので」可以說是客觀地陳述自然形成的因果關係，因為其抑制了說話者的主觀想法，對聽者的影響比較弱，所以作為請求許可時的理由及比較緩和地辯解時經常使用。因為這是一種比較緩和的表達方式，所以在句子的後半部分不能接命令以及禁止的形式。〔註〕「ので」要接普通形，但在需要更加禮貌地表達時，也可以接在禮貌形後。",
      "examples": [
        {
          "id": "L39-S09",
          "ruby": [
            { "b": "日本語", "r": "にほんご" },
            { "b": "が わからないので、" },
            { "b": "英語", "r": "えいご" },
            { "b": "で " },
            { "b": "話", "r": "はな" },
            { "b": "して いただけませんか。" }
          ],
          "translation": "我不懂日語，能否請您用英語講？"
        },
        {
          "id": "L39-S10",
          "ruby": [
            { "b": "用事", "r": "ようじ" },
            { "b": "が あるので、お " },
            { "b": "先", "r": "さき" },
            { "b": "に " },
            { "b": "失礼", "r": "しつれい" },
            { "b": "します。" }
          ],
          "translation": "因為有事，所以先告辭了。"
        },
        {
          "id": "L39-S11",
          "ruby": [
            { "b": "用事", "r": "ようじ" },
            { "b": "が ありますので、お " },
            { "b": "先", "r": "さき" },
            { "b": "に " },
            { "b": "失礼", "r": "しつれい" },
            { "b": "します。" }
          ],
          "translation": "因為有事，所以先告辭了。"
        }
      ]
    },
    {
      "id": "L39-G04",
      "pattern": "途中で",
      "explanation": "「とちゅうで」是朝某地移動期間的某個地點的意思，放在「動詞字典形」或者「名詞の」的後面。",
      "examples": [
        {
          "id": "L39-S12",
          "ruby": [
            { "b": "実", "r": "じつ" },
            { "b": "は " },
            { "b": "来", "r": "く" },
            { "b": "る " },
            { "b": "途中", "r": "とちゅう" },
            { "b": "で " },
            { "b": "事故", "r": "じこ" },
            { "b": "が あって、バスが " },
            { "b": "遅", "r": "おく" },
            { "b": "れて しまったんです。" }
          ],
          "translation": "其實在來這裡的途中碰到了車禍，公共汽車延誤了。"
        },
        {
          "id": "L39-S13",
          "ruby": [
            { "b": "マラソンの " },
            { "b": "途中", "r": "とちゅう" },
            { "b": "で " },
            { "b": "気分", "r": "きぶん" },
            { "b": "が " },
            { "b": "悪", "r": "わる" },
            { "b": "く なりました。" }
          ],
          "translation": "在馬拉松比賽的途中，不舒服起來。"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L39-D01",
      "ruby": [
        { "b": "課長", "r": "かちょう" },
