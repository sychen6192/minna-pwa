      ],
      "translation": "米勒先生，發生什麼事了？",
      "speaker": "中村課長"
    },
    {
      "id": "L39-D03",
      "ruby": [
        { "b": "実", "r": "じつ" },
        { "b": "は " },
        { "b": "来", "r": "く" },
        { "b": "る " },
        { "b": "途中", "r": "とちゅう" },
        { "b": "で " },
        { "b": "事故", "r": "じこ" },
        { "b": "が あって、バスが " },
        { "b": "遅", "r": "おく" },
        { "b": "れて しまったんです。" }
      ],
      "translation": "其實在來的途中發生了車禍，公車誤點了。",
      "speaker": "ミラー"
    },
    {
      "id": "L39-D04",
      "ruby": [
        { "b": "バスの " },
        { "b": "事故", "r": "じこ" },
        { "b": "ですか。" }
      ],
      "translation": "是公車的車禍嗎？",
      "speaker": "中村課長"
    },
    {
      "id": "L39-D05",
      "ruby": [
        { "b": "いいえ。" },
        { "b": "交差点", "r": "こうさてん" },
        { "b": "で トラックと " },
        { "b": "車", "r": "くるま" },
        { "b": "が ぶつかって、バスが " },
        { "b": "動", "r": "うご" },
        { "b": "かなかったんです。" }
      ],
      "translation": "不是。在十字路口卡車和汽車相撞，公車動彈不得。",
      "speaker": "ミラー"
    },
    {
      "id": "L39-D06",
      "ruby": [
        { "b": "それは " },
        { "b": "大変", "r": "たいへん" },
        { "b": "でしたね。" },
        { "b": "連絡", "r": "れんらく" },
        { "b": "が ないので、みんな " },
        { "b": "心配", "r": "しんぱい" },
        { "b": "して いたんですよ。" }
      ],
      "translation": "那真是辛苦你了。因為沒有聯絡，大家都很擔心呢。",
      "speaker": "中村課長"
    },
    {
      "id": "L39-D07",
      "ruby": [
