  "grammar": [
    {
      "id": "L02-G01",
      "pattern": "これ／それ／あれ",
      "explanation": "「これ」「それ」「あれ」是代表物的詞，在語法上作為名詞使用。「これ」是指在說話人附近的物，「それ」是指在聽話人附近的物，「あれ」是指離說話人和聽話人都遠的物。",
      "examples": [
        {
          "id": "L02-S01",
          "ruby": [
            { "b": "それは " },
            { "b": "辞書", "r": "じしょ" },
            { "b": "ですか。" }
          ],
          "translation": "那是字典嗎？"
        },
        {
          "id": "L02-S02",
          "ruby": [{ "b": "これを ください。" }],
          "translation": "請給我這個。"
        }
      ]
    },
    {
      "id": "L02-G02",
      "pattern": "この 名詞／その 名詞／あの 名詞",
      "explanation": "「この」「その」「あの」修飾名詞。「この 名詞」「その 名詞」「あの 名詞」分別表示在說話人附近的物（或人），在聽話人附近的物（或人），離雙方都遠的物（或人）。",
      "examples": [
        {
          "id": "L02-S03",
          "ruby": [
            { "b": "この " },
            { "b": "本", "r": "ほん" },
            { "b": "は わたしのです。" }
          ],
          "translation": "這本書是我的。"
        },
        {
          "id": "L02-S04",
          "ruby": [
            { "b": "あの " },
            { "b": "方", "r": "かた" },
            { "b": "は どなたですか。" }
          ],
          "translation": "那一位是誰？"
        }
      ]
    },
    {
      "id": "L02-G03",
      "pattern": "そうです／そうじゃ ありません",
      "explanation": "名詞句中，常常使用「そう」來回答詢問是否的疑問句。肯定回答用「はい、そうです」，否定回答用「いいえ、そうじゃ ありません」。還可以用和「そうじゃ ありません」意思相同的動詞「ちがいます」。",
      "examples": [
        {
          "id": "L02-S05",
          "ruby": [{ "b": "それは テレホンカードですか。" }],
          "translation": "那是電話卡嗎？"
        },
        {
          "id": "L02-S06",
          "ruby": [{ "b": "… はい、そうです。" }],
          "translation": "…是的。（對，它是。）"
        },
        {
          "id": "L02-S07",
          "ruby": [{ "b": "それは テレホンカードですか。" }],
          "translation": "那是電話卡嗎？"
        },
        {
          "id": "L02-S08",
          "ruby": [{ "b": "… いいえ、そうじゃ ありません。" }],
          "translation": "…不是。（不，它不是。）"
        },
        {
          "id": "L02-S09",
          "ruby": [{ "b": "それは テレホンカードですか。" }],
          "translation": "那是電話卡嗎？"
        },
        {
          "id": "L02-S10",
          "ruby": [
            { "b": "… いいえ、 " },
            { "b": "違", "r": "ちが" },
            { "b": "います。" }
          ],
          "translation": "…不，不是。"
        }
      ]
    },
    {
      "id": "L02-G04",
      "pattern": "句子 1か、句子 2か",
      "explanation": "這是將二個（以上）疑問句並列，並要求選擇正確一方的選擇疑問句。回答中不說「はい」「いいえ」，而是直接說出其中正確的句子。",
      "examples": [
        {
          "id": "L02-S11",
          "ruby": [{ "b": "これは 「 ９ 」 ですか、 「 ７ 」 ですか。" }],
          "translation": "這是“ ９ ”，還是“ ７ ”？"
        },
        {
          "id": "L02-S12",
          "ruby": [{ "b": "…「 ９ 」 です。" }],
          "translation": "…是 “ ９ ”。"
        }
      ]
    },
    {
      "id": "L02-G05",
      "pattern": "名詞 1 の 名詞 2",
      "explanation": "在第一課中學過當名詞1修飾名詞2時，名詞1和名詞2之間要用「の」。而再本課中，「の」將成為如下的意思。1)「名詞1」說明「名詞2」關係到的事物。2)「名詞1」說明「名詞2」屬於什麼人。名詞2在很明確的情況下可以省略。但是名詞2在表示人時不能省略。",
      "examples": [
        {
          "id": "L02-S13",
          "ruby": [
            { "b": "これは コンピューターの " },
            { "b": "本", "r": "ほん" },
            { "b": "です。" }
          ],
          "translation": "這是有關電腦的書。"
        },
        {
          "id": "L02-S14",
          "ruby": [
            { "b": "これは わたしの " },
            { "b": "本", "r": "ほん" },
            { "b": "です。" }
          ],
          "translation": "這是我的書。"
        },
        {
          "id": "L02-S15",
          "ruby": [{ "b": "あれは だれの かばんですか。" }],
          "translation": "那是誰的皮包？"
        },
        {
          "id": "L02-S16",
          "ruby": [
            { "b": "… " },
            { "b": "佐藤", "r": "さとう" },
            { "b": "さんの です。" }
          ],
          "translation": "…是佐藤小姐的。"
        },
        {
          "id": "L02-S17",
          "ruby": [{ "b": "この かばんは あなたのですか。" }],
          "translation": "這個皮包是你的嗎？"
        },
        {
          "id": "L02-S18",
          "ruby": [{ "b": "… いいえ、わたしのじゃ ありません。" }],
          "translation": "…不，不是我的。"
        },
        {
          "id": "L02-S19",
          "ruby": [
            { "b": "ミラーさんは IMCの " },
            { "b": "社員", "r": "しゃいん" },
            { "b": "ですか。" }
          ],
          "translation": "米勒先生是 IMC 公司的職員嗎？"
        },
        {
          "id": "L02-S20",
          "ruby": [
            { "b": "… はい、IMCの " },
            { "b": "社員", "r": "しゃいん" },
            { "b": "です。" }
          ],
          "translation": "…是的，是 IMC 公司的職員。"
        }
      ]
    },
    {
      "id": "L02-G06",
      "pattern": "そうですか",
      "explanation": "在聽到新的資訊時，用這句話表示知道了。",
      "examples": [
        {
          "id": "L02-S21",
          "ruby": [
            { "b": "この " },
            { "b": "傘", "r": "かさ" },
            { "b": "は あなたのですか。" }
          ],
          "translation": "這把傘是你的嗎？"
        },
        {
          "id": "L02-S22",
          "ruby": [
            { "b": "… いいえ、 " },
            { "b": "違", "r": "ちが" },
            { "b": "います。シュミットさんのです。" }
          ],
          "translation": "…不，是舒密特先生的。"
        },
        {
          "id": "L02-S23",
          "ruby": [{ "b": "そうですか。" }],
          "translation": "哦，這樣呀。"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L02-D01",
      "ruby": [{ "b": "はい。 どなたですか。" }],
      "translation": "來了。是哪一位？",
      "speaker": "山田一郎"
    },
