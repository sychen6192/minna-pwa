        { "b": "世話", "r": "せわ" },
        { "b": "に なります。" }
      ],
      "translation": "今後還請您多多關照。",
      "speaker": "サントス"
    },
    {
      "id": "L02-D05",
      "ruby": [
        { "b": "どうぞ よろしく お" },
        { "b": "願", "r": "ねが" },
        { "b": "いします。" }
      ],
      "translation": "請多多指教。",
      "speaker": "サントス"
    },
    {
      "id": "L02-D06",
      "ruby": [{ "b": "こちらこそ よろしく。" }],
      "translation": "哪裡哪裡，也請您多關照。",
      "speaker": "山田"
    },
    {
      "id": "L02-D07",
      "ruby": [
        { "b": "あのう、これ、ほんの " },
        { "b": "気持", "r": "きも" },
        { "b": "ちです。" }
      ],
      "translation": "嗯，這個，是我的一點小心意。",
      "speaker": "サントス"
    },
    {
      "id": "L02-D08",
      "ruby": [
        { "b": "あ、どうも……。 " },
        { "b": "何", "r": "なん" },
        { "b": "ですか。" }
      ],
      "translation": "啊，謝謝……。是什麼呢？",
      "speaker": "山田"
    },
    {
      "id": "L02-D09",
      "ruby": [{ "b": "コーヒーです。 どうぞ。" }],
      "translation": "是咖啡。請收下。",
      "speaker": "サントス"
    },
    {
      "id": "L02-D10",
      "ruby": [{ "b": "どうも ありがとう ございます。" }],
      "translation": "非常謝謝您。",
      "speaker": "山田"
    }
  ]
}
