    },
    {
      "id": "L20-D07",
      "ruby": [
        { "b": "8" },
        { "b": "月", "r": "がつ" },
        { "b": "の " },
        { "b": "初", "r": "はじ" },
        { "b": "めごろは どう?" }
      ],
      "translation": "八月初左右如何？",
      "speaker": "小林"
    },
    {
      "id": "L20-D08",
      "ruby": [{ "b": "いいね。" }],
      "translation": "好啊。",
