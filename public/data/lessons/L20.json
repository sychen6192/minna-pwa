  "grammar": [
    {
      "id": "L20-G01",
      "pattern": "敬體和常體",
      "explanation": "日語的文體分為敬體和常體兩種。敬體句中帶「です﹑ます」的述語叫禮貌形;而常體句中用的述語稱為普通形。(參考初級Ⅱ本冊82頁第20課練習A1)",
      "examples": [
        {
          "id": "L20-S01",
          "ruby": [
            { "b": "あした " },
            { "b": "東京", "r": "とうきょう" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "く。" }
          ],
          "translation": "我明天要去東京。"
        },
        {
          "id": "L20-S02",
          "ruby": [
            { "b": "毎日", "r": "まいにち" },
            { "b": " " },
            { "b": "忙", "r": "いそが" },
            { "b": "しい。" }
          ],
          "translation": "我每天都忙。"
        },
        {
          "id": "L20-S03",
          "ruby": [
            { "b": "相撲", "r": "すもう" },
            { "b": "が " },
            { "b": "好", "r": "す" },
            { "b": "きだ。" }
          ],
          "translation": "我喜歡相撲。"
        },
        {
          "id": "L20-S04",
          "ruby": [
            { "b": "富士山", "r": "ふじさん" },
            { "b": "に " },
            { "b": "登", "r": "のぼ" },
            { "b": "りたい。" }
          ],
          "translation": "我想攀登富士山。"
        },
        {
          "id": "L20-S05",
          "ruby": [
            { "b": "ドイツへ " },
            { "b": "行", "r": "い" },
            { "b": "った ことが ない。" }
          ],
          "translation": "我沒去過德國。"
        }
      ]
    },
    {
      "id": "L20-G02",
      "pattern": "敬體和常體的區別",
      "explanation": "1) 敬體是在任何時候、任何地方、對任何人都可以使用的禮貌說法。因此,敬體在非親密朋友的成人之間,是日常會話中最常用的。對第一次見面的人或和上司、長輩說話時,或不太熟悉的同輩時應該用敬體;對不太熟悉的下級、晚輩時,有時也要用敬體。各熟悉的朋友、同事,家人之間的會話時則使用常體。使用常體要得心應手,必須顧慮到說話人之間的年齡、上下關係。由於弄錯了常體的使用場合,會對對方失禮,所以不太清楚時最好用敬體比較穩妥。2) 書寫時一般都使用常體。一般而言,報紙、書藉、論文以及私人寫的日記等都用常體書寫,而書信一般則用敬體書寫。",
      "examples": [
        {
          "id": "L20-S06",
          "ruby": [
            { "b": "あした " },
            { "b": "東京", "r": "とうきょう" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きます。" }
          ],
          "translation": "我明天要去東京。（敬體）"
        }
      ]
    },
    {
      "id": "L20-G03",
      "pattern": "常體的會話",
      "explanation": "1) 在常體的疑問句中,一般會省略掉句尾的助詞「か」,而以如「のむ」般的上升調問話。2) 在名詞和な形容詞的疑問句中,還會省略「です」的常體「だ」。由於肯定回答時,「だ」的語氣很強,所以會省略「だ」或加上終助詞來緩和語氣。女性則幾乎不說「〜だ」。3) 常體句中從前後關係可以判斷句意時,助詞通常會脫落。但是,有些助詞像「で﹑に﹑から﹑まで﹑と」等,省略後句意就不清楚了,因此一般不能省略。4) 常體句中,「動詞て形 いる」的「い」也經常會脫落。",
      "examples": [
        {
          "id": "L20-S07",
          "ruby": [
            { "b": "コーヒーを " },
            { "b": "飲", "r": "の" },
            { "b": "む?" }
          ],
          "translation": "喝咖啡嗎？"
        },
        {
          "id": "L20-S08",
          "ruby": [
            { "b": "…うん、" },
            { "b": "飲", "r": "の" },
            { "b": "む。" }
          ],
          "translation": "…嗯，喝。"
        },
        {
          "id": "L20-S09",
          "ruby": [
            { "b": "今晩", "r": "こんばん" },
            { "b": " " },
            { "b": "暇", "r": "ひま" },
            { "b": "?" }
          ],
          "translation": "今晚有空嗎？（男女都用）"
        },
        {
          "id": "L20-S10",
          "ruby": [
            { "b": "…うん、" },
            { "b": "暇", "r": "ひま" },
            { "b": " ／" },
            { "b": "暇", "r": "ひま" },
            { "b": "だ ／" },
            { "b": "暇", "r": "ひま" },
            { "b": "だよ。" }
          ],
          "translation": "…嗯，有空。（男性用語）"
        },
        {
          "id": "L20-S11",
          "ruby": [
            { "b": "…うん、" },
            { "b": "暇", "r": "ひま" },
            { "b": " ／" },
            { "b": "暇", "r": "ひま" },
            { "b": "よ。" }
          ],
          "translation": "…嗯，有空。（女性用語）"
        },
        {
          "id": "L20-S12",
          "ruby": [
            { "b": "…ううん、" },
            { "b": "暇", "r": "ひま" },
            { "b": "じゃ ない。" }
          ],
          "translation": "…沒空。（男女都說）"
        },
        {
          "id": "L20-S13",
          "ruby": [
            { "b": "ごはん［を］ " },
            { "b": "食", "r": "た" },
            { "b": "べる?" }
          ],
          "translation": "吃飯嗎？"
        },
        {
          "id": "L20-S14",
          "ruby": [
            { "b": "あした " },
            { "b": "京都", "r": "きょうと" },
            { "b": "［へ］ " },
            { "b": "行", "r": "い" },
            { "b": "かない?" }
          ],
          "translation": "明天要不要去京都？"
        },
        {
          "id": "L20-S15",
          "ruby": [{ "b": "この りんご［は］ おいしいね。" }],
          "translation": "這個蘋果真好吃。"
        },
        {
          "id": "L20-S16",
          "ruby": [
            { "b": "そこに はさみ［が］ ある?" }
          ],
          "translation": "那裡有剪刀嗎？"
        },
        {
          "id": "L20-S17",
          "ruby": [
            { "b": "辞書", "r": "じしょ" },
            { "b": "、" },
            { "b": "持", "r": "も" },
            { "b": "って［い］る?" }
          ],
          "translation": "有字典嗎？"
        },
        {
          "id": "L20-S18",
          "ruby": [
            { "b": "…うん、" },
            { "b": "持", "r": "も" },
            { "b": "って［い］る。" }
          ],
          "translation": "…嗯，有。"
        },
        {
          "id": "L20-S19",
          "ruby": [
            { "b": "…ううん、" },
            { "b": "持", "r": "も" },
            { "b": "って［い］ない。" }
          ],
          "translation": "…不，沒有。"
        },
        {
          "id": "L20-S20",
          "ruby": [
            { "b": "その カレーライス［は］おいしい?" }
          ],
          "translation": "那咖喱飯好吃嗎？"
        },
        {
          "id": "L20-S21",
          "ruby": [
            { "b": "…うん、" },
            { "b": "辛", "r": "から" },
            { "b": "いけど、おいしい。" }
          ],
          "translation": "…嗯，雖然辣卻滿好吃的。"
        },
        {
          "id": "L20-S22",
          "ruby": [
            { "b": "相撲", "r": "すもう" },
            { "b": "の チケット［が］あるけど、いっしょに " },
            { "b": "行", "r": "い" },
            { "b": "かない?" }
          ],
          "translation": "我有相撲比賽的票，要不要一起去呢？"
        },
        {
          "id": "L20-S23",
          "ruby": [{ "b": "…いいね。" }],
          "translation": "…好呀！"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L20-D01",
      "ruby": [
        { "b": "夏休", "r": "なつやす" },
        { "b": "みは " },
        { "b": "国", "r": "くに" },
        { "b": "へ " },
        { "b": "帰", "r": "かえ" },
        { "b": "るの?" }
      ],
      "translation": "暑假要回國嗎？",
      "speaker": "小林"
    },
    {
      "id": "L20-D02",
      "ruby": [
        { "b": "ううん。" },
        { "b": "帰", "r": "かえ" },
        { "b": "りたいけど、……。" },
        { "b": "小林", "r": "こばやし" },
        { "b": "君", "r": "くん" },
        { "b": "は どう するの?" }
      ],
      "translation": "不回去。雖然想回去，可是……。小林你打算怎麼做呢？",
      "speaker": "タワポン"
    },
    {
      "id": "L20-D03",
      "ruby": [
        { "b": "どう しようかな……。" },
        { "b": "タワポン" },
        { "b": "君", "r": "くん" },
        { "b": "、" },
        { "b": "富士山", "r": "ふじさん" },
        { "b": "に " },
        { "b": "登", "r": "のぼ" },
        { "b": "った こと ある?" }
      ],
      "translation": "我該怎麼做呢……。塔瓦蓬，你爬過富士山嗎？",
      "speaker": "小林"
    },
    {
      "id": "L20-D04",
      "ruby": [{ "b": "ううん。" }],
