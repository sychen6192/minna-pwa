    {
      "id": "L22-G04",
      "pattern": "動詞字典形 時間／約束／用事",
      "explanation": "要表達做某事的時間時,應如例句⑭般,用動詞的字典形將做的內容放在名詞「じかん」之前。另外,還可以用動詞的字典形表現約定等的內容。",
      "examples": [
        {
          "id": "L22-S23",
          "ruby": [
            { "b": "わたしは " },
            { "b": "朝", "r": "あさ" },
            { "b": "ごはんを " },
            { "b": "食", "r": "た" },
            { "b": "べる " },
            { "b": "時間", "r": "じかん" },
            { "b": "が ありません。" }
          ],
          "translation": "我沒有吃早飯的時間。"
        },
        {
          "id": "L22-S24",
          "ruby": [
            { "b": "わたしは " },
            { "b": "友達", "r": "ともだち" },
