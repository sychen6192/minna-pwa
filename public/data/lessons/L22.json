  "dialogues": [
    {
      "id": "L22-D01",
      "ruby": [
        { "b": "こちらは いかがですか。" },
        { "b": "家賃", "r": "やちん" },
        { "b": "は 8" },
        { "b": "万円", "r": "まんえん" },
        { "b": "です。" }
      ],
      "translation": "這間如何呢？房租是 8 萬日圓。",
      "speaker": "不動産屋"
    },
    {
      "id": "L22-D02",
      "ruby": [
        { "b": "うーん……。ちょっと " },
        { "b": "駅", "r": "えき" },
        { "b": "から " },
        { "b": "遠", "r": "とお" },
        { "b": "いですね。" }
      ],
      "translation": "嗯……離車站有點遠呢。",
      "speaker": "ワン"
    },
    {
      "id": "L22-D03",
      "ruby": [
        { "b": "じゃ、こちらは？" },
        { "b": "便利", "r": "べんり" },
        { "b": "ですよ。" },
        { "b": "駅", "r": "えき" },
        { "b": "から " },
        { "b": "歩", "r": "ある" },
        { "b": "いて 3" },
        { "b": "分", "r": "ぶん" },
        { "b": "ですから。" }
      ],
      "translation": "那麼這間呢？很方便喔。因為離車站走路 3 分鐘。",
      "speaker": "不動産屋"
    },
    {
      "id": "L22-D04",
      "ruby": [
        { "b": "そうですね。ダイニングキチンと " },
        { "b": "和室", "r": "わしつ" },
        { "b": "が 1つと……。すみません。ここは " },
        { "b": "何", "r": "なん" },
        { "b": "ですか。" }
      ],
      "translation": "不錯呢。有一間兼作餐廳的廚房和一間和室……。不好意思,這裡是什麼？",
      "speaker": "ワン"
    },
    {
      "id": "L22-D05",
      "ruby": [
        { "b": "押", "r": "お" },
        { "b": "し" },
        { "b": "入", "r": "い" },
        { "b": "れです。" },
        { "b": "布団", "r": "ふとん" },
        { "b": "を " },
        { "b": "入", "r": "い" },
        { "b": "れる " },
        { "b": "所", "r": "ところ" },
        { "b": "ですよ。" }
      ],
      "translation": "是壁櫥。是放棉被的地方喔。",
      "speaker": "不動産屋"
    },
    {
      "id": "L22-D06",
      "ruby": [
        { "b": "そうですか。この アパート、きょう " },
        { "b": "見", "r": "み" },
        { "b": "る ことが できますか。" }
      ],
      "translation": "這樣啊。這間公寓,今天可以看嗎？",
      "speaker": "ワン"
    },
    {
      "id": "L22-D07",
