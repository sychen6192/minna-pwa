    },
    {
      "id": "L22-G03",
      "pattern": "名詞 が",
      "explanation": "修飾名詞的句子,主語用「が」。",
      "examples": [
        {
          "id": "L22-S20",
          "ruby": [
            { "b": "これは ミラーさんが " },
            { "b": "作", "r": "つく" },
            { "b": "った ケーキです。" }
          ],
          "translation": "這是米勒先生做的蛋糕。"
        },
        {
          "id": "L22-S21",
          "ruby": [
            { "b": "わたしは カリナさんが かいた " },
            { "b": "絵", "r": "え" },
            { "b": "が " },
            { "b": "好", "r": "す" },
            { "b": "きです。" }
          ],
          "translation": "我喜歡卡莉娜小姐畫的畫。"
        },
        {
          "id": "L22-S22",
          "ruby": [
            { "b": "［あなたは］ " },
