  "grammar": [
    {
      "id": "L22-G01",
      "pattern": "修飾名詞",
      "explanation": "第2課、第8課中已經學過了修飾名詞的方法。「ミラーさんの うち」(米勒先生的家,第2課)、「新しい うち」(新的房子,第8課)、「きれいな うち」(漂亮的房子,第8課)。日語中在修飾名詞時,不論是單詞還是句子,修飾的部分一定放在被修飾部分之前。本課中我們將學習上述方法以外修飾名詞的方法。",
      "examples": [
        {
          "id": "L22-S01",
          "ruby": [
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "く " },
            { "b": "人", "r": "ひと" }
          ],
          "translation": "要去京都的人"
        },
        {
          "id": "L22-S02",
          "ruby": [
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "かない " },
            { "b": "人", "r": "ひと" }
          ],
          "translation": "不去京都的人"
        },
        {
          "id": "L22-S03",
          "ruby": [
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "った " },
            { "b": "人", "r": "ひと" }
          ],
          "translation": "去了京都的人"
        },
        {
          "id": "L22-S04",
          "ruby": [
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "かなかった " },
            { "b": "人", "r": "ひと" }
          ],
          "translation": "沒去京都的人"
        },
        {
          "id": "L22-S05",
          "ruby": [
            { "b": "背", "r": "せ" },
            { "b": "が " },
            { "b": "高", "r": "たか" },
            { "b": "くて、" },
            { "b": "髪", "r": "かみ" },
            { "b": "が " },
            { "b": "黒", "r": "くろ" },
            { "b": "い " },
            { "b": "人", "r": "ひと" }
          ],
          "translation": "個子高、頭髮黑的人"
        },
        {
          "id": "L22-S06",
          "ruby": [
            { "b": "親切", "r": "しんせつ" },
            { "b": "で、きれいな " },
            { "b": "人", "r": "ひと" }
          ],
          "translation": "親切而漂亮的人"
        },
        {
          "id": "L22-S07",
          "ruby": [
            { "b": "65", "r": "ろくじゅうご" },
            { "b": "歳", "r": "さい" },
            { "b": "の " },
            { "b": "人", "r": "ひと" }
          ],
          "translation": "65 歲的人"
        }
      ]
    },
    {
      "id": "L22-G02",
      "pattern": "句子修飾名詞",
      "explanation": "1) 被修飾的名詞前是普通形。「な形容詞句」時將「～だ」改成「～な」;而「名詞句」時,則是將「～だ」改為「～の」。2) 句子中不論用途為何的名詞,都可以拿出句外用原來的句子來修飾。被修飾語後,原來句中各自搭配的助詞都不要了。3) 有些句子中被修飾的名詞,可以使用在各種句型中。",
      "examples": [
        {
          "id": "L22-S08",
          "ruby": [
            { "b": "わたしは " },
            { "b": "先週", "r": "せんしゅう" },
            { "b": " " },
            { "b": "映画", "r": "えいが" },
            { "b": "を " },
            { "b": "見", "r": "み" },
            { "b": "ました" }
          ],
          "translation": "我上週看了電影"
        },
        {
          "id": "L22-S09",
          "ruby": [
            { "b": "わたしが " },
            { "b": "先週", "r": "せんしゅう" },
            { "b": " " },
            { "b": "見", "r": "み" },
            { "b": "た " },
            { "b": "映画", "r": "えいが" }
          ],
          "translation": "我上週看的電影"
        },
        {
          "id": "L22-S10",
          "ruby": [
            { "b": "ワンさんは " },
            { "b": "病院", "r": "びょういん" },
            { "b": "で " },
            { "b": "働", "r": "はたら" },
            { "b": "いて います" }
          ],
          "translation": "王先生在醫院工作"
        },
        {
          "id": "L22-S11",
          "ruby": [
            { "b": "ワンさんが " },
            { "b": "働", "r": "はたら" },
            { "b": "いている " },
            { "b": "病院", "r": "びょういん" }
          ],
          "translation": "王先生工作的醫院"
        },
        {
          "id": "L22-S12",
          "ruby": [
            { "b": "わたしは あした " },
            { "b": "友達", "r": "ともだち" },
            { "b": "に " },
            { "b": "会", "r": "あ" },
            { "b": "います" }
          ],
          "translation": "我明天去見朋友"
        },
        {
          "id": "L22-S13",
          "ruby": [
            { "b": "わたしが あした " },
            { "b": "会", "r": "あ" },
            { "b": "う " },
            { "b": "友達", "r": "ともだち" }
          ],
          "translation": "我明天去見的朋友"
        },
        {
          "id": "L22-S14",
          "ruby": [
            { "b": "これは ミラーさんが " },
            { "b": "住", "r": "す" },
            { "b": "んで いた うちです。" }
          ],
          "translation": "這是米勒先生住過的房子。"
        },
        {
          "id": "L22-S15",
          "ruby": [
            { "b": "ミラーさんが " },
            { "b": "住", "r": "す" },
            { "b": "んで いた うちは " },
            { "b": "古", "r": "ふる" },
            { "b": "いです。" }
          ],
          "translation": "米勒先生住過的房子很舊。"
        },
        {
          "id": "L22-S16",
          "ruby": [
            { "b": "ミラーさんが " },
            { "b": "住", "r": "す" },
            { "b": "んで いた うちを " },
            { "b": "買", "r": "か" },
            { "b": "いました。" }
          ],
          "translation": "買下了米勒先生住過的房子。"
        },
        {
          "id": "L22-S17",
          "ruby": [
            { "b": "わたしは ミラーさんが " },
            { "b": "住", "r": "す" },
            { "b": "んで いた うちが " },
            { "b": "好", "r": "す" },
            { "b": "きです。" }
          ],
          "translation": "我喜歡米勒先生住過的房子。"
        },
        {
          "id": "L22-S18",
          "ruby": [
            { "b": "ミラーさんが " },
            { "b": "住", "r": "す" },
            { "b": "んで いた うちに " },
            { "b": "猫", "r": "ねこ" },
            { "b": "が いました。" }
          ],
          "translation": "米勒先生住過的房子裡有貓。"
        },
        {
          "id": "L22-S19",
          "ruby": [
            { "b": "ミラーさんが " },
            { "b": "住", "r": "す" },
            { "b": "んで いた うちへ " },
