            { "b": "映画", "r": "えいが" },
            { "b": "を " },
            { "b": "見", "r": "み" },
            { "b": "る " },
            { "b": "約束", "r": "やくそく" },
            { "b": "が あります。" }
          ],
          "translation": "我和朋友約好了去看電影。"
        },
        {
          "id": "L22-S25",
          "ruby": [
            { "b": "きょうは " },
            { "b": "市役所", "r": "しやくしょ" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "く " },
            { "b": "用事", "r": "ようじ" },
