  "grammar": [
    {
      "id": "L29-G01",
      "pattern": "動詞て形 います",
      "explanation": "用「動詞て形 います」，表示動詞表現的動作或作用產生的結果狀態一直存續的情況。正如例句般，說話人如實描寫眼前的狀態時，用助詞「が」表示動作或狀態的主體。這種句子裡出現的動詞是自動詞，其中大部分是表示動作、作用瞬間結束的動詞，有「こわれます」「きえます」「あきます」「こみます」等。描寫過去某一時間的狀態時，用「動詞て形 いました」。將動作或作用的主體提示為主題時，用助詞「は」提示。",
      "examples": [
        {
          "id": "L29-S01",
          "ruby": [{ "b": "窓", "r": "まど" }, { "b": "が " }, { "b": "割", "r": "わ" }, { "b": "れて います。" }],
          "translation": "窗戶破了。"
        },
        {
          "id": "L29-S02",
          "ruby": [{ "b": "電気", "r": "でんき" }, { "b": "が ついて います。" }],
          "translation": "燈開著。"
        },
        {
          "id": "L29-S03",
          "ruby": [{ "b": "けさは " }, { "b": "道", "r": "みち" }, { "b": "が " }, { "b": "込", "r": "こ" }, { "b": "んで いました。" }],
          "translation": "今天早上路上很擁擠。"
        },
        {
          "id": "L29-S04",
          "ruby": [{ "b": "この いすは " }, { "b": "壊", "r": "こわ" }, { "b": "れて います。" }],
          "translation": "這把椅子壞了。"
        }
      ]
    },
    {
      "id": "L29-G02",
      "pattern": "動詞て形 しまいました／しまいます",
      "explanation": "「動詞て形 しまいました」是強調該行為或事情已經結束的表達方式。用「動詞ました」也可以表示結束的意思，但用「動詞て形 しまいました」，便可以強調結束的意思，因此也常常一起使用「もう」「ぜんぶ」等強調結束的副詞。另外，「動詞て形 しまいます」還可以表示未來的結束。",
      "examples": [
        {
          "id": "L29-S05",
          "ruby": [{ "b": "シュミットさんが " }, { "b": "持", "r": "も" }, { "b": "って " }, { "b": "来", "r": "き" }, { "b": "た ワインは " }, { "b": "全部", "r": "ぜんぶ" }, { "b": " " }, { "b": "飲", "r": "の" }, { "b": "んで しまいました。" }],
          "translation": "舒密特先生帶來的葡萄酒全都喝完了。"
        },
        {
          "id": "L29-S06",
          "ruby": [{ "b": "漢字", "r": "かんじ" }, { "b": "の " }, { "b": "宿題", "r": "しゅくだい" }, { "b": "は もう やって しまいました。" }],
          "translation": "漢字的作業已經全部做完了。"
        },
        {
          "id": "L29-S07",
          "ruby": [{ "b": "昼", "r": "ひる" }, { "b": "ごはんまでに レポートを " }, { "b": "書", "r": "か" }, { "b": "いて しまいます。" }],
          "translation": "我要在吃午飯之前把報告寫完。"
        }
      ]
    },
    {
      "id": "L29-G03",
      "pattern": "動詞て形 しまいました（困惑、懊惱）",
      "explanation": "這是在為難狀態下的困惑、懊惱的表達方式。「護照丟了」和「電腦故障了」的這種事實，用「なくしました」「こしょうしました」這樣的過去時態也可以表達，但是這樣的表達方式，可以反映出說話人對這件事懊惱或困惑的心情。",
      "examples": [
        {
          "id": "L29-S08",
          "ruby": [{ "b": "パスポートを なくして しまいました。" }],
          "translation": "護照弄丟了。"
        },
        {
          "id": "L29-S09",
          "ruby": [{ "b": "パソコンが " }, { "b": "故障", "r": "こしょう" }, { "b": "して しまいました。" }],
          "translation": "電腦故障了。"
        }
      ]
    },
    {
      "id": "L29-G04",
      "pattern": "ありました",
      "explanation": "這個句子裡的「ありました」，是表示說話人發現「皮包」這個事實，而不是「以前那裡有皮包」的意思。",
      "examples": [
        {
          "id": "L29-S10",
          "ruby": [{ "b": "［かばんが］ありましたよ。" }],
          "translation": "〔皮包〕找到了。"
        }
      ]
    },
    {
      "id": "L29-G05",
      "pattern": "どこかで／どこかに",
      "explanation": "正如第13課的說明，「どこかへ」的「へ」、「なにかを」的「を」可以省略，但是「どこかで」的「で」，「どこかに」的「に」不能省略。",
      "examples": [
        {
          "id": "L29-S11",
          "ruby": [{ "b": "どこかで " }, { "b": "財布", "r": "さいふ" }, { "b": "を なくして しまいました。" }],
          "translation": "不知在哪裡把錢包弄丟了。"
        },
        {
          "id": "L29-S12",
          "ruby": [{ "b": "どこかに " }, { "b": "電話", "r": "でんわ" }, { "b": "が ありませんか。" }],
          "translation": "有沒有什麼地方有電話呢？"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L29-D01",
      "ruby": [{ "b": "すみません。" }, { "b": "今", "r": "いま" }, { "b": "の " }, { "b": "電車", "r": "でんしゃ" }, { "b": "に " }, { "b": "忘", "r": "わす" }, { "b": "れ" }, { "b": "物", "r": "もの" }, { "b": "を して しまったんですが……。" }],
