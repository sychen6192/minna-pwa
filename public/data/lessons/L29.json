      "ruby": [{ "b": "青", "r": "あお" }, { "b": "い かばんです。このくらいの……。" }, { "b": "外側", "r": "そとがわ" }, { "b": "に " }, { "b": "大", "r": "おお" }, { "b": "きい ポケットが " }, { "b": "付", "r": "つ" }, { "b": "いて います。" }],
      "translation": "是藍色的包包。大概這麼大……。外側有一個大口袋。",
      "speaker": "イー"
    },
    {
      "id": "L29-D04",
      "ruby": [{ "b": "どの " }, { "b": "辺", "r": "へん" }, { "b": "ですか。" }],
      "translation": "大概在哪個位置呢？",
      "speaker": "駅員"
    },
    {
      "id": "L29-D05",
      "ruby": [{ "b": "よく " }, { "b": "覚", "r": "おぼ" }, { "b": "えて いません。でも、" }, { "b": "網棚", "r": "あみだな" }, { "b": "の " }, { "b": "上", "r": "うえ" }, { "b": "に " }, { "b": "置", "r": "お" }, { "b": "きました。" }],
      "translation": "我記不太清楚了。不過，我放在行李網架上面了。",
      "speaker": "イー"
    },
    {
      "id": "L29-D06",
      "ruby": [{ "b": "中", "r": "なか" }, { "b": "に " }, { "b": "何", "r": "なに" }, { "b": "が " }, { "b": "入", "r": "はい" }, { "b": "って いますか。" }],
      "translation": "裡面裝了什麼東西呢？",
      "speaker": "駅員"
    },
    {
