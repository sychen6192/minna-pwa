  "grammar": [
    {
      "id": "L12-G01",
      "pattern": "名詞句、な形容詞句的過去式",
      "explanation": "名詞句與な形容詞句的過去式:肯定為「でした」,否定為「じゃ（では）ありませんでした」。",
      "examples": [
        {
          "id": "L12-S01",
          "ruby": [
            { "b": "きのうは " },
            { "b": "雨", "r": "あめ" },
            { "b": "でした。" }
          ],
          "translation": "昨天下了雨。"
        },
        {
          "id": "L12-S02",
          "ruby": [
            { "b": "きのうの " },
            { "b": "試験", "r": "しけん" },
            { "b": "は " },
            { "b": "簡単", "r": "かんたん" },
            { "b": "じゃ ありませんでした。" }
          ],
          "translation": "昨天的考試不容易。"
        }
      ]
    },
    {
      "id": "L12-G02",
      "pattern": "い形容詞句的過去式",
      "explanation": "い形容詞句的過去式:肯定為「〜かったです」,否定為「〜くなかったです」。",
      "examples": [
        {
          "id": "L12-S03",
          "ruby": [
            { "b": "きのうは " },
            { "b": "暑", "r": "あつ" },
            { "b": "かったです。" }
          ],
          "translation": "昨天很熱。"
        },
        {
          "id": "L12-S04",
          "ruby": [
            { "b": "きのうの パーティーは あまり " },
            { "b": "楽", "r": "たの" },
            { "b": "しくなかったです。" }
          ],
          "translation": "昨天的派對不太愉快。"
        }
      ]
    },
    {
      "id": "L12-G03",
      "pattern": "名詞1は 名詞2より 形容詞 です",
      "explanation": "這是以名詞2為基準,敘述名詞1的性質和狀態。",
      "examples": [
        {
          "id": "L12-S05",
          "ruby": [
            { "b": "この " },
            { "b": "車", "r": "くるま" },
            { "b": "は あの " },
            { "b": "車", "r": "くるま" },
            { "b": "より " },
            { "b": "大", "r": "おお" },
            { "b": "きいです。" }
          ],
          "translation": "這輛車比那輛車大。"
        }
      ]
    },
    {
      "id": "L12-G04",
      "pattern": "名詞1と 名詞2と どちらが 形容詞 ですか",
      "explanation": "這是在二者（名詞1和名詞2）之間選擇其中之一的疑問句。在比較二者的疑問句中,無論對象是什麼,疑問詞都要用「どちら」。",
      "examples": [
        {
          "id": "L12-S06",
          "ruby": [
            { "b": "サッカーと " },
            { "b": "野球", "r": "やきゅう" },
            { "b": "と どちらが おもしろいですか。" }
          ],
          "translation": "足球和棒球哪個有趣？"
        },
        {
          "id": "L12-S07",
          "ruby": [
            { "b": "…サッカーの ほうが おもしろいです。" }
          ],
          "translation": "…足球有趣。"
        },
        {
          "id": "L12-S08",
          "ruby": [
            { "b": "ミラーさんと サントスさんと どちらが テニスが " },
            { "b": "上手", "r": "じょうず" },
            { "b": "ですか。" }
          ],
          "translation": "米勒先生和山多斯先生哪個人網球打得好？"
        },
        {
          "id": "L12-S09",
          "ruby": [
            { "b": "北海道", "r": "ほっかいどう" },
            { "b": "と " },
            { "b": "大阪", "r": "おおさか" },
            { "b": "と どちらが " },
            { "b": "涼", "r": "すず" },
            { "b": "しいですか。" }
          ],
          "translation": "北海道和大阪哪裡涼快？"
        },
        {
          "id": "L12-S10",
          "ruby": [
            { "b": "春", "r": "はる" },
            { "b": "と " },
            { "b": "秋", "r": "あき" },
            { "b": "と どちらが " },
            { "b": "好", "r": "す" },
            { "b": "きですか。" }
          ],
          "translation": "春天和秋天你喜歡哪個？"
        }
      ]
    },
    {
      "id": "L12-G05",
      "pattern": "名詞1〔の 中〕で 何/どこ/だれ/いつ が いちばん 形容詞 ですか",
      "explanation": "這是從形容詞表達的內容中,選擇程度最高的事物、地點、人物或時間的疑問句。選擇的範圍限定為名詞1［の なか］で的形式,疑問詞由被選事物的所屬範疇決定。",
      "examples": [
        {
          "id": "L12-S11",
          "ruby": [
            { "b": "日本料理", "r": "にほんりょうり" },
            { "b": "［の " },
            { "b": "中", "r": "なか" },
            { "b": "］で " },
            { "b": "何", "r": "なに" },
            { "b": "が いちばん おいしいですか。" }
          ],
          "translation": "日本料理（當中）哪個最好吃？"
        },
        {
          "id": "L12-S12",
          "ruby": [
            { "b": "…てんぷらが いちばん おいしいです。" }
          ],
          "translation": "…天麩羅最好吃。"
        },
        {
          "id": "L12-S13",
          "ruby": [
            { "b": "ヨーロッパで どこが いちばん よかったですか。" }
          ],
          "translation": "歐洲哪裡最好？"
        },
        {
          "id": "L12-S14",
          "ruby": [
            { "b": "…スイスが いちばん よかったです。" }
          ],
          "translation": "…瑞士最好。"
        },
        {
          "id": "L12-S15",
          "ruby": [
            { "b": "家族", "r": "かぞく" },
            { "b": "で だれが いちばん " },
            { "b": "背", "r": "せ" },
            { "b": "が " },
            { "b": "高", "r": "たか" },
            { "b": "いですか。" }
          ],
          "translation": "家人裡面誰最高？"
        },
        {
          "id": "L12-S16",
          "ruby": [
            { "b": "…" },
            { "b": "弟", "r": "おとうと" },
            { "b": "が いちばん " },
            { "b": "背", "r": "せ" },
            { "b": "が " },
            { "b": "高", "r": "たか" },
            { "b": "いです。" }
          ],
          "translation": "…弟弟最高。"
        },
        {
          "id": "L12-S17",
          "ruby": [
            { "b": "1" },
            { "b": "年", "r": "ねん" },
            { "b": "で いつが いちばん " },
            { "b": "寒", "r": "さむ" },
            { "b": "いですか。" }
          ],
          "translation": "一年裡什麼時候最冷？"
        },
        {
          "id": "L12-S18",
          "ruby": [
            { "b": "…2" },
            { "b": "月", "r": "がつ" },
            { "b": "が いちばん " },
            { "b": "寒", "r": "さむ" },
            { "b": "いです。" }
          ],
          "translation": "…2月最冷。"
        }
      ]
    }
