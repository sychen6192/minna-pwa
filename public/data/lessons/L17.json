  "grammar": [
    {
      "id": "L17-G01",
      "pattern": "動詞ない形",
      "explanation": "和「ない」一起使用的動詞形稱為ない形。例如,「かかない」的「かか」部分,就是「かきます」（寫）的ない形。Ⅰ類動詞:由於ます形的最後一個音節都是い段,把它改成あ段就行了。但是動詞ます形的最後音節是母音「い」時（買います、会います等）,要變成「わ」而不是「あ」。Ⅱ類動詞的ない形和ます形相同。Ⅲ類:「します」的ない形和ます形相同;「きます」則是「こ（ない）」。",
      "examples": [
        {
          "id": "L17-S01",
          "ruby": [
            { "b": "かき-ます → かか-ない" }
          ],
          "translation": "寫"
        },
        {
          "id": "L17-S02",
          "ruby": [
            { "b": "き-ます → こ-ない" }
          ],
          "translation": "來"
        }
      ]
    },
    {
      "id": "L17-G02",
      "pattern": "動詞ない形 ないで ください",
      "explanation": "這個句型在請求、指示對方不要那麼做時使用。",
      "examples": [
        {
          "id": "L17-S03",
          "ruby": [
            { "b": "わたしは " },
            { "b": "元気", "r": "げんき" },
            { "b": "ですから、" },
            { "b": "心配", "r": "しんぱい" },
            { "b": "しないで ください。" }
          ],
          "translation": "我很好,請不要擔心。"
        },
        {
          "id": "L17-S04",
          "ruby": [
            { "b": "ここで " },
            { "b": "写真", "r": "しゃしん" },
            { "b": "を " },
            { "b": "撮", "r": "と" },
            { "b": "らないで ください。" }
          ],
          "translation": "請不要在這裡拍照。"
        }
      ]
    },
    {
      "id": "L17-G03",
      "pattern": "動詞ない形 なければ なりません",
      "explanation": "這個句型表示不管行為者的意志如何,都不能不做的事。注意它沒有否定的意思。",
      "examples": [
        {
          "id": "L17-S05",
          "ruby": [
            { "b": "薬", "r": "くすり" },
            { "b": "を " },
            { "b": "飲", "r": "の" },
            { "b": "まなければ なりません。" }
          ],
          "translation": "必須吃藥。"
        }
      ]
    },
    {
      "id": "L17-G04",
      "pattern": "動詞ない形 なくても いいです",
      "explanation": "這個句型表示沒有必要進行動詞表示的行為。",
      "examples": [
        {
          "id": "L17-S06",
          "ruby": [
            { "b": "あした " },
            { "b": "来", "r": "こ" },
            { "b": "なくても いいです。" }
          ],
          "translation": "明天你不需要來。"
        }
      ]
    },
    {
      "id": "L17-G05",
      "pattern": "名詞（受詞）は",
      "explanation": "在第6課學過直接受詞要接助詞「を」。這裡是將這個受詞用助詞「は」提示成主題。",
      "examples": [
        {
          "id": "L17-S07",
          "ruby": [
            { "b": "荷物", "r": "にもつ" },
            { "b": "は ここに " },
            { "b": "置", "r": "お" },
            { "b": "かないで ください。" }
          ],
          "translation": "行李請不要放在這裡。"
        },
        {
          "id": "L17-S08",
          "ruby": [
            { "b": "昼", "r": "ひる" },
            { "b": "ごはんは " },
            { "b": "会社", "r": "かいしゃ" },
            { "b": "の " },
            { "b": "食堂", "r": "しょくどう" },
            { "b": "で " },
            { "b": "食", "r": "た" },
            { "b": "べます。" }
          ],
          "translation": "午飯在公司的餐廳吃。"
        }
      ]
    },
    {
      "id": "L17-G06",
      "pattern": "名詞（時間）までに 動詞",
      "explanation": "表示動作、作用必須最後完成的時間。也就是說,動作、作用以「までに」顯示的時間為限,在此之前進行的意思。〔註〕注意不要與第4課學過的助詞「まで」混淆。",
      "examples": [
        {
          "id": "L17-S09",
          "ruby": [
            { "b": "会議", "r": "かいぎ" },
            { "b": "は 5" },
            { "b": "時", "r": "じ" },
            { "b": "までに " },
            { "b": "終", "r": "お" },
            { "b": "わります。" }
          ],
          "translation": "會議 5點之前結束。"
        },
        {
          "id": "L17-S10",
          "ruby": [
            { "b": "土曜日", "r": "どようび" },
            { "b": "までに " },
            { "b": "本", "r": "ほん" },
            { "b": "を " },
            { "b": "返", "r": "かえ" },
            { "b": "さなければ なりません。" }
          ],
          "translation": "必須在星期六以前還書。"
        }
      ]
    }
  ],
  "dialogues": [
    {
