  "grammar": [
    {
      "id": "L42-G01",
      "pattern": "動詞字典形／名詞の ために、〜",
      "explanation": "這個句型表示目的。「名詞の ために」也表示「為了成為名詞的利益」的意思（如④）。〔註1〕第36課學的「〜ように」也用在表示目的上，但是相對於用「〜ように」時要使用非意志動詞，用「〜ために」時則要使用意志動詞。①是自己有意識地以「擁有店舖」為目的，為了實現這個目標「正在存錢」；相對地，「持てるように」表示以「能擁有店舖」這樣的狀態作為目標，為了接近這個狀態而「正在存錢」的意思。〔註2〕「なります」可以表示有意志、無意志二種意思。",
      "examples": [
        {
          "id": "L42-S01",
          "ruby": [
            { "b": "自分", "r": "じぶん" },
            { "b": "の " },
            { "b": "店", "r": "みせ" },
            { "b": "を " },
            { "b": "持", "r": "も" },
            { "b": "つ ために、" },
            { "b": "貯金", "r": "ちょきん" },
            { "b": "して います。" }
          ],
          "translation": "為了擁有自己的店舖而正在存錢。"
        },
        {
          "id": "L42-S02",
          "ruby": [
            { "b": "引", "r": "ひ" },
            { "b": "っ " },
            { "b": "越", "r": "こ" },
            { "b": "しの ために、" },
            { "b": "車", "r": "くるま" },
            { "b": "を " },
            { "b": "借", "r": "か" },
            { "b": "ります。" }
          ],
          "translation": "為了搬家要借汽車。"
        },
        {
          "id": "L42-S03",
          "ruby": [
            { "b": "健康", "r": "けんこう" },
            { "b": "の ために、" },
            { "b": "毎朝", "r": "まいあさ" },
            { "b": "走", "r": "はし" },
            { "b": "って います。" }
          ],
          "translation": "為了健康每天早上跑步。"
        },
        {
          "id": "L42-S04",
          "ruby": [
            { "b": "家族", "r": "かぞく" },
            { "b": "の ために、うちを " },
            { "b": "建", "r": "た" },
            { "b": "てます。" }
          ],
          "translation": "為家人而蓋房子。"
        },
        {
          "id": "L42-S05",
          "ruby": [
            { "b": "弁護士", "r": "べんごし" },
            { "b": "に なる ために、" },
            { "b": "法律", "r": "ほうりつ" },
            { "b": "を " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "して います。" }
          ],
          "translation": "為了成為律師，正在學習法律。"
        },
        {
          "id": "L42-S06",
          "ruby": [
            { "b": "日本語", "r": "にほんご" },
            { "b": "が " },
            { "b": "上手", "r": "じょうず" },
            { "b": "に なるように、" },
            { "b": "毎日", "r": "まいにち" },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "しています。" }
          ],
          "translation": "為了日語能夠進步，每天都在念。"
        }
      ]
    },
    {
      "id": "L42-G02",
      "pattern": "動詞字典形の／名詞 に 〜",
      "explanation": "第38課學過，動詞字典形加上「の」的話，則該部分可作為名詞使用。另外，「動詞字典形のに」、「名詞に」後接「つかう」「いい」「べんりだ」「やくに たつ」「［じかんが］かかる」等動詞、形容詞，則表示用途及目的。",
      "examples": [
        {
          "id": "L42-S07",
          "ruby": [
            { "b": "この はさみは " },
