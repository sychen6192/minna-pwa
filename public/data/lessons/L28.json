  "grammar": [
    {
      "id": "L28-G01",
      "pattern": "動詞 1ます形 ながら 動詞 2",
      "explanation": "這個句型表示同一人在一定時間內,同時持續進行的兩個動作(動詞1、動詞2)。動詞2是重點強調的動作。這個句型也可以用在某一期間中兩件事持續進行時。",
      "examples": [
        {
          "id": "L28-S01",
          "ruby": [
            { "b": "音楽", "r": "おんがく" },
            { "b": "を " },
            { "b": "聞", "r": "き" },
            { "b": "きながら " },
            { "b": "食事", "r": "しょくじ" },
            { "b": "します。" }
          ],
          "translation": "邊聽音樂邊用餐。"
        },
        {
          "id": "L28-S02",
          "ruby": [
            { "b": "働", "r": "はたら" },
            { "b": "きながら " },
            { "b": "日本語", "r": "にほんご" },
            { "b": "を " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "して います。" }
          ],
          "translation": "邊工作邊學日語。"
        }
      ]
    },
    {
      "id": "L28-G02",
      "pattern": "動詞て形 います",
      "explanation": "這個句型使用在表示某行為習慣性反覆進行的意思上。過去進行的習慣性行為時,用「て形 いました」。",
      "examples": [
        {
          "id": "L28-S03",
          "ruby": [
            { "b": "毎朝", "r": "まいあさ" },
            { "b": " ジョギングを して います。" }
          ],
          "translation": "我每早上跑步。"
        },
        {
          "id": "L28-S04",
          "ruby": [
            { "b": "子", "r": "こ" },
            { "b": "どもの とき、" },
            { "b": "毎晩", "r": "まいばん" },
            { "b": " 8" },
            { "b": "時", "r": "じ" },
            { "b": "に " },
            { "b": "寝", "r": "ね" },
            { "b": "て いました。" }
          ],
          "translation": "小時候,每天晚上 8 點睡覺。"
        }
      ]
    },
    {
      "id": "L28-G03",
      "pattern": "普通形 し、〜",
      "explanation": "1)這個句型使用在從某一觀點出發的並列敘述。例如,有幾個句子都是敘述有關某一主題的優點時,就可以用這個句型連接起來。2)並列敘述兩個以上的原因、理由時,也可以使用這個句型。這是情緒上想要強調原因、理由的多重性時使用。這時,如果結論很明顯,也可以只列舉理由,其他省略掉(參考⑦)。另外,「〜し」一般用在並列敘述兩個以上的理由,但有時也會只敘述其中的一個。這時與用「〜から」不同,它暗示還有其他的理由。並列句中經常用助詞「も」,這表達出了說話人想要累積評價和理由的情緒。",
      "examples": [
        {
          "id": "L28-S05",
          "ruby": [
            { "b": "ワット " },
            { "b": "先生", "r": "せんせい" },
            { "b": "は " },
            { "b": "熱心", "r": "ねっしん" },
            { "b": "だし、まじめだし、" },
            { "b": "経験", "r": "けいけん" },
            { "b": "も あります。" }
          ],
          "translation": "瓦特老師又熱心又認真,而且還有經驗。"
        },
        {
          "id": "L28-S06",
          "ruby": [
            { "b": "駅", "r": "えき" },
            { "b": "から " },
            { "b": "近", "r": "ちか" },
            { "b": "いし、" },
            { "b": "車", "r": "くるま" },
            { "b": "でも " },
            { "b": "来", "r": "こ" },
            { "b": "られるし、この " },
            { "b": "店", "r": "みせ" },
            { "b": "は とても " },
            { "b": "便利", "r": "べんり" },
            { "b": "です。" }
          ],
          "translation": "離車站既近,又可以開車來,這家店非常方便。"
        },
        {
          "id": "L28-S07",
          "ruby": [
            { "b": "息子", "r": "むすこ" },
            { "b": "に " },
            { "b": "英語", "r": "えいご" },
            { "b": "を " },
            { "b": "教", "r": "おし" },
            { "b": "えて いただけませんか。" }
          ],
          "translation": "能請您教我兒子英語嗎？"
        },
        {
          "id": "L28-S08",
          "ruby": [
            { "b": "…うーん、" },
            { "b": "出張", "r": "しゅっちょう" },
            { "b": "も " },
            { "b": "多", "r": "おお" },
            { "b": "いし、もうすぐ " },
            { "b": "日本語", "r": "にほんご" },
            { "b": "の " },
            { "b": "試験", "r": "しけん" },
            { "b": "も あるし、……。" }
          ],
          "translation": "…嗯,我出差又多,而且不久就有日語考試了……。"
        },
        {
          "id": "L28-S09",
          "ruby": [
            { "b": "色", "r": "いろ" },
            { "b": "も きれいだし、この " },
            { "b": "靴", "r": "くつ" },
            { "b": "を " },
            { "b": "買", "r": "か" },
            { "b": "います。" }
          ],
          "translation": "顏色也漂亮,就買這雙鞋。"
        }
      ]
    },
    {
      "id": "L28-G04",
      "pattern": "それに",
      "explanation": "「それに」表示在某一事情和情況中,再添加另一個事情和情況時。",
      "examples": [
        {
          "id": "L28-S10",
          "ruby": [
            { "b": "どうして さくら " },
            { "b": "大学", "r": "だいがく" },
            { "b": "を " },
            { "b": "選", "r": "えら" },
            { "b": "んだんですか。" }
          ],
          "translation": "為什麼選擇了櫻花大學？"
        },
        {
          "id": "L28-S11",
          "ruby": [
            { "b": "…さくら " },
            { "b": "大学", "r": "だいがく" },
            { "b": "は、" },
            { "b": "父", "r": "ちち" },
            { "b": "が " },
            { "b": "出", "r": "で" },
            { "b": "た " },
            { "b": "大学", "r": "だいがく" },
            { "b": "だし、いい " },
            { "b": "先生", "r": "せんせい" },
            { "b": "も " },
            { "b": "多", "r": "おお" },
            { "b": "いし、それに " },
            { "b": "家", "r": "いえ" },
            { "b": "から " },
            { "b": "近", "r": "ちか" },
            { "b": "いですから。" }
          ],
          "translation": "…因為櫻花大學是我父親畢業的大學,好老師也很多,而且離家也近。"
        }
      ]
    },
    {
      "id": "L28-G05",
      "pattern": "それで",
      "explanation": "「それで」是個表示其前面敘述的事情,是「それで」後面接續句子的理由和原因的接續詞。",
      "examples": [
        {
          "id": "L28-S12",
          "ruby": [
            { "b": "この レストランは " },
            { "b": "値段", "r": "ねだん" },
            { "b": "も " },
            { "b": "安", "r": "やす" },
            { "b": "いし、おいしいんです。" }
          ],
          "translation": "這家餐廳價格便宜,味道又好。"
        },
        {
          "id": "L28-S13",
          "ruby": [
            { "b": "…それで " },
            { "b": "人", "r": "ひと" },
            { "b": "が " },
            { "b": "多", "r": "おお" },
            { "b": "いんですね。" }
          ],
          "translation": "…所以人才這麼多啊。"
        }
      ]
    },
    {
      "id": "L28-G06",
      "pattern": "よく この 喫茶店に 来るんですか",
      "explanation": "在這個句子(參考練習C2)中,用表示到達點的助詞「に」取代表示方向的助詞「へ」。「いきます」「きます」「かえります」和「しゅっちょうします」等動詞,可以和「場所へ」「場所に」中任何一個一起用。",
      "examples": [
        {
          "id": "L28-S14",
          "ruby": [
            { "b": "よく この " },
            { "b": "喫茶店", "r": "きっさてん" },
            { "b": "に " },
            { "b": "来", "r": "く" },
            { "b": "るんですか。" }
          ],
          "translation": "您常來這家咖啡店嗎？"
        }
      ]
    }
  ],
