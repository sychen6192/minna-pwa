  "grammar": [
    {
      "id": "L46-G01",
      "pattern": "動詞辞書形／て形 いる／た形 ＋ ところです",
      "explanation": "「ところ」本來是表示場所的詞，但也表示時間的位置。本課中學的「ところ」是後者，用於強調某個動作或事件在進行過程中，現在處於什麼樣的局面時。1) 動詞辭書形ところです：表示某件事即將開始前，或某件事開始的意思。和「これから」「［ちょうど］いまから」等詞一起使用時，意思更加清楚。2) 動詞て形いるところです：表示某個動作正在進行中，常和「いま」一起使用。3) 動詞た形ところです：表示某件事剛剛結束，常和「たったいま」等副詞一起使用。〔註〕「〜ところです」是名詞句，可以接續各種句型。",
      "examples": [
        {
          "id": "L46-S01",
          "ruby": [
            { "b": "昼", "r": "ひる" },
            { "b": "ごはんは もう " },
            { "b": "食", "r": "た" },
            { "b": "べましたか。" }
          ],
          "translation": "吃過午飯了嗎？"
        },
        {
          "id": "L46-S02",
          "ruby": [
            { "b": "…いいえ、これから " },
            { "b": "食", "r": "た" },
            { "b": "べる ところです。" }
          ],
          "translation": "…還沒有，現在正準備要吃。"
        },
        {
          "id": "L46-S03",
          "ruby": [
            { "b": "会議", "r": "かいぎ" },
            { "b": "は もう " },
            { "b": "始", "r": "はじ" },
            { "b": "まりましたか。" }
          ],
          "translation": "會議開始了嗎？"
        },
        {
          "id": "L46-S04",
          "ruby": [
            { "b": "…いいえ、" },
            { "b": "今", "r": "いま" },
            { "b": "から " },
            { "b": "始", "r": "はじ" },
            { "b": "まる ところです。" }
          ],
          "translation": "…還沒有，剛要開始。"
        },
        {
          "id": "L46-S05",
          "ruby": [
            { "b": "故障", "r": "こしょう" },
            { "b": "の " },
            { "b": "原因", "r": "げんいん" },
            { "b": "が わかりましたか。" }
          ],
          "translation": "故障的原因清楚了嗎？"
        },
        {
          "id": "L46-S06",
          "ruby": [
            { "b": "…いいえ、" },
            { "b": "今", "r": "いま" },
            { "b": " " },
            { "b": "調", "r": "しら" },
            { "b": "べて いる ところです。" }
          ],
          "translation": "…還不清楚，現在正在調查。"
        },
        {
          "id": "L46-S07",
          "ruby": [
            { "b": "渡辺", "r": "わたなべ" },
            { "b": "さんは いますか。" }
          ],
          "translation": "渡邊小姐在嗎？"
        },
        {
          "id": "L46-S08",
          "ruby": [
            { "b": "…あ、たった " },
            { "b": "今", "r": "いま" },
            { "b": " " },
            { "b": "帰", "r": "かえ" },
            { "b": "った ところです。" }
          ],
          "translation": "…啊，她剛回去。"
        },
        {
          "id": "L46-S09",
          "ruby": [
            { "b": "まだ エレベーターの " },
            { "b": "所", "r": "ところ" },
            { "b": "に いるかも しれません。" }
          ],
          "translation": "也許還在電梯附近。"
        },
        {
          "id": "L46-S10",
          "ruby": [
            { "b": "たった " },
            { "b": "今", "r": "いま" },
            { "b": " バスが " },
            { "b": "出", "r": "で" },
            { "b": "た ところです。" }
          ],
          "translation": "公車剛開走。"
        },
        {
          "id": "L46-S11",
          "ruby": [
            { "b": "もしもし " },
            { "b": "田中", "r": "たなか" },
            { "b": "ですが、" },
            { "b": "今", "r": "いま" },
            { "b": " いいでしょうか。" }
          ],
          "translation": "喂喂，我是田中，現在方便嗎？"
        },
        {
          "id": "L46-S12",
          "ruby": [
            { "b": "…すみません。" },
            { "b": "今", "r": "いま" },
            { "b": "から " },
            { "b": "出", "r": "で" },
            { "b": "かける ところなんです。" }
          ],
          "translation": "…對不起，我正要出門。"
        }
      ]
    },
    {
      "id": "L46-G02",
      "pattern": "動詞た形 ＋ ばかりです",
      "explanation": "這個句型表示某個動作進行過，或者某個事件發生後沒過多久的說話者心情。不管實際上時間經過的長短，只要說話者覺得短就可以用這個句型，這一點和表示動作剛剛完成的「動詞た形 ところです」不同。〔註〕「〜ばかりです」是名詞句，可以接續各種句型。",
      "examples": [
        {
          "id": "L46-S13",
          "ruby": [
            { "b": "さっき " },
            { "b": "昼", "r": "ひる" },
            { "b": "ごはんを " },
            { "b": "食", "r": "た" },
            { "b": "べた ばかりです。" }
          ],
          "translation": "我剛吃過午飯。"
        },
        {
          "id": "L46-S14",
          "ruby": [
            { "b": "木村", "r": "きむら" },
            { "b": "さんは " },
            { "b": "先月", "r": "せんげつ" },
            { "b": " この " },
            { "b": "会社", "r": "かいしゃ" },
            { "b": "に " },
            { "b": "入", "r": "はい" },
            { "b": "った ばかりです。" }
          ],
          "translation": "木村先生上個月剛進這家公司。"
        },
        {
          "id": "L46-S15",
          "ruby": [
            { "b": "この ビデオは " },
            { "b": "先週", "r": "せんしゅう" },
            { "b": " " },
            { "b": "買", "r": "か" },
            { "b": "った ばかりなのに、" },
            { "b": "調子", "r": "ちょうし" },
            { "b": "が おかしいです。" }
          ],
          "translation": "這台攝影機上個月才買的，狀態卻很差。"
        }
      ]
    },
    {
      "id": "L46-G03",
      "pattern": "動詞辞書形／ない形 ない／い形容詞／な形容詞 な／名詞 の ＋ はずです",
      "explanation": "這個句型用於說話者按照某種依據，很自信地陳述自己所下的判斷時。在例句中，“昨天打過電話”是判斷的依據，按照這個依據，說話者自己下了“米勒先生會來”這個判斷，對此判斷的自信是藉著「〜はずです」來表達的。",
      "examples": [
        {
          "id": "L46-S16",
          "ruby": [
            { "b": "ミラーさんは きょう " },
            { "b": "来", "r": "く" },
            { "b": "るでしょうか。" }
          ],
          "translation": "米勒先生今天會來嗎？"
        },
        {
          "id": "L46-S17",
          "ruby": [
            { "b": "…" },
            { "b": "来", "r": "く" },
            { "b": "る はずですよ。 きのう " },
            { "b": "電話", "r": "でんわ" },
            { "b": "が ありましたから。" }
          ],
          "translation": "…應該會來的，昨天他打過電話。"
        }
      ]
    }
  ],
