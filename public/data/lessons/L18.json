  "grammar": [
    {
      "id": "L18-G01",
      "pattern": "名詞／動詞辞書形 ことが できます",
      "explanation": "〔動詞辞書形〕這是動詞的基本形,因為是字典裡的形態,所以叫做字典形。動詞字典形的變化如下。Ⅰ類:由於這類動詞ます形的最後一音都是い段,所以把い段換成う段即可。Ⅱ類:這一類動詞在ます形後加上「る」。Ⅲ類:「します」的字典形是「する」;「きます」的字典形是「くる」。 「できます」是表示能力和可能的動詞。「が」前面的名詞、「動詞字典形 こと」表示能力或可能的內容。名詞的情況:「が」前面的名詞多為表示動作的名詞(運動、買東西、滑雪、跳舞等),但是像「にほんご」「ピアノ」般,暗示「はなす」「ひく」等動作的名詞也可以使用。動詞的情況:要表示某個動作可以做到時,在該動詞的字典形後加「こと」改成名詞句,後面再接續「が できます」。",
      "examples": [
        {
          "id": "L18-S01",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "日本語", "r": "にほんご" },
            { "b": "が できます。" }
          ],
          "translation": "米勒先生會說日語。"
        },
        {
          "id": "L18-S02",
          "ruby": [
            { "b": "雪", "r": "ゆき" },
            { "b": "が たくさん " },
            { "b": "降", "r": "ふ" },
            { "b": "りましたから、ことしは スキーが できます。" }
          ],
          "translation": "下了很多雪,所以今年可以滑雪。"
        },
        {
          "id": "L18-S03",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "漢字", "r": "かんじ" },
            { "b": "を " },
            { "b": "読", "r": "よ" },
            { "b": "む ことが できます。" }
          ],
          "translation": "米勒先生會讀漢字。"
        },
        {
          "id": "L18-S04",
          "ruby": [
            { "b": "カードで " },
            { "b": "払", "r": "はら" },
            { "b": "う ことが できます。" }
          ],
          "translation": "可以用信用卡付款。"
        }
      ]
    },
    {
      "id": "L18-G02",
      "pattern": "わたしの 趣味は 動詞辞書形 ことです",
      "explanation": "用名詞子句「動詞字典形こと」,就像以下例句般,可以將興趣的內容表現得比只說名詞更具體。",
      "examples": [
        {
          "id": "L18-S05",
          "ruby": [
            { "b": "わたしの " },
            { "b": "趣味", "r": "しゅみ" },
            { "b": "は " },
            { "b": "音楽", "r": "おんがく" },
            { "b": "です。" }
          ],
          "translation": "我的興趣是音樂。"
        },
        {
          "id": "L18-S06",
          "ruby": [
            { "b": "わたしの " },
            { "b": "趣味", "r": "しゅみ" },
            { "b": "は " },
            { "b": "音楽", "r": "おんがく" },
            { "b": "を " },
            { "b": "聞", "r": "き" },
            { "b": "く ことです。" }
          ],
          "translation": "我的興趣是聽音樂。"
        }
      ]
    },
    {
      "id": "L18-G03",
      "pattern": "動詞辞書形／名詞の／数量詞（期間） まえに、動詞2",
      "explanation": "動詞的情況:表示動詞1的動作在動詞2的動作之前發生。不論動詞2是表示過去還是未來,動詞1都用字典形。名詞的情況:「まえに」接在名詞後面時,名詞後要加助詞「の」。會在「まえに」前面的名詞,都是表示動作的名詞或暗示動作的名詞。數量詞(期間)的情況:接續在數量詞(期間)後面時不加助詞「の」。",
      "examples": [
        {
          "id": "L18-S07",
          "ruby": [
            { "b": "日本", "r": "にほん" },
            { "b": "へ " },
            { "b": "来", "r": "く" },
            { "b": "る まえに、" },
            { "b": "日本語", "r": "にほんご" },
            { "b": "を " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "しました。" }
          ],
          "translation": "來日本之前學了日語。"
        },
        {
          "id": "L18-S08",
          "ruby": [
            { "b": "寝", "r": "ね" },
            { "b": "る まえに、" },
            { "b": "本", "r": "ほん" },
            { "b": "を " },
            { "b": "読", "r": "よ" },
            { "b": "みます。" }
          ],
          "translation": "睡覺前要看看書。"
        },
        {
          "id": "L18-S09",
          "ruby": [
            { "b": "食事", "r": "しょくじ" },
            { "b": "の まえに、" },
            { "b": "手", "r": "て" },
            { "b": "を " },
            { "b": "洗", "r": "あら" },
            { "b": "います。" }
          ],
          "translation": "進餐前要洗手。"
        },
        {
          "id": "L18-S10",
          "ruby": [
            { "b": "田中", "r": "たなか" },
            { "b": "さんは 1 " },
            { "b": "時間", "r": "じかん" },
            { "b": "まえに、" },
            { "b": "出", "r": "で" },
            { "b": "かけました。" }
          ],
          "translation": "田中先生 1 小時前出去了。"
        }
      ]
    },
    {
      "id": "L18-G04",
      "pattern": "なかなか",
      "explanation": "「なかなか」的後面接續否定詞,表示\"不能輕易……\",\"不像期望中的那麼……\"。",
      "examples": [
        {
          "id": "L18-S11",
          "ruby": [
