            { "b": "北海道", "r": "ほっかいどう" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "きたいです。" }
          ],
          "translation": "很想去北海道。"
        },
        {
          "id": "L18-S13",
          "ruby": [
            { "b": "ぜひ " },
            { "b": "遊", "r": "あそ" },
            { "b": "びに " },
            { "b": "来", "r": "き" },
            { "b": "て ください。" }
          ],
          "translation": "請務必要來玩。"
        }
      ]
    }
  ],
