  "grammar": [
    {
      "id": "L47-G01",
      "pattern": "普通形 そうです（聽說…）",
      "explanation": "是說話者將從某處得到的訊息,不加自己的意見傳達給聽話者的表達方式,如果要顯示訊息出處的話,用「〜に よると」形式在句首表示。",
      "examples": [
        {
          "id": "L47-S01",
          "ruby": [
            { "b": "天気予報", "r": "てんきよほう" },
            { "b": "に よると、あしたは " },
            { "b": "寒", "r": "さむ" },
            { "b": "く なるそうです。" }
          ],
          "translation": "根據天氣預報,聽說明天會變冷。"
        },
        {
          "id": "L47-S02",
          "ruby": [
            { "b": "クララさんは " },
            { "b": "子", "r": "こ" },
            { "b": "どもの とき、フランスに " },
            { "b": "住", "r": "す" },
            { "b": "んで いたそうです。" }
          ],
          "translation": "聽說克拉拉小姐小時候住在法國。"
        },
        {
          "id": "L47-S03",
          "ruby": [
            { "b": "バリ" },
            { "b": "島", "r": "とう" },
            { "b": "は とても きれいだそうです。" }
          ],
          "translation": "聽說巴里島很漂亮。"
        },
        {
          "id": "L47-S04",
          "ruby": [
            { "b": "雨", "r": "あめ" },
            { "b": "が " },
            { "b": "降", "r": "ふ" },
            { "b": "るそうです。" }
          ],
          "translation": "聽說會下雨。"
        },
        {
          "id": "L47-S05",
          "ruby": [
            { "b": "この " },
            { "b": "料理", "r": "りょうり" },
            { "b": "は おいしいそうです。" }
          ],
          "translation": "聽說這道菜很好吃。"
        },
        {
          "id": "L47-S06",
          "ruby": [
            { "b": "ミラーさんは あした " },
            { "b": "京都", "r": "きょうと" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "くそうです。" }
          ],
          "translation": "聽說米勒先生明天要去京都。"
        }
      ]
    },
    {
      "id": "L47-G02",
      "pattern": "普通形 ようです（好像…）",
      "explanation": "「〜ようです」表示說話者以感覺器官等得到的訊息為依據所做的主觀推測。接續:動詞、い形容詞用普通形;な形容詞「〜だ→〜な」;名詞「〜だ→〜の」。另外,這個句型常和表示「不確定自己說的是不是事實」的副詞「どうも」一起使用。",
      "examples": [
        {
          "id": "L47-S07",
          "ruby": [
            { "b": "人", "r": "ひと" },
            { "b": "が " },
            { "b": "大勢", "r": "おおぜい" },
            { "b": " " },
            { "b": "集", "r": "あつ" },
            { "b": "まって いますね。" }
          ],
          "translation": "人聚得真多呀。"
        },
        {
          "id": "L47-S08",
          "ruby": [
            { "b": "…" },
            { "b": "事故", "r": "じこ" },
            { "b": "のようですね。 パトカーと " },
            { "b": "救急車", "r": "きゅうきゅうしゃ" },
            { "b": "が " },
            { "b": "来", "r": "き" },
            { "b": "て いますよ。" }
          ],
          "translation": "…好像發生了車禍,警車和救護車都來了。"
        },
        {
          "id": "L47-S09",
          "ruby": [
            { "b": "せきも " },
            { "b": "出", "r": "で" },
            { "b": "るし、 " },
            { "b": "頭", "r": "あたま" },
            { "b": "も " },
            { "b": "痛", "r": "いた" },
            { "b": "い。どうも かぜを ひいたようだ。" }
          ],
          "translation": "又咳嗽,頭也痛,好像是感冒了。"
        },
        {
          "id": "L47-S10",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "忙", "r": "いそが" },
            { "b": "しいようです。" }
          ],
          "translation": "米勒先生好像很忙。"
        }
      ]
    },
    {
      "id": "L47-G03",
      "pattern": "声／音／におい／味が します",
      "explanation": "表示由感覺器官捕捉到的現象時,用「〜が します」。採取這種形式的有「こえが します」「においが します」「あじが します」等。這些表達方式都與說話者的意志無關,只是表示感覺到的意思。",
      "examples": [
        {
          "id": "L47-S11",
          "ruby": [
            { "b": "変", "r": "へん" },
            { "b": "な " },
            { "b": "音", "r": "おと" },
            { "b": "が しますね。" }
          ],
          "translation": "有奇怪的聲音。"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L47-D01",
      "ruby": [
        { "b": "お" },
        { "b": "先", "r": "さき" },
        { "b": "に " },
        { "b": "失礼", "r": "しつれい" },
        { "b": "します。" }
      ],
      "translation": "我先告辭了。",
      "speaker": "渡辺"
    },
    {
      "id": "L47-D02",
      "ruby": [
        { "b": "あっ、" },
        { "b": "渡辺", "r": "わたなべ" },
        { "b": "さん、ちょっと " },
        { "b": "待", "r": "ま" },
        { "b": "って。 " },
        { "b": "僕", "r": "ぼく" },
        { "b": "も " },
        { "b": "帰", "r": "かえ" },
        { "b": "りますから……。" }
      ],
      "translation": "啊,渡邊先生,等一下。我也要回去了……。",
      "speaker": "高橋"
    },
    {
      "id": "L47-D03",
      "ruby": [
        { "b": "すみません、ちょっと " },
        { "b": "急", "r": "いそ" },
        { "b": "ぎますから。" }
      ],
      "translation": "不好意思,我有點急。",
      "speaker": "渡辺"
    },
    {
      "id": "L47-D04",
      "ruby": [
        { "b": "渡辺", "r": "わたなべ" },
        { "b": "さん、このごろ " },
        { "b": "早", "r": "はや" },
        { "b": "く " },
        { "b": "帰", "r": "かえ" },
        { "b": "りますね。 どうも " },
        { "b": "恋人", "r": "こいびと" },
        { "b": "が できたようですね。" }
      ],
      "translation": "渡邊先生最近都很早回去呢。總覺得好像是交了戀人了。",
      "speaker": "高橋"
    },
    {
      "id": "L47-D05",
      "ruby": [
        { "b": "あ、" },
        { "b": "知", "r": "し" },
        { "b": "らないんですか。 この" },
        { "b": "間", "r": "あいだ" },
        { "b": " " },
        { "b": "婚約", "r": "こんやく" },
        { "b": "したそうですよ。" }
      ],
      "translation": "啊,你不知道嗎?聽說他前陣子訂婚了喔。",
      "speaker": "林"
    },
    {
      "id": "L47-D06",
      "ruby": [
        { "b": "えっ、だれですか、" },
        { "b": "相手", "r": "あいて" },
        { "b": "は。" }
      ],
      "translation": "咦,對象是誰啊?",
      "speaker": "高橋"
    },
    {
      "id": "L47-D07",
      "ruby": [
        { "b": "IMCの " },
        { "b": "鈴木", "r": "すずき" },
        { "b": "さんですよ。" }
      ],
      "translation": "是 IMC 的鈴木小姐喔。",
      "speaker": "林"
    },
    {
      "id": "L47-D08",
      "ruby": [
        { "b": "えっ、" },
        { "b": "鈴木", "r": "すずき" },
        { "b": "さん？" }
      ],
      "translation": "咦,鈴木小姐?",
      "speaker": "高橋"
    },
    {
      "id": "L47-D09",
      "ruby": [
        { "b": "去年", "r": "きょねん" },
        { "b": " " },
        { "b": "渡辺", "r": "わたなべ" },
        { "b": "さんの " },
        { "b": "友達", "r": "ともだち" },
        { "b": "の " },
        { "b": "結婚式", "r": "けっこんしき" },
        { "b": "で " },
        { "b": "知", "r": "し" },
        { "b": "り" },
        { "b": "合", "r": "あ" },
        { "b": "ったそうですよ。" }
      ],
      "translation": "聽說是去年在渡邊先生朋友的婚禮上認識的喔。",
      "speaker": "林"
    },
    {
      "id": "L47-D10",
      "ruby": [{ "b": "そうですか。" }],
      "translation": "這樣啊。",
      "speaker": "高橋"
    },
    {
      "id": "L47-D11",
      "ruby": [
        { "b": "ところで、" },
        { "b": "高橋", "r": "たかはし" },
        { "b": "さんは？" }
      ],
      "translation": "話說回來,高橋先生你呢?",
      "speaker": "林"
    },
    {
      "id": "L47-D12",
      "ruby": [
        { "b": "僕", "r": "ぼく" },
        { "b": "ですか。 " },
        { "b": "僕", "r": "ぼく" },
        { "b": "は " },
        { "b": "仕事", "r": "しごと" },
        { "b": "が " },
        { "b": "恋人", "r": "こいびと" },
        { "b": "です。" }
      ],
      "translation": "我嗎?我的戀人是工作。",
      "speaker": "高橋"
    }
  ]
}
