  "grammar": [
    {
      "id": "L50-G01",
      "pattern": "謙譲語：お／ご〜します",
      "explanation": "「けんじょうご」是說話人為了對聽話人或話題中出現的人物表示敬意,將自身行為貶低的一種表達方式。敬意的對象為上面的人或「ソトの ひと」。此外,說話者對「ソトの ひと」說起「ウチの ひと」的時候,也用「けんじょうご」。「お動詞(Ⅰ、Ⅱ類)ます形します」、「ご動詞(Ⅲ類)します」用於除動作主外還有接受行為的對方、且須對該對方表示敬意時;當不存在行為的接受人時不能使用。ます形為單音節的動詞(みます、います等)不能使用此句型。「でんわします」、「やくそくします」等是例外,用「お」而非「ご」。",
      "examples": [
        {
          "id": "L50-S01",
          "ruby": [
            { "b": "重", "r": "おも" },
            { "b": "そうですね。お " },
            { "b": "持", "r": "も" },
            { "b": "ちしましょうか。" }
          ],
          "translation": "看起來蠻重的,我來拿吧。"
        },
        {
          "id": "L50-S02",
          "ruby": [
            { "b": "私", "r": "わたくし" },
            { "b": "が " },
            { "b": "社長", "r": "しゃちょう" },
            { "b": "に スケジュールを お " },
            { "b": "知", "r": "し" },
            { "b": "らせします。" }
          ],
          "translation": "我來報告總經理日程安排。"
        },
        {
          "id": "L50-S03",
          "ruby": [
            { "b": "兄", "r": "あに" },
            { "b": "が " },
            { "b": "車", "r": "くるま" },
            { "b": "で お " },
            { "b": "送", "r": "おく" },
            { "b": "りします。" }
          ],
          "translation": "家兄開車送您。"
        },
        {
          "id": "L50-S04",
          "ruby": [
            { "b": "江戸東京博物館", "r": "えどとうきょうはくぶつかん" },
            { "b": "へ ご " },
            { "b": "案内", "r": "あんない" },
            { "b": "します。" }
          ],
          "translation": "我帶您去江戶東京博物館。"
        },
        {
          "id": "L50-S05",
          "ruby": [
            { "b": "きょうの " },
            { "b": "予定", "r": "よてい" },
            { "b": "を ご " },
            { "b": "説明", "r": "せつめい" },
            { "b": "します。" }
          ],
          "translation": "向大家說明今天的行程。"
        }
      ]
    },
    {
      "id": "L50-G02",
      "pattern": "特殊謙譲動詞",
      "explanation": "有些動詞自身就含有謙遜的意思。例如:(1)說話人的行為和聽話人以及話題中的人物有關係時,用「おめに かかります」(あいます)、「うかがいます」(ききます、いきます)等;(2)說話人的行為和聽話人以及話題中的人物無關時,用「もうします」(いいます)、「まいります」(きます、いきます)等。",
      "examples": [
        {
          "id": "L50-S06",
          "ruby": [
            { "b": "社長", "r": "しゃちょう" },
            { "b": "の " },
            { "b": "奥", "r": "おく" },
            { "b": "さまに お " },
            { "b": "目", "r": "め" },
            { "b": "に かかりました。" }
          ],
          "translation": "我見到總經理夫人了。"
        },
        {
          "id": "L50-S07",
          "ruby": [
            { "b": "あしたは だれが " },
            { "b": "手伝", "r": "てつだ" },
            { "b": "いに " },
            { "b": "来", "r": "き" },
            { "b": "て くれますか。" }
          ],
          "translation": "明天誰會來幫忙呀？"
        },
        {
          "id": "L50-S08",
          "ruby": [
            { "b": "…" },
            { "b": "私", "r": "わたくし" },
            { "b": "が " },
            { "b": "伺", "r": "うかが" },
            { "b": "います。" }
          ],
          "translation": "…我會來。"
        },
        {
          "id": "L50-S09",
          "ruby": [
            { "b": "ミラーと " },
            { "b": "申", "r": "もう" },
            { "b": "します。" }
          ],
          "translation": "敝姓米勒。"
        },
        {
          "id": "L50-S10",
          "ruby": [
            { "b": "アメリカから " },
            { "b": "参", "r": "まい" },
            { "b": "りました。" }
          ],
          "translation": "我從美國來。"
        }
      ]
    },
    {
      "id": "L50-G03",
      "pattern": "丁寧語：ございます",
      "explanation": "「ていねいご」是指說話人為了向聽話人表示敬意時用的禮貌表達方式。「ございます」是「あります」的禮貌語。",
      "examples": [
        {
          "id": "L50-S11",
          "ruby": [
            { "b": "電話", "r": "でんわ" },
            { "b": "は " },
            { "b": "階段", "r": "かいだん" },
            { "b": "の " },
            { "b": "横", "r": "よこ" },
            { "b": "に ございます。" }
          ],
          "translation": "電話在樓梯旁邊。"
        }
      ]
    },
    {
      "id": "L50-G04",
      "pattern": "丁寧語：〜で ございます",
      "explanation": "「〜で ございます」是「〜です」的禮貌語。",
      "examples": [
