  "grammar": [
    {
      "id": "L31-G01",
      "pattern": "意向形",
      "explanation": "動詞意向形的變換方法如下。Ⅰ類:將動詞「ます形」最後的假名改為同一行的「お段」假名,再加上「う」。Ⅱ類:在動詞「ます形」後加上「よう」。Ⅲ類:「きます」的意向形是「こよう」,「します」的意向形是「しよう」。",
      "examples": [
        {
          "id": "L31-S01",
          "ruby": [
            { "b": "ちょっと " },
            { "b": "休", "r": "やす" },
            { "b": "まない?" }
          ],
          "translation": "不休息一下嗎?"
        },
        {
          "id": "L31-S02",
          "ruby": [
            { "b": "…うん、" },
            { "b": "休", "r": "やす" },
            { "b": "もう。" }
          ],
          "translation": "…嗯,休息一下吧。"
        },
        {
          "id": "L31-S03",
          "ruby": [
            { "b": "少", "r": "すこ" },
            { "b": "し " },
            { "b": "休", "r": "やす" },
            { "b": "もうか。" }
          ],
          "translation": "休息一下吧。"
        },
        {
          "id": "L31-S04",
          "ruby": [
            { "b": "手伝", "r": "てつだ" },
            { "b": "おうか。" }
          ],
          "translation": "我幫幫你吧。"
        }
      ]
    },
    {
      "id": "L31-G02",
      "pattern": "意向形の用法",
      "explanation": "1) 用於常體的句子中。意向形作為「〜ましょう」的常體形,用於常體的句子中。〔註〕例句②③雖然是常體的疑問句,但句尾的助詞「か」不能省略。",
      "examples": [
        {
          "id": "L31-S05",
          "ruby": [
            { "b": "ちょっと " },
            { "b": "休", "r": "やす" },
            { "b": "まない?" }
          ],
          "translation": "不休息一下嗎?"
        },
        {
          "id": "L31-S06",
          "ruby": [
            { "b": "…うん、" },
            { "b": "休", "r": "やす" },
            { "b": "もう。" }
          ],
          "translation": "…嗯,休息一下吧。"
        },
        {
          "id": "L31-S07",
          "ruby": [
            { "b": "少", "r": "すこ" },
            { "b": "し " },
            { "b": "休", "r": "やす" },
            { "b": "もうか。" }
          ],
          "translation": "休息一下吧。"
        },
        {
          "id": "L31-S08",
          "ruby": [
            { "b": "手伝", "r": "てつだ" },
            { "b": "おうか。" }
          ],
          "translation": "我幫幫你吧。"
        }
      ]
    },
    {
      "id": "L31-G03",
      "pattern": "動詞意向形と 思って います",
      "explanation": "這個句型用於向對方表明說話人的意志時。「動詞意向形と おもいます」也用在同樣的意思上,但是「動詞意向形と おもって います」含有在說話前已經下決心,且現在還仍然持續的意思。〔註〕「動詞意向形と おもって います」也可以表示第三者的意志。",
      "examples": [
        {
          "id": "L31-S09",
          "ruby": [
            { "b": "週末", "r": "しゅうまつ" },
            { "b": "は " },
            { "b": "海", "r": "うみ" },
            { "b": "に " },
            { "b": "行", "r": "い" },
            { "b": "こうと " },
            { "b": "思", "r": "おも" },
            { "b": "って います。" }
          ],
          "translation": "週末我想去海邊。"
        },
        {
          "id": "L31-S10",
          "ruby": [
            { "b": "今", "r": "いま" },
            { "b": "から " },
            { "b": "銀行", "r": "ぎんこう" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "こうと " },
            { "b": "思", "r": "おも" },
            { "b": "います。" }
          ],
          "translation": "我現在想去銀行。"
        },
        {
          "id": "L31-S11",
          "ruby": [
            { "b": "彼", "r": "かれ" },
            { "b": "は " },
            { "b": "外国", "r": "がいこく" },
            { "b": "で " },
            { "b": "働", "r": "はたら" },
            { "b": "こうと " },
            { "b": "思", "r": "おも" },
            { "b": "って います。" }
          ],
          "translation": "他想到外國工作。"
        }
      ]
    },
    {
      "id": "L31-G04",
      "pattern": "動詞辞書形／動詞ない形 ない つもりです",
      "explanation": "表示做某個動作的意志要用「動詞字典形 つもりです」,而表示不做的意志要用「動詞ない形ない つもりです」。〔註〕「動詞意向形と おもって います」與「動詞字典形 つもりです」在意義上沒有什麼差別,但要表示肯定的意願和堅定的決心時,一般多用「動詞字典形 つもりです」。",
      "examples": [
        {
          "id": "L31-S12",
          "ruby": [
            { "b": "国", "r": "くに" },
            { "b": "へ " },
            { "b": "帰", "r": "かえ" },
            { "b": "っても、" },
            { "b": "柔道", "r": "じゅうどう" },
            { "b": "を " },
            { "b": "続", "r": "つづ" },
            { "b": "ける つもりです。" }
          ],
          "translation": "回國以後我打算繼續練柔道。"
        },
        {
          "id": "L31-S13",
          "ruby": [
            { "b": "あしたからは たばこを " },
            { "b": "吸", "r": "す" },
            { "b": "わない つもりです。" }
          ],
          "translation": "從明天起我打算不吸煙了。"
        }
      ]
    },
    {
      "id": "L31-G05",
      "pattern": "動詞辞書形／名詞の 予定です",
      "explanation": "這種形式可以敘述預定的計劃。",
      "examples": [
        {
          "id": "L31-S14",
          "ruby": [
            { "b": "7" },
            { "b": "月", "r": "がつ" },
            { "b": "の " },
            { "b": "終", "r": "お" },
            { "b": "わりに ドイツへ " },
            { "b": "出張", "r": "しゅっちょう" },
            { "b": "する " },
            { "b": "予定", "r": "よてい" },
            { "b": "です。" }
          ],
          "translation": "7月底預定去德國出差。"
        },
        {
          "id": "L31-S15",
          "ruby": [
            { "b": "旅行", "r": "りょこう" },
            { "b": "は 1 " },
            { "b": "週間", "r": "しゅうかん" },
            { "b": "ぐらいの " },
            { "b": "予定", "r": "よてい" },
            { "b": "です。" }
          ],
          "translation": "旅行預定一星期左右。"
        }
      ]
    },
    {
      "id": "L31-G06",
      "pattern": "まだ 動詞て形 いません",
      "explanation": "這個句型表示目前事情沒有發生或動作沒有進行。",
      "examples": [
        {
          "id": "L31-S16",
          "ruby": [
            { "b": "銀行", "r": "ぎんこう" },
            { "b": "は まだ " },
            { "b": "開", "r": "あ" },
            { "b": "いて いません。" }
          ],
          "translation": "銀行還沒有開門。"
        },
        {
          "id": "L31-S17",
          "ruby": [
            { "b": "レポートは もう " },
            { "b": "書", "r": "か" },
            { "b": "きましたか。" }
          ],
          "translation": "報告已經寫了嗎?"
        },
        {
          "id": "L31-S18",
          "ruby": [
            { "b": "…いいえ、まだ " },
            { "b": "書", "r": "か" },
            { "b": "いて いません。" }
          ],
          "translation": "…不,還沒寫。"
        }
      ]
    },
    {
      "id": "L31-G07",
      "pattern": "こ〜／そ〜",
      "explanation": "在文章中指出前面出現過的詞或句時,用「そ」系列的指示語。但是當想要描繪得詡詡如生如在讀者眼前時,也有作者會用「こ」系列的指示語。",
      "examples": [
        {
          "id": "L31-S19",
          "ruby": [
            { "b": "東京", "r": "とうきょう" },
            { "b": "に ない " },
            { "b": "物", "r": "もの" },
            { "b": "が 1つだけ ある。それは " },
            { "b": "美", "r": "うつく" },
            { "b": "しい " },
            { "b": "自然", "r": "しぜん" },
            { "b": "だ。" }
          ],
          "translation": "東京只有一樣東西沒有,那就是美麗的大自然。"
        },
        {
          "id": "L31-S20",
          "ruby": [
            { "b": "わたしが いちばん " },
            { "b": "欲", "r": "ほ" },
            { "b": "しい " },
            { "b": "物", "r": "もの" },
            { "b": "は「どこでも ドア」です。この ドアを " },
            { "b": "開", "r": "あ" },
            { "b": "けると、どこでも " },
            { "b": "行", "r": "い" },
            { "b": "きたい " },
            { "b": "所", "r": "ところ" },
            { "b": "へ " },
            { "b": "行", "r": "い" },
            { "b": "けます。" }
          ],
          "translation": "我最想要的東西是「神奇的門」,打開這扇門,就可以到任何想去的地方。"
        }
      ]
    }
  ],
