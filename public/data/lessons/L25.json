  "grammar": [
    {
      "id": "L25-G01",
      "pattern": "普通形過去式 ら、〜",
      "explanation": "動詞、形容詞等的普通形過去式加上「ら」,表示某個事情、動作的假定條件。在此條件下陳述說話人的立場、意見、要求、狀況時,即使用這個句型表達。",
      "examples": [
        {
          "id": "L25-S01",
          "ruby": [
            { "b": "お" },
            { "b": "金", "r": "かね" },
            { "b": "が あったら、 " },
            { "b": "旅行", "r": "りょこう" },
            { "b": "します。" }
          ],
          "translation": "如果有錢的話就去旅行。"
        },
        {
          "id": "L25-S02",
          "ruby": [
            { "b": "時間", "r": "じかん" },
            { "b": "が なかったら、テレビを " },
            { "b": "見", "r": "み" },
            { "b": "ません。" }
          ],
          "translation": "如果沒有時間就不看電視。"
        },
        {
          "id": "L25-S03",
          "ruby": [
            { "b": "安", "r": "やす" },
            { "b": "かったら、パソコンを " },
            { "b": "買", "r": "か" },
            { "b": "いたいです。" }
          ],
          "translation": "如果便宜的話想買個人電腦。"
        },
        {
          "id": "L25-S04",
          "ruby": [
            { "b": "暇", "r": "ひま" },
            { "b": "だったら、 " },
            { "b": "手伝", "r": "てつだ" },
            { "b": "って ください。" }
          ],
          "translation": "如果有空的話請來幫忙。"
        },
        {
          "id": "L25-S05",
          "ruby": [
            { "b": "いい " },
            { "b": "天気", "r": "てんき" },
            { "b": "だったら、 " },
            { "b": "散歩", "r": "さんぽ" },
            { "b": "しませんか。" }
          ],
          "translation": "天氣好的話,去散步吧！"
        }
      ]
    },
    {
      "id": "L25-G02",
      "pattern": "動詞 て形 ら、〜",
      "explanation": "這個句型,表示在將來確定會發生的某事、動作、狀態完成之後,將進行另一個行為或動作,或發生某個狀況。主句的時態不會是過去式。",
      "examples": [
        {
          "id": "L25-S06",
          "ruby": [
            { "b": "10" },
            { "b": "時", "r": "じ" },
            { "b": "に なったら、 " },
            { "b": "出", "r": "で" },
            { "b": "かけましょう。" }
          ],
          "translation": "到了 10 點就出發吧！"
        },
        {
          "id": "L25-S07",
          "ruby": [
            { "b": "うちへ " },
            { "b": "帰", "r": "かえ" },
            { "b": "ったら、すぐ シャワーを " },
            { "b": "浴", "r": "あ" },
            { "b": "びます。" }
          ],
          "translation": "一回到家馬上就要沖個澡。"
        }
      ]
    },
    {
      "id": "L25-G03",
      "pattern": "動詞て形／〜くて／〜で も、〜",
      "explanation": "這個句型表示逆接條件。和「〜たら、〜」相反,在某個條件下,理所當然會進行的動作沒有被進行、當然會發生的事情沒有發生,或出現與社會慣例相反的結果時,便應使用這個句型。",
      "examples": [
        {
          "id": "L25-S08",
          "ruby": [
            { "b": "雨", "r": "あめ" },
            { "b": "が " },
            { "b": "降", "r": "ふ" },
            { "b": "っても、 " },
            { "b": "洗濯", "r": "せんたく" },
            { "b": "します。" }
          ],
          "translation": "即使下雨也要洗衣服。"
        },
        {
          "id": "L25-S09",
          "ruby": [
            { "b": "安", "r": "やす" },
            { "b": "くても、わたしは グループ " },
            { "b": "旅行", "r": "りょこう" },
            { "b": "が " },
            { "b": "嫌", "r": "きら" },
            { "b": "いです。" }
          ],
          "translation": "即使便宜我還是不喜歡團體旅行。"
        },
        {
          "id": "L25-S10",
          "ruby": [
            { "b": "便利", "r": "べんり" },
            { "b": "でも、パソコンを " },
            { "b": "使", "r": "つか" },
            { "b": "いません。" }
          ],
          "translation": "即使方便也不用個人電腦。"
        },
        {
          "id": "L25-S11",
          "ruby": [
            { "b": "日曜日", "r": "にちようび" },
            { "b": "でも、 " },
            { "b": "働", "r": "はたら" },
            { "b": "きます。" }
          ],
          "translation": "即使星期天也要工作。"
        }
      ]
    },
    {
      "id": "L25-G04",
      "pattern": "もし／いくら",
      "explanation": "分別用在「〜たら、〜」、「〜ても、〜」的句子裡,預告這個句子將會是條件句。「もし」強調說話人假設的心情,「いくら」則強調條件的程度。",
      "examples": [
        {
          "id": "L25-S12",
          "ruby": [
            { "b": "もし 1" },
            { "b": "億", "r": "おく" },
            { "b": "円", "r": "えん" },
            { "b": " あったら、いろいろな " },
            { "b": "国", "r": "くに" },
            { "b": "を " },
            { "b": "旅行", "r": "りょこう" },
            { "b": "したいです。" }
