  "grammar": [
    {
      "id": "L15-G01",
      "pattern": "動詞て形 も いいです",
      "explanation": "這是許可的表達方式。改成疑問句時,即成為要求許可的表達方式。他人以這個表達方式要求許可時的回答如③。要注意不許可時可說得委婉些。",
      "examples": [
        {
          "id": "L15-S01",
          "ruby": [
            { "b": "写真", "r": "しゃしん" },
            { "b": "を " },
            { "b": "撮", "r": "と" },
            { "b": "っても いいです。" }
          ],
          "translation": "可以照相。"
        },
        {
          "id": "L15-S02",
          "ruby": [
            { "b": "たばこを " },
            { "b": "吸", "r": "す" },
            { "b": "っても いいですか。" }
          ],
          "translation": "可以吸煙嗎？"
        },
        {
          "id": "L15-S03",
          "ruby": [
            { "b": "この カタログを もらっても いいですか。" }
          ],
          "translation": "這個目錄可以拿嗎？"
        },
        {
          "id": "L15-S04",
          "ruby": [
            { "b": "…ええ、いいですよ。どうぞ。" }
          ],
          "translation": "…可以,請。"
        },
        {
          "id": "L15-S05",
          "ruby": [
            { "b": "…すみません。ちょっと。" }
          ],
          "translation": "…對不起。不太……。"
        }
      ]
    },
    {
      "id": "L15-G02",
      "pattern": "動詞て形 は いけません",
      "explanation": "這是禁止的表達方式。回答「動詞て形も いいですか」時,如果強調不許可,即應省略「動詞て形は」,回答「いいえ、いけません」。但這個句型不能用在下級或晚輩對上級、長輩說話時。",
      "examples": [
        {
          "id": "L15-S06",
          "ruby": [
            { "b": "ここで たばこを " },
            { "b": "吸", "r": "す" },
            { "b": "っては いけません。" },
            { "b": "禁煙", "r": "きんえん" },
            { "b": "ですから。" }
          ],
          "translation": "這裡不可以吸煙。因為是禁煙的。"
        },
        {
          "id": "L15-S07",
          "ruby": [
            { "b": "先生", "r": "せんせい" },
            { "b": "、ここで " },
            { "b": "遊", "r": "あそ" },
            { "b": "んでも いいですか。" }
          ],
          "translation": "老師,可以在這裡玩嗎？"
        },
        {
          "id": "L15-S08",
          "ruby": [
            { "b": "…いいえ、いけません。" }
          ],
          "translation": "…不,不行。"
        }
      ]
    },
    {
      "id": "L15-G03",
      "pattern": "動詞て形 います",
      "explanation": "「動詞て形 います」在第14課第一次學到,它還可以表示某種狀態,也就是某個動作進行的結果殘留的狀態。「もって います」有現在手裡拿著和擁有的意思。",
      "examples": [
        {
          "id": "L15-S09",
          "ruby": [
            { "b": "わたしは " },
            { "b": "結婚", "r": "けっこん" },
            { "b": "して います。" }
          ],
          "translation": "我結婚了。"
        },
        {
          "id": "L15-S10",
          "ruby": [
            { "b": "わたしは " },
            { "b": "田中", "r": "たなか" },
            { "b": "さんを " },
            { "b": "知", "r": "し" },
            { "b": "って います。" }
          ],
          "translation": "我認識田中先生。"
        },
        {
          "id": "L15-S11",
          "ruby": [
            { "b": "わたしは " },
            { "b": "大阪", "r": "おおさか" },
            { "b": "に " },
            { "b": "住", "r": "す" },
            { "b": "んで います。" }
          ],
          "translation": "我住在大阪。"
        },
        {
          "id": "L15-S12",
          "ruby": [
            { "b": "わたしは カメラを " },
            { "b": "持", "r": "も" },
            { "b": "って います。" }
          ],
          "translation": "我有照相機。"
        }
      ]
    },
    {
      "id": "L15-G04",
      "pattern": "動詞て形 います",
      "explanation": "「動詞て形 います」還可以用來表示習慣性的行為,也就是長期反覆進行的動作。這個句型可以如⑫、⑬般表示職業和身分。「おしごとは なんですか」就可以用這句型回答。",
      "examples": [
        {
          "id": "L15-S13",
          "ruby": [
            { "b": "ＩＭＣは コンピューターソフトを " },
            { "b": "作", "r": "つく" },
            { "b": "って います。" }
          ],
          "translation": "ＩＭＣ 公司生產電腦軟體。"
        },
        {
          "id": "L15-S14",
          "ruby": [
            { "b": "スーパーで フィルムを " },
            { "b": "売", "r": "う" },
            { "b": "って います。" }
          ],
          "translation": "超級市場有底片出售。"
        },
        {
          "id": "L15-S15",
          "ruby": [
            { "b": "ミラーさんは ＩＭＣで " },
            { "b": "働", "r": "はたら" },
            { "b": "いて います。" }
          ],
          "translation": "米勒先生在 ＩＭＣ 公司工作。"
        },
        {
          "id": "L15-S16",
          "ruby": [
            { "b": "妹", "r": "いもうと" },
            { "b": "は " },
            { "b": "大学", "r": "だいがく" },
            { "b": "で " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "して います。" }
          ],
          "translation": "妹妹在大學念書。"
        }
      ]
    },
    {
      "id": "L15-G05",
      "pattern": "知りません",
      "explanation": "「しって います」的否定形式是「しりません」。",
      "examples": [
        {
          "id": "L15-S17",
          "ruby": [
            { "b": "市役所", "r": "しやくしょ" },
            { "b": "の " },
            { "b": "電話番号", "r": "でんわばんごう" },
            { "b": "を " },
            { "b": "知", "r": "し" },
            { "b": "って いますか。" }
          ],
          "translation": "你知道市政府的電話號碼嗎？"
        },
        {
          "id": "L15-S18",
          "ruby": [
            { "b": "…はい、" },
            { "b": "知", "r": "し" },
            { "b": "って います。" }
          ],
          "translation": "…是的,知道。"
        },
        {
          "id": "L15-S19",
          "ruby": [
            { "b": "…いいえ、" },
            { "b": "知", "r": "し" },
            { "b": "りません。" }
          ],
          "translation": "…不,不知道。"
        }
      ]
    }
  ],
