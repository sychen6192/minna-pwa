  "grammar": [
    {
      "id": "L04-G01",
      "pattern": "今 …時…分です",
      "explanation": "數字後面加上量詞「時」「分」表示時刻。「分」前面的數字是2、5、7、9時讀「ふん」;1、3、4、6、8、10時讀「ぷん」。「ぷん」的前面是1、6、8、10分別讀成「いっ」「ろっ」「はっ」「じゅっ（じっ）」。(參考初級Ⅰ本冊附錄Ⅱ)詢問帶量詞的數字時,要加「なん」在量詞前面。詢問時間時用「なんじ」和「なんぷん」。",
      "examples": [
        {
          "id": "L04-S01",
          "ruby": [
            { "b": "今", "r": "いま" },
            { "b": " " },
            { "b": "何時", "r": "なんじ" },
            { "b": "ですか。" }
          ],
          "translation": "現在幾點？"
        },
        {
          "id": "L04-S02",
          "ruby": [
            { "b": "…7" },
            { "b": "時", "r": "じ" },
            { "b": "10" },
            { "b": "分", "r": "ぷん" },
            { "b": "です。" }
          ],
          "translation": "…7 點 10 分。"
        },
        {
          "id": "L04-S03",
          "ruby": [
            { "b": "ニューヨークは " },
            { "b": "今", "r": "いま" },
            { "b": " " },
            { "b": "何時", "r": "なんじ" },
            { "b": "ですか。" }
          ],
          "translation": "紐約現在幾點？"
        },
        {
          "id": "L04-S04",
          "ruby": [
            { "b": "…" },
            { "b": "午前", "r": "ごぜん" },
            { "b": "4" },
            { "b": "時", "r": "じ" },
            { "b": "です。" }
          ],
          "translation": "…上午 4 點。"
        }
      ]
    },
    {
      "id": "L04-G02",
      "pattern": "動詞ます",
      "explanation": "1)動詞ます 起動詞述語的作用。2)ます 表示說話人對聽話人禮貌的態度。",
      "examples": [
        {
          "id": "L04-S05",
          "ruby": [
            { "b": "わたしは " },
            { "b": "毎日", "r": "まいにち" },
            { "b": " " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "します。" }
          ],
          "translation": "我每天念書。"
        }
      ]
    },
    {
      "id": "L04-G03",
      "pattern": "動詞ます／動詞ません／動詞ました／動詞ませんでした",
      "explanation": "1)「ます」使用在敘述現在的習慣性事情和真理,或未來將要做要發生的事情。否定形和過去式變化如下。非過去(現在、未來):肯定(おき)ます、否定(おき)ません;過去:肯定(おき)ました、否定(おき)ませんでした。2)疑問句和名詞句一樣不改變語序,在句尾加「か」完成。疑問詞放在想問的內容那部分。回答時重複疑問句中的動詞。「そうです」「そうじゃ ありません」(參考第2課)不能作為動詞述語疑問句的回答。",
      "examples": [
        {
          "id": "L04-S06",
          "ruby": [
            { "b": "毎朝", "r": "まいあさ" },
            { "b": " 6" },
            { "b": "時", "r": "じ" },
            { "b": "に " },
            { "b": "起", "r": "お" },
            { "b": "きます。" }
          ],
          "translation": "每天早上 6 點起床。"
        },
        {
          "id": "L04-S07",
          "ruby": [
            { "b": "あした 6" },
            { "b": "時", "r": "じ" },
            { "b": "に " },
            { "b": "起", "r": "お" },
            { "b": "きます。" }
          ],
          "translation": "明天 6 點起床。"
        },
        {
          "id": "L04-S08",
          "ruby": [
            { "b": "けさ 6" },
            { "b": "時", "r": "じ" },
            { "b": "に " },
            { "b": "起", "r": "お" },
            { "b": "きました。" }
          ],
          "translation": "今天早上 6 點起的床。"
        },
        {
          "id": "L04-S09",
          "ruby": [
            { "b": "きのう " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "しましたか。" }
          ],
          "translation": "昨天念書了嗎？"
        },
        {
          "id": "L04-S10",
          "ruby": [
            { "b": "… はい、 " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "しました。" }
          ],
          "translation": "…是的,念了書。"
        },
        {
          "id": "L04-S11",
          "ruby": [
            { "b": "… いいえ、 " },
            { "b": "勉強", "r": "べんきょう" },
            { "b": "しませんでした。" }
          ],
          "translation": "…不,沒念書。"
        },
        {
          "id": "L04-S12",
          "ruby": [
            { "b": "毎朝", "r": "まいあさ" },
            { "b": " " },
            { "b": "何時", "r": "なんじ" },
            { "b": "に " },
            { "b": "起", "r": "お" },
            { "b": "きますか。" }
          ],
          "translation": "每天早上幾點起床？"
        },
        {
          "id": "L04-S13",
          "ruby": [
            { "b": "…6" },
            { "b": "時", "r": "じ" },
            { "b": "に " },
            { "b": "起", "r": "お" },
            { "b": "きます。" }
          ],
          "translation": "… 6 點起床。"
        }
      ]
    },
    {
      "id": "L04-G04",
      "pattern": "名詞(時間)に 動詞",
      "explanation": "在表示時間的名詞後加助詞「に」,表示動作發生的時間。和瞬間動詞一起使用。「に」用在表示時間的名詞含有數字時,否則不用。表示星期時可用可不用。",
      "examples": [
        {
          "id": "L04-S14",
          "ruby": [
            { "b": "6" },
            { "b": "時半", "r": "じはん" },
            { "b": "に " },
            { "b": "起", "r": "お" },
            { "b": "きます。" }
          ],
          "translation": "6 點半起床。"
        },
        {
          "id": "L04-S15",
          "ruby": [
            { "b": "7" },
            { "b": "月", "r": "がつ" },
            { "b": "2" },
            { "b": "日", "r": "か" },
            { "b": "に " },
            { "b": "日本", "r": "にほん" },
            { "b": "へ " },
            { "b": "来", "r": "き" },
