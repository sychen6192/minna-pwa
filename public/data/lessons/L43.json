            { "b": "買", "r": "か" },
            { "b": "って " },
            { "b": "来", "r": "き" },
            { "b": "ます。" }
          ],
          "translation": "去超市買牛奶回來。"
        },
        {
          "id": "L43-S11",
          "ruby": [
            { "b": "台所", "r": "だいどころ" },
            { "b": "から コップを " },
