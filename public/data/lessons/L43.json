  "grammar": [
    {
      "id": "L43-G01",
      "pattern": "動詞ます形／い形容詞（〜い）／な形容詞［な］ + そうです",
      "explanation": "這個句型基本上是敘述以視覺獲得的訊息為依據進行的推測。動詞ます形そうです：根據現在看到的狀態預測某種現象時使用,再加上「いまにも」「もうすぐ」「これから」等,也可以敘述對該現象發生時期的預測。い形容詞（〜い）／な形容詞［な］そうです：表示儘管沒有實際上去確認,但從外觀考察好像是那樣的意思。〔註〕表示感情的形容詞（うれしい、かなしい、さびしい等）,在表示他人的感情時不能原樣使用,要在這些形容詞後面加上「〜そうです」,使用從外觀推測內心的形式。",
      "examples": [
        {
          "id": "L43-S01",
          "ruby": [
            { "b": "今", "r": "いま" },
            { "b": "にも " },
            { "b": "雨", "r": "あめ" },
            { "b": "が " },
            { "b": "降", "r": "ふ" },
            { "b": "りそうです。" }
          ],
          "translation": "看來馬上就要下雨了。"
        },
        {
          "id": "L43-S02",
          "ruby": [{ "b": "シャンプーが なくなりそうです。" }],
          "translation": "洗髮精看來快用完了。"
        },
        {
          "id": "L43-S03",
          "ruby": [
            { "b": "もうすぐ " },
            { "b": "桜", "r": "さくら" },
            { "b": "が " },
            { "b": "咲", "r": "さ" },
            { "b": "きそうです。" }
          ],
          "translation": "看來櫻花就要開了。"
        },
        {
          "id": "L43-S04",
          "ruby": [
            { "b": "これから " },
            { "b": "寒", "r": "さむ" },
            { "b": "く なりそうです。" }
          ],
          "translation": "看來今後會變冷。"
        },
        {
          "id": "L43-S05",
          "ruby": [
            { "b": "この " },
            { "b": "料理", "r": "りょうり" },
            { "b": "は " },
            { "b": "辛", "r": "から" },
            { "b": "そうです。" }
          ],
          "translation": "這道菜看來很辣。"
        },
        {
          "id": "L43-S06",
          "ruby": [
            { "b": "彼女", "r": "かのじょ" },
            { "b": "は " },
            { "b": "頭", "r": "あたま" },
            { "b": "が よさそうです。" }
          ],
          "translation": "她看來頭腦不錯。"
        },
        {
          "id": "L43-S07",
          "ruby": [
            { "b": "この " },
            { "b": "机", "r": "つくえ" },
            { "b": "は " },
            { "b": "丈夫", "r": "じょうぶ" },
            { "b": "そうです。" }
          ],
          "translation": "這張桌子看來很結實。"
        },
        {
          "id": "L43-S08",
          "ruby": [
            { "b": "ミラーさんは うれしそうです。" }
          ],
          "translation": "米勒先生看起來很高興。"
        }
      ]
    },
    {
      "id": "L43-G02",
      "pattern": "動詞て形 + 来ます",
      "explanation": "動詞て形きます,表示「到某個地方,做某個動作後再回來」的意思。進行動作的場所用「で」表示,但如果動詞的重點在物的移動上的話,則用場所「から」這樣的表達方式。名詞（場所）へ 行って 来ます:「きます」前使用動詞「いきます」的て形,表示去某個地方再回來的意思,一般用於不需特別說明在去的場所要做什麼事的時候。出かけて 来ます:「きます」前使用動詞「でかけます」的て形,表示去某處再回來的意思,用於無需對去的地方和目的進行特別說明的時候。",
      "examples": [
        {
          "id": "L43-S09",
          "ruby": [
            { "b": "ちょっと たばこを " },
            { "b": "買", "r": "か" },
            { "b": "って " },
            { "b": "来", "r": "き" },
            { "b": "ます。" }
          ],
          "translation": "我去買包煙來。"
        },
        {
          "id": "L43-S10",
          "ruby": [
            { "b": "スーパーで " },
            { "b": "牛乳", "r": "ぎゅうにゅう" },
