    {
      "id": "L43-D03",
      "ruby": [
        { "b": "お" },
        { "b": "見合", "r": "みあ" },
        { "b": "いの " },
        { "b": "会社", "r": "かいしゃ" },
        { "b": "が あるんですか。" }
      ],
      "translation": "有相親公司這種東西嗎？",
      "speaker": "シュミット"
    },
    {
      "id": "L43-D04",
      "ruby": [
        { "b": "ええ。" },
        { "b": "会員", "r": "かいいん" },
        { "b": "に なると、" },
        { "b": "自分", "r": "じぶん" },
        { "b": "の " },
        { "b": "情報", "r": "じょうほう" },
        { "b": "や " },
        { "b": "希望", "r": "きぼう" },
        { "b": "が コンピューターに " },
        { "b": "入", "r": "い" },
        { "b": "れられるんです。そして、コンピューターが " },
        { "b": "適当", "r": "てきとう" },
        { "b": "な " },
        { "b": "人", "r": "ひと" },
        { "b": "を " },
        { "b": "選", "r": "えら" },
        { "b": "んで くれるんですよ。" }
      ],
      "translation": "嗯。一旦成為會員,就可以把自己的資料和希望條件輸入電腦。然後電腦會幫忙挑選合適的人喔。",
      "speaker": "渡辺"
    },
    {
      "id": "L43-D05",
      "ruby": [
        { "b": "へえ、おもしろそうですね。" }
      ],
      "translation": "哦,聽起來很有趣呢。",
      "speaker": "シュミット"
    },
    {
      "id": "L43-D06",
      "ruby": [
        { "b": "この " },
        { "b": "人", "r": "ひと" },
        { "b": "、どう " },
        { "b": "思", "r": "おも" },
        { "b": "いますか。" }
      ],
      "translation": "這個人,你覺得怎麼樣？",
      "speaker": "渡辺"
    },
    {
      "id": "L43-D07",
      "ruby": [
        { "b": "ハンサムだし、" },
        { "b": "優", "r": "やさ" },
        { "b": "しそうだし、すてきな " },
        { "b": "人", "r": "ひと" },
        { "b": "ですね。" }
      ],
      "translation": "又帥又看起來很溫柔,是個很棒的人呢。",
      "speaker": "シュミット"
    },
    {
      "id": "L43-D08",
      "ruby": [
        { "b": "ええ。" },
        { "b": "年齢", "r": "ねんれい" },
        { "b": "も、" },
        { "b": "収入", "r": "しゅうにゅう" },
