        { "b": "趣味", "r": "しゅみ" },
        { "b": "も わたしの " },
        { "b": "希望", "r": "きぼう" },
        { "b": "に ぴったりなんです。そのうえ " },
        { "b": "名前", "r": "なまえ" },
        { "b": "も " },
        { "b": "同", "r": "おな" },
