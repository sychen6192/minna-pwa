  "grammar": [
    {
      "id": "L14-G01",
      "pattern": "動詞的活用",
      "explanation": "日語動詞的詞尾有變化,稱為活用。活用形後面可以接續各種子句,造出各種不同意思的句子。動詞按照活用的類型分為三類。",
      "examples": [
        {
          "id": "L14-S01",
          "ruby": [{ "b": "かきます" }],
          "translation": "寫"
        },
        {
          "id": "L14-S02",
          "ruby": [{ "b": "のみます" }],
          "translation": "喝"
        },
        {
          "id": "L14-S03",
          "ruby": [{ "b": "たべます" }],
          "translation": "吃"
        },
        {
          "id": "L14-S04",
          "ruby": [{ "b": "みせます" }],
          "translation": "出示"
        },
        {
          "id": "L14-S05",
          "ruby": [{ "b": "みます" }],
          "translation": "看"
        }
      ]
    },
    {
      "id": "L14-G02",
      "pattern": "動詞的類型",
      "explanation": "1)Ⅰ類動詞:這一類動詞ます形的最後音節是發い段的音。2)Ⅱ類動詞:這一類動詞ます形的最後音節幾乎都是發え段的音,也有部分是發い段的音。3)Ⅲ類動詞:這一類動詞包括了「します」和「動作性名詞＋します」的動詞,以及「きます」。",
      "examples": [
        {
          "id": "L14-S06",
          "ruby": [{ "b": "かきます" }],
          "translation": "寫（Ⅰ類）"
        },
        {
          "id": "L14-S07",
          "ruby": [{ "b": "のみます" }],
          "translation": "喝（Ⅰ類）"
        },
        {
          "id": "L14-S08",
          "ruby": [{ "b": "たべます" }],
          "translation": "吃（Ⅱ類）"
        },
        {
          "id": "L14-S09",
          "ruby": [{ "b": "みせます" }],
          "translation": "出示（Ⅱ類）"
        },
        {
          "id": "L14-S10",
          "ruby": [{ "b": "みます" }],
          "translation": "看（Ⅱ類）"
        }
      ]
    },
    {
      "id": "L14-G03",
      "pattern": "動詞て形",
      "explanation": "以「て」或「で」終止的動詞活用形叫て形。て形的變化,按照動詞類型分為以下幾種。(參照初級Ⅱ本冊20頁第14課練習A1)。1)Ⅰ類動詞:視ます形最後音節的不同,活用如練習A1所示。例外:要注意「いきます」的て形是「いって」。2)Ⅱ類動詞:ます形接「て」構成。3)Ⅲ類動詞:ます形接「て」構成。",
      "examples": [
        {
          "id": "L14-S11",
          "ruby": [{ "b": "かきます → かいて" }],
          "translation": "寫（Ⅰ類）"
        },
        {
          "id": "L14-S12",
          "ruby": [{ "b": "いきます → いって" }],
          "translation": "去（Ⅰ類,例外）"
        },
        {
          "id": "L14-S13",
          "ruby": [{ "b": "たべます → たべて" }],
          "translation": "吃（Ⅱ類）"
        },
        {
          "id": "L14-S14",
          "ruby": [{ "b": "きます → きて" }],
          "translation": "來（Ⅲ類）"
        }
      ]
    },
    {
      "id": "L14-G04",
      "pattern": "動詞て形 ください",
      "explanation": "這個句型是委託對方做某事,或下指示、進行勸誘的表達方式。下指示時當然就不能對上級用。表示委託時一般像例句①般,在「〜て ください」前面會說「すみませんが、」。這種說法比單說「〜て ください」更禮貌,要委託什麼事時,用這種說法較好。",
      "examples": [
        {
          "id": "L14-S15",
          "ruby": [
            { "b": "すみませんが、この " },
            { "b": "漢字", "r": "かんじ" },
            { "b": "の " },
            { "b": "読", "r": "よ" },
            { "b": "み" },
            { "b": "方", "r": "かた" },
            { "b": "を " },
            { "b": "教", "r": "おし" },
            { "b": "えて ください。" }
          ],
          "translation": "對不起,請你告訴我這個漢字的念法。"
        },
        {
          "id": "L14-S16",
          "ruby": [
            { "b": "ここに " },
            { "b": "住所", "r": "じゅうしょ" },
            { "b": "と " },
            { "b": "名前", "r": "なまえ" },
            { "b": "を " },
            { "b": "書", "r": "か" },
            { "b": "いて ください。" }
          ],
          "translation": "請將住址和姓名寫在這裡。"
        },
        {
          "id": "L14-S17",
          "ruby": [
            { "b": "ぜひ " },
            { "b": "遊", "r": "あそ" },
            { "b": "びに " },
            { "b": "来", "r": "き" },
            { "b": "て ください。" }
          ],
          "translation": "請一定來玩。（第25課）"
        }
      ]
    },
    {
      "id": "L14-G05",
      "pattern": "動詞て形 います",
      "explanation": "這個句型表示某個動作正在進行。",
      "examples": [
        {
          "id": "L14-S18",
          "ruby": [
            { "b": "ミラーさんは " },
            { "b": "今", "r": "いま" },
            { "b": " " },
            { "b": "電話", "r": "でんわ" },
            { "b": "を かけて います。" }
          ],
          "translation": "米勒先生現在正在打電話。"
        },
        {
          "id": "L14-S19",
          "ruby": [
            { "b": "今", "r": "いま" },
            { "b": " " },
            { "b": "雨", "r": "あめ" },
            { "b": "が " },
            { "b": "降", "r": "ふ" },
            { "b": "って いますか。" }
          ],
          "translation": "現在在下雨嗎？"
        },
        {
          "id": "L14-S20",
          "ruby": [
            { "b": "…はい、" },
            { "b": "降", "r": "ふ" },
            { "b": "って います。" }
          ],
          "translation": "…是,正在下。"
        },
        {
          "id": "L14-S21",
          "ruby": [
            { "b": "…いいえ、" },
            { "b": "降", "r": "ふ" },
            { "b": "って いません。" }
          ],
          "translation": "…不,沒有下。"
        }
      ]
    },
    {
      "id": "L14-G06",
      "pattern": "動詞ます形 ましょうか",
      "explanation": "這是要為對方做某事時的表達方式。例句⑥是Ａ表示願意為Ｂ做某事,Ｂ是委託或指示的立場;例句⑦的Ｂ是對Ａ的幫忙心存感謝接受的情況;例句⑧則是Ｂ婉拒Ａ好意的用法。",
      "examples": [
        {
          "id": "L14-S22",
          "ruby": [
            { "b": "Ａ:あしたも " },
            { "b": "来", "r": "き" },
            { "b": "ましょうか。" }
          ],
          "translation": "我明天也來吧。"
        },
        {
          "id": "L14-S23",
          "ruby": [
            { "b": "Ｂ:ええ、10" },
            { "b": "時", "r": "じ" },
            { "b": "に " },
            { "b": "来", "r": "き" },
            { "b": "て ください。" }
          ],
          "translation": "…好,請10點鐘來。"
        },
        {
          "id": "L14-S24",
          "ruby": [
            { "b": "Ａ:" },
            { "b": "傘", "r": "かさ" },
            { "b": "を " },
            { "b": "貸", "r": "か" },
            { "b": "しましょうか。" }
          ],
          "translation": "把傘借給你吧。"
        },
        {
          "id": "L14-S25",
          "ruby": [
            { "b": "Ｂ:すみません。お" },
            { "b": "願", "r": "ねが" },
            { "b": "いします。" }
          ],
          "translation": "…謝謝,那我借一下。"
        },
        {
          "id": "L14-S26",
          "ruby": [
            { "b": "Ａ:" },
            { "b": "荷物", "r": "にもつ" },
            { "b": "を " },
            { "b": "持", "r": "も" },
            { "b": "ちましょうか。" }
          ],
          "translation": "我幫您拿行李吧。"
        },
        {
          "id": "L14-S27",
          "ruby": [{ "b": "Ｂ:いいえ、けっこうです。" }],
          "translation": "…不用了。"
        }
      ]
    },
    {
      "id": "L14-G07",
      "pattern": "句子1が、句子2",
      "explanation": "第8課已經學過接續的助詞「が」,開口講話時當前置詞使用的「しつれいですが」和「すみませんが」裡,「が」已經失去了原意,用作輕微的接續。",
      "examples": [
        {
          "id": "L14-S28",
          "ruby": [
            { "b": "失礼", "r": "しつれい" },
            { "b": "ですが、お" },
            { "b": "名前", "r": "なまえ" },
            { "b": "は?" }
          ],
          "translation": "對不起,您貴姓？（第1課）"
        },
        {
          "id": "L14-S29",
          "ruby": [
            { "b": "すみませんが、" },
            { "b": "塩", "r": "しお" },
            { "b": "を " },
            { "b": "取", "r": "と" },
            { "b": "って ください。" }
          ],
          "translation": "對不起,請遞給我鹽。"
        }
      ]
    },
    {
      "id": "L14-G08",
      "pattern": "名詞が 動詞",
      "explanation": "描寫自然現象時用「が」表示主體。",
      "examples": [
